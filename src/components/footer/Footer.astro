---
/**
 * Footer — three-column on desktop, stacked on mobile.
 * Pulls NAP from src/content/nap.ts (single source of truth).
 *
 * About paragraph below is the AI-search-optimized copy from the brief Part 4.
 * Wave 1 may swap in verbatim brief copy if it differs.
 */
import { nap } from '../../content/nap';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Kids Martial Arts', href: '/kids-martial-arts/' },
  { label: 'Adults Jiu-Jitsu', href: '/adults-jiu-jitsu/' },
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Contact Us', href: '/contact/' },
];

const aboutParagraph =
  'Gracie Barra Whittier is a certified Brazilian Jiu-Jitsu academy located at 13595 Whittier Blvd. #104, Whittier, CA 90605. Part of the global Gracie Barra network, the academy offers age-specific BJJ programs for kids (ages 3-15) and adults (16+). Led by Professor Eric and Professor Phil, GB Whittier serves families throughout Whittier, La Habra, La Mirada, and Pico Rivera with a free 3-class trial pass and no contracts.';
---

<footer class="bg-gb-navy text-gb-white">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-16">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <a href="/" class="inline-flex items-center gap-3" aria-label="Gracie Barra Whittier home">
          <img
            src="/logo/gb-whittier-logo.webp"
            alt="Gracie Barra Whittier — Brazilian Jiu-Jitsu"
            class="h-20 w-20"
            width="80"
            height="80"
          />
        </a>
        <p class="mt-4 text-sm text-gb-white/80 leading-relaxed">
          {aboutParagraph}
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-gb-white">Visit Us</h2>
        <address class="not-italic mt-3 text-sm space-y-2 text-gb-white/90">
          <div class="font-semibold">{nap.name}</div>
          <div>{nap.streetAddress}</div>
          <div>{nap.addressLocality}, {nap.addressRegion} {nap.postalCode}</div>
          <div>
            <a href={`tel:${nap.phoneTel}`} class="inline-flex items-center min-h-[44px] py-2 hover:text-gb-white transition-colors">
              {nap.phone}
            </a>
          </div>
          <div>
            <a href={`mailto:${nap.email}`} class="inline-flex items-center min-h-[44px] py-2 hover:text-gb-white transition-colors">
              {nap.email}
            </a>
          </div>
        </address>
        <p class="mt-4 text-xs text-gb-white/70">
          Proudly serving Whittier, La Habra, La Mirada, and Pico Rivera, CA
        </p>

        <ul class="mt-5 flex items-center gap-3" aria-label="Follow Gracie Barra Whittier">
          <li>
            <a
              href={nap.social.googleBusiness}
              target="_blank"
              rel="noopener"
              aria-label="Gracie Barra Whittier on Google"
              class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-gb-white/10 hover:bg-gb-white/20 transition-colors"
            >
              <svg class="w-5 h-5 text-gb-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 11v2.4h6.8c-.3 1.7-1.9 5-6.8 5-4.1 0-7.4-3.4-7.4-7.5S7.9 3.4 12 3.4c2.3 0 3.9.97 4.8 1.83l3.27-3.16C18 .27 15.27-1 12-1 5.92-1 1 3.92 1 10s4.92 11 11 11c6.35 0 10.55-4.47 10.55-10.77 0-.72-.08-1.27-.18-1.83H12z"/>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={nap.social.facebook}
              target="_blank"
              rel="noopener"
              aria-label="Gracie Barra Whittier on Facebook"
              class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-gb-white/10 hover:bg-gb-white/20 transition-colors"
            >
              <svg class="w-5 h-5 text-gb-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.3-1.6 1.6-1.6h1.7V4.5c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1V11H7.5v3.1h2.9V22h3.1z"/>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={nap.social.instagram}
              target="_blank"
              rel="noopener"
              aria-label="Gracie Barra Whittier on Instagram"
              class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-gb-white/10 hover:bg-gb-white/20 transition-colors"
            >
              <svg class="w-5 h-5 text-gb-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={nap.social.yelp}
              target="_blank"
              rel="noopener"
              aria-label="Gracie Barra Whittier on Yelp"
              class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-gb-white/10 hover:bg-gb-white/20 transition-colors"
            >
              <svg class="w-5 h-5 text-gb-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M14.4 18.5l-.7-3.7c-.1-.4.4-.7.7-.4l3 2.2c.3.2.3.6.1.9l-1.5 2c-.3.4-1 .3-1.1-.2-.2-.2-.5-.8-.5-.8zm-2.4-3.1c0-.4-.5-.6-.8-.3l-2.6 3c-.3.3-.1.8.3.9l2.4.5c.4.1.7-.2.7-.6l0-3.5zm-2.7-3.4c.4 0 .6-.4.4-.7L7.4 7.6c-.2-.4-.7-.4-1-.1l-1.6 2c-.2.3-.1.7.2.9l3.9 1.6.4 0zm5.4-1.6L17.5 6c.3-.4 0-.9-.5-.9-1.8.1-3.3 1.4-3.5 3.1l-.1 1.7c0 .5.5.7.9.5l.4-.1zM12 2c-.7 0-1.2.6-1.2 1.3v6.6c0 .4.4.7.8.5 1.4-.6 2.4-2 2.4-3.6 0-2-1.4-3.7-3.3-4.1L12 2z"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-gb-white">Site</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            navLinks.map((l) => (
              <li>
                <a href={l.href} class="text-gb-white/90 hover:text-gb-white transition-colors">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/terms/" class="text-gb-white/90 hover:text-gb-white transition-colors">
              Terms &amp; Conditions
            </a>
          </li>
          <li>
            <a href="/privacy/" class="text-gb-white/90 hover:text-gb-white transition-colors">
              Privacy Policy
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-gb-white/15 text-xs text-gb-white/70 text-center">
      Copyright 2026. Gracie Barra Whittier. All Rights Reserved.
    </div>
  </div>
</footer>
