---
/**
 * SchemaFAQ — JSON-LD FAQPage emitter from items[] prop.
 */
import type { FAQItemData } from '../../content/faqs';

export interface Props {
  items: FAQItemData[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
