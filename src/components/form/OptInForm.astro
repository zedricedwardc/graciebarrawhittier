---
/**
 * OptInForm — 3-field opt-in form (Name, Email, Phone).
 * - Posts to /api/lead (server-side proxy with Zod + honeypot + dwell + rate-limit anti-abuse).
 * - On success: redirects to /kickstart?name=<encoded>.
 * - Mobile-friendly inputmode + autocomplete on every field.
 *
 * Banner copy above the form is configurable via props but defaults to brief Section copy.
 * Wave 1 will swap SMS-consent placeholder text with the brief's exact disclaimer.
 */
import CTAButton from '../cta/CTAButton.astro';
import PhoneInput from './PhoneInput.astro';

export interface Props {
  id?: string;
  header?: string;
  subheader?: string;
  description?: string;
  offerLabel?: string;
  riskLine?: string;
  imageSrc?: string;
  imageAlt?: string;
  submitLabel?: string;
  variant?: 'default' | 'navy';
  /** Distinguishes which form sent the lead in GHL. e.g. "homepage-optin", "kids-optin". */
  source?: string;
}

const {
  id = 'trial',
  header = 'UNLOCK YOUR FREE 3-CLASS PASS',
  subheader = '+ VIEW OUR FULL CLASS SCHEDULE INSTANTLY',
  description = 'Enter your info below to claim your Free 3-Class Pass and access our full class schedule.',
  offerLabel = 'FREE 3-CLASS PASS',
  riskLine = 'No Risk. No Pressure. Free Uniform Rental Included.',
  imageSrc,
  imageAlt = '',
  submitLabel = 'Claim My Free 3-Class Pass',
  variant = 'default',
  source = 'opt-in',
} = Astro.props;

const isNavy = variant === 'navy';
const split = !isNavy && !!imageSrc;
---

<section
  id={id}
  class={`bg-gb-bg-light px-4 md:px-6 scroll-mt-24 ${isNavy ? 'pt-4 md:pt-6 pb-4 md:pb-6' : 'pt-4 md:pt-6 pb-12 md:pb-16'}`}
  aria-labelledby={`${id}-heading`}
>
  {isNavy ? (
    <div class="max-w-6xl mx-auto bg-gb-white rounded-2xl shadow-lg border-4 border-gb-gold p-6 md:p-10 relative mt-7 md:mt-9">
      {/* Floating offer badge — overlaps top of card */}
      <span class="absolute -top-4 md:-top-5 left-1/2 -translate-x-1/2 inline-block bg-gb-red text-gb-white text-xs md:text-sm font-extrabold tracking-widest uppercase px-5 py-2 rounded-full shadow-md whitespace-nowrap">
        {offerLabel}
      </span>

      {/* HEADER: bold headline + gold risk line.
          On mobile: flame icon stacked above so the headline gets full width.
          On md+: flame icon inline to the left of the headline. */}
      <div class="text-center mb-7 md:mb-9 mt-2">
        <h2 id={`${id}-heading`} class="flex flex-col md:flex-row items-center justify-center gap-2 md:gap-3 text-xl sm:text-2xl md:text-4xl font-extrabold uppercase tracking-tight leading-tight text-gb-navy">
          <svg class="w-8 h-8 md:w-9 md:h-9 shrink-0 text-gb-red" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 0.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14a8 8 0 1016 0C20 9.61 17.89 5.69 14.83 3.36 14.5 2.21 13.5 0.67 13.5 0.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04a4.8 4.8 0 01-4.8 4.8z" />
          </svg>
          <span class="[text-wrap:balance]" set:html={header.replace(/3-CLASS/gi, '3&#8209;CLASS')} />
        </h2>
        <p class="mt-3 text-sm md:text-base font-bold text-gb-gold">{riskLine}</p>
      </div>

      <form data-optin-form data-variant="navy" data-source={source} class="space-y-4" novalidate>
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
          style="position:absolute;left:-10000px;width:1px;height:1px;opacity:0" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
          <div>
            <label for={`${id}-first`} class="sr-only">First Name</label>
            <input
              id={`${id}-first`}
              name="firstName"
              type="text"
              inputmode="text"
              autocomplete="given-name"
              required
              class="w-full h-12 px-4 rounded-lg border border-gray-300 bg-gb-white text-gb-text placeholder-gb-text-muted focus:outline-none focus:ring-2 focus:ring-gb-red focus:border-gb-red"
              placeholder="First Name*"
            />
          </div>
          <div>
            <label for={`${id}-last`} class="sr-only">Last Name</label>
            <input
              id={`${id}-last`}
              name="lastName"
              type="text"
              inputmode="text"
              autocomplete="family-name"
              required
              class="w-full h-12 px-4 rounded-lg border border-gray-300 bg-gb-white text-gb-text placeholder-gb-text-muted focus:outline-none focus:ring-2 focus:ring-gb-red focus:border-gb-red"
              placeholder="Last Name*"
            />
          </div>
          <div>
            <label for={`${id}-email`} class="sr-only">Email</label>
            <input
              id={`${id}-email`}
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              required
              class="w-full h-12 px-4 rounded-lg border border-gray-300 bg-gb-white text-gb-text placeholder-gb-text-muted focus:outline-none focus:ring-2 focus:ring-gb-red focus:border-gb-red"
              placeholder="Email*"
            />
          </div>
          <div>
            <label for={`${id}-phone`} class="sr-only">Phone</label>
            <PhoneInput
              id={`${id}-phone`}
              borderClass="border border-gray-300"
              placeholder="Phone*"
            />
          </div>
        </div>

        <div class="flex justify-center pt-1">
          <div class="w-full max-w-xl">
            <CTAButton variant="formSubmit" type="submit" label={submitLabel} fullWidth={true} />
          </div>
        </div>

        <p data-optin-error class="hidden text-sm text-gb-red text-center" role="alert">
          Something went wrong submitting your info. Please try again or call us.
        </p>

        <p class="text-[11px] italic leading-relaxed text-gb-text-muted text-center">
          By submitting this form, you agree to receive text messages from Gracie Barra Whittier.
          Message &amp; data rates may apply. Reply STOP to opt out at any time.
        </p>
        <p class="text-xs text-gb-text-muted text-center">
          Takes 30 seconds &bull; No payment required
        </p>
      </form>
    </div>
  ) : (
  <div
    class={
      split
        ? 'max-w-6xl mx-auto grid md:grid-cols-5 gap-5 md:gap-6 items-stretch'
        : 'max-w-xl mx-auto bg-gb-white rounded-2xl shadow-lg p-6 md:p-10'
    }
  >
    {split && (
      <div class="hidden md:block md:col-span-2 relative bg-gb-white rounded-2xl shadow-lg overflow-hidden border border-gb-gold/40 min-h-[280px] md:min-h-full">
        <img
          src={imageSrc}
          alt={imageAlt}
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class={split ? 'md:col-span-3 bg-gb-white rounded-2xl shadow-lg border border-gb-gold/40 p-6 md:p-10' : ''}>
    <div class={split ? 'mb-6' : 'text-center mb-6'}>
      {split ? (
        <>
          <div class="border-b-2 border-dashed border-gb-gold pb-3">
            <div class="flex items-center gap-2 text-gb-text">
              <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 0.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14a8 8 0 1016 0C20 9.61 17.89 5.69 14.83 3.36 14.5 2.21 13.5 0.67 13.5 0.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04a4.8 4.8 0 01-4.8 4.8z" />
              </svg>
              <h2 id={`${id}-heading`} class="text-xl md:text-2xl font-extrabold uppercase tracking-tight text-gb-text">
                {header}
              </h2>
            </div>
            <p class="mt-1 ml-8 text-xs md:text-sm italic font-semibold uppercase tracking-wide text-gb-text">
              {subheader}
            </p>
          </div>
          <p class="mt-4 text-3xl md:text-4xl font-extrabold text-gb-gold leading-tight uppercase">{offerLabel}</p>
          <p class="mt-1 text-sm font-bold text-gb-gold">{riskLine}</p>
          <p class="mt-3 text-sm text-gb-text-muted">{description}</p>
        </>
      ) : (
        <>
          <span class="inline-block bg-gb-gold text-gb-navy text-xs font-bold tracking-wider px-3 py-1 rounded-full">
            {offerLabel}
          </span>
          <h2 id={`${id}-heading`} class="mt-3 text-2xl md:text-3xl font-bold text-gb-navy">
            {header}
          </h2>
          <p class="mt-2 text-xs font-bold tracking-widest uppercase text-gb-gold">
            {subheader}
          </p>
          <p class="mt-2 text-sm text-gb-text-muted">{description}</p>
          <p class="mt-2 text-sm text-gb-text-muted">{riskLine}</p>
        </>
      )}
    </div>

    <form
      data-optin-form
      data-source={source}
      class="space-y-4"
      novalidate
    >
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
        style="position:absolute;left:-10000px;width:1px;height:1px;opacity:0" />
      <div class="relative">
        <label for={`${id}-name`} class="sr-only">Full Name</label>
        <input
          id={`${id}-name`}
          name="name"
          type="text"
          inputmode="text"
          autocomplete="name"
          required
          class="w-full h-12 pl-4 pr-10 rounded-lg border border-gb-bg-light bg-gb-white text-gb-text placeholder-gb-text-muted focus:outline-none focus:ring-2 focus:ring-gb-red focus:border-gb-red"
          placeholder="Full Name"
        />
        <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gb-text-muted pointer-events-none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <circle cx="6" cy="12" r="1.5" />
          <circle cx="12" cy="12" r="1.5" />
          <circle cx="18" cy="12" r="1.5" />
        </svg>
      </div>

      <div class="relative">
        <label for={`${id}-email`} class="sr-only">Email</label>
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gb-text-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
        <input
          id={`${id}-email`}
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          required
          class="w-full h-12 pl-10 pr-4 rounded-lg border border-gb-bg-light bg-gb-white text-gb-text placeholder-gb-text-muted focus:outline-none focus:ring-2 focus:ring-gb-red focus:border-gb-red"
          placeholder="Email*"
        />
      </div>

      <div class="relative">
        <label for={`${id}-phone`} class="sr-only">Phone</label>
        <PhoneInput
          id={`${id}-phone`}
          borderClass="border border-gb-bg-light"
          placeholder="Phone*"
        />
      </div>

      <CTAButton
        variant="formSubmit"
        type="submit"
        label={submitLabel}
        fullWidth={true}
      />

      <p
        data-optin-error
        class="hidden text-sm text-gb-red text-center"
        role="alert"
      >
        Something went wrong submitting your info. Please try again or call us.
      </p>

      <p class="text-[11px] italic leading-relaxed text-gb-text-muted text-center">
        By submitting this form, you agree to receive text messages from Gracie Barra Whittier.
        Message &amp; data rates may apply. Reply STOP to opt out at any time.
      </p>

      <p class="text-xs text-gb-text-muted text-center">
        Takes 30 seconds &bull; No payment required
      </p>
    </form>
    </div>
  </div>
  )}
</section>

<script>
  import { trackEvent } from '../../lib/analytics';

  const pageLoadTs = Date.now();
  const forms = document.querySelectorAll<HTMLFormElement>('[data-optin-form]');
  forms.forEach((form) => {
    // In-flight guard — the GHL round-trip takes 1-3s and impatient double
    // clicks were creating duplicate opportunities (3 opps in 700ms).
    let inFlight = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (inFlight) return;
      const errorEl = form.querySelector<HTMLElement>('[data-optin-error]');
      errorEl?.classList.add('hidden');

      const data = new FormData(form);
      const firstName = String(data.get('firstName') ?? '').trim();
      const lastName  = String(data.get('lastName') ?? '').trim();
      const fullName  = String(data.get('name') ?? '').trim();
      const name = fullName || [firstName, lastName].filter(Boolean).join(' ').trim();
      const email = String(data.get('email') ?? '').trim();
      const phone = String(data.get('phone') ?? '').trim();

      // Navy variant requires firstName + lastName; default variant requires combined `name`.
      const isNavy = form.dataset.variant === 'navy';
      const missing = isNavy
        ? (!firstName || !lastName || !email || !phone)
        : (!name || !email || !phone);
      if (missing) {
        errorEl?.classList.remove('hidden');
        return;
      }

      const page = window.location.pathname;
      const source = (form.dataset.source && form.dataset.source.length > 0) ? form.dataset.source : 'opt-in';
      const website = String(data.get('website') ?? '');

      inFlight = true;
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            firstName: firstName || name.split(/\s+/)[0] || '',
            lastName:  lastName  || name.split(/\s+/).slice(1).join(' ') || '',
            email,
            phone,
            message: '',
            source,
            page,
            website,
            ts: pageLoadTs,
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.ok) throw new Error(`lead failed: ${json.code ?? res.status}`);
        trackEvent('generate_lead', { source, page });
        const qs = new URLSearchParams({ name, email, phone });
        window.location.href = `/kickstart?${qs.toString()}`;
      } catch {
        // Re-enable so the visitor can retry after a transient failure.
        inFlight = false;
        if (submitBtn) submitBtn.disabled = false;
        errorEl?.classList.remove('hidden');
      }
    });
  });
</script>
