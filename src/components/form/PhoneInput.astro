---

<div
  class:list={[
    'flex w-full h-12 rounded-lg bg-gb-white relative',
    borderClass,
    ringClass,
    extraClass,
  ]}
  data-phone-group
  data-initial-value={value}
>
  <div class="relative shrink-0">
    <button
      type="button"
      data-phone-country-trigger
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label="Country code"
      class="h-full flex items-center gap-1.5 pl-3 pr-2 bg-transparent text-gb-text border-r border-gb-bg-light rounded-l-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-gb-red whitespace-nowrap"
    >
      <span data-trigger-flag class="text-base leading-none">🇺🇸</span>
      <span data-trigger-dial class="text-sm font-medium">+1</span>
      <svg class="w-3 h-3 text-gb-text-muted" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M3 4.5l3 3 3-3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <div
      data-phone-country-menu
      role="listbox"
      hidden
      class="absolute top-full left-0 mt-1 z-30 w-72 max-w-[90vw] bg-gb-white rounded-lg shadow-xl border border-gb-bg-light overflow-hidden"
    >
      <div class="p-2 border-b border-gb-bg-light">
        <input
          type="text"
          data-country-search
          placeholder="Search country"
          class="w-full h-9 px-3 rounded-md border border-gb-bg-light focus:outline-none focus:ring-1 focus:ring-gb-red focus:border-gb-red text-sm"
        />
      </div>
      <ul class="max-h-64 overflow-y-auto py-1" data-country-list>
        {countries.map((c) => (
          <li>
            <button
              type="button"
              role="option"
              data-country-option
              data-dial={c.dial}
              data-code={c.code}
              data-flag={c.flag}
              data-name={c.name}
              class="w-full text-left px-3 py-2 hover:bg-gb-bg-light flex items-center gap-2 text-sm focus:outline-none focus:bg-gb-bg-light"
            >
              <span class="shrink-0 text-base leading-none">{c.flag}</span>
              <span class="grow truncate text-gb-text">{c.name}</span>
              <span class="text-gb-text-muted shrink-0 tabular-nums">{c.dial}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <input
    id={id}
    data-phone-local
    type="tel"
    inputmode="tel"
    autocomplete="tel-national"
    required={required}
    placeholder={placeholder}
    class="flex-1 min-w-0 h-full px-3 bg-transparent text-gb-text placeholder-gb-text-muted focus:outline-none rounded-r-lg"
  />
  <input type="hidden" name={name} data-phone-hidden />
</div>

<script>
  function digitsOnly(s: string): string {
    return s.replace(/\D+/g, '');
  }

  function setupPhoneGroup(group: HTMLElement) {
    if (group.dataset.phoneInit === '1') return;
    group.dataset.phoneInit = '1';

    const trigger = group.querySelector<HTMLButtonElement>('[data-phone-country-trigger]');
    const triggerFlag = group.querySelector<HTMLElement>('[data-trigger-flag]');
    const triggerDial = group.querySelector<HTMLElement>('[data-trigger-dial]');
    const menu = group.querySelector<HTMLElement>('[data-phone-country-menu]');
    const search = group.querySelector<HTMLInputElement>('[data-country-search]');
    const list = group.querySelector<HTMLElement>('[data-country-list]');
    const local = group.querySelector<HTMLInputElement>('[data-phone-local]');
    const hidden = group.querySelector<HTMLInputElement>('[data-phone-hidden]');
    if (!trigger || !triggerFlag || !triggerDial || !menu || !search || !list || !local || !hidden) return;

    const options = Array.from(list.querySelectorAll<HTMLButtonElement>('[data-country-option]'));
    const dialOptions = Array.from(new Set(options.map((o) => o.dataset.dial ?? '+1')))
      .sort((a, b) => b.length - a.length);

    let selectedDial = '+1';

    function applyCountry(opt: HTMLButtonElement) {
      selectedDial = opt.dataset.dial ?? '+1';
      triggerFlag!.textContent = opt.dataset.flag ?? '';
      triggerDial!.textContent = selectedDial;
      sync();
    }

    function sync() {
      const localDigits = digitsOnly(local!.value);
      hidden!.value = localDigits ? `${selectedDial}${localDigits}` : '';
    }

    function setValue(raw: string) {
      const v = (raw || '').trim();
      if (!v) {
        local!.value = '';
        sync();
        return;
      }
      const normalized = v.startsWith('+') ? v : `+${digitsOnly(v)}`;
      let matched = '';
      for (const d of dialOptions) {
        if (normalized.startsWith(d)) {
          matched = d;
          break;
        }
      }
      if (matched) {
        const opt = options.find((o) => o.dataset.dial === matched);
        if (opt) applyCountry(opt);
        local!.value = digitsOnly(normalized.slice(matched.length));
      } else {
        local!.value = digitsOnly(v);
      }
      sync();
    }

    function openMenu() {
      menu!.hidden = false;
      trigger!.setAttribute('aria-expanded', 'true');
      search!.value = '';
      filterOptions('');
      requestAnimationFrame(() => search!.focus());
    }

    function closeMenu() {
      menu!.hidden = true;
      trigger!.setAttribute('aria-expanded', 'false');
    }

    function filterOptions(query: string) {
      const q = query.trim().toLowerCase();
      for (const opt of options) {
        const name = (opt.dataset.name ?? '').toLowerCase();
        const dial = (opt.dataset.dial ?? '').toLowerCase();
        const code = (opt.dataset.code ?? '').toLowerCase();
        const match = !q || name.includes(q) || dial.includes(q) || code.includes(q);
        const li = opt.parentElement as HTMLElement;
        li.hidden = !match;
      }
    }

    trigger.addEventListener('click', () => {
      if (menu!.hidden) openMenu();
      else closeMenu();
    });

    options.forEach((opt) => {
      opt.addEventListener('click', () => {
        applyCountry(opt);
        closeMenu();
        local!.focus();
      });
    });

    search.addEventListener('input', () => filterOptions(search.value));

    search.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeMenu();
        trigger!.focus();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const firstVisible = options.find((o) => !(o.parentElement as HTMLElement).hidden);
        if (firstVisible) {
          applyCountry(firstVisible);
          closeMenu();
          local!.focus();
        }
      }
    });

    document.addEventListener('click', (e) => {
      if (menu!.hidden) return;
      const t = e.target as Node;
      if (!group.contains(t)) closeMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu!.hidden) {
        closeMenu();
        trigger!.focus();
      }
    });

    local.addEventListener('input', sync);

    group.addEventListener('phone:setvalue', (e) => {
      const ev = e as CustomEvent<{ value?: string }>;
      setValue(ev.detail?.value ?? '');
    });

    setValue(group.dataset.initialValue ?? '');
  }

  document.querySelectorAll<HTMLElement>('[data-phone-group]').forEach(setupPhoneGroup);
</script>
