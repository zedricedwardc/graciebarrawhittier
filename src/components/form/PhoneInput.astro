---
/**
 * PhoneInput — country-code picker + national phone input.
 * Renders as a single styled wrapper that mirrors the standard form input look.
 * Submits a combined E.164-style value (e.g. "+15551234567") via a hidden field
 * so existing form handlers reading `data.get('phone')` keep working unchanged.
 *
 * The country picker is a custom popover (not a native <select>) so the trigger
 * stays compact (flag + dial code only) while the dropdown shows full names
 * with a search field.
 *
 * To prefill programmatically (e.g. from URL params), dispatch a `phone:setvalue`
 * CustomEvent on the wrapper element with `{ detail: { value: '+15551234567' } }`.
 */

export interface Props {
  id?: string;
  name?: string;
  required?: boolean;
  placeholder?: string;
  value?: string;
  /** Outer wrapper border classes — let each form match its own style. */
  borderClass?: string;
  /** focus-within ring/border classes. */
  ringClass?: string;
  /** Extra classes appended to the wrapper. */
  class?: string;
}

const {
  id,
  name = 'phone',
  required = true,
  placeholder = 'Phone*',
  value = '',
  borderClass = 'border border-gb-bg-light',
  ringClass = 'focus-within:ring-2 focus-within:ring-gb-red focus-within:border-gb-red',
  class: extraClass = '',
} = Astro.props;

interface Country {
  code: string;
  dial: string;
  flag: string;
  name: string;
}

const countries: Country[] = [
