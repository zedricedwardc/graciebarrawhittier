---
/**
 * OptInModal — premium popup version of the opt-in form.
 *
 * Used on pages without an inline #trial section (e.g. /reviews, /contact).
 * Opened by Nav.astro's js-trial-link handler when no #trial element is on the page.
 *
 * Layout:
 * - Full-screen transparent <dialog> (avoids browser-default dialog:modal centering quirks).
 * - Centered card with navy header + gold accents + clean form body + trust footer.
 *
 * Posts to /api/lead with source="modal-optin" so leads are distinguishable in GHL.
 */
import CTAButton from '../cta/CTAButton.astro';
import PhoneInput from './PhoneInput.astro';
---

<dialog
  id="trial-modal"
  data-trial-modal
  class="m-0 p-0 w-screen h-[100dvh] max-w-none max-h-none bg-transparent backdrop:bg-gb-navy/85 backdrop:backdrop-blur-sm"
  aria-labelledby="trial-modal-heading"
>
  <div class="absolute inset-0 flex items-center justify-center p-4 md:p-6 overflow-y-auto">
    <div
      class="relative w-full max-w-[520px] my-auto bg-gb-white rounded-2xl shadow-2xl ring-1 ring-gb-gold/30"
      data-trial-modal-card
    >
      {/* HEADER — red with gold accents */}
      <div class="relative bg-gb-red text-gb-white px-6 md:px-8 pt-8 pb-6 rounded-t-2xl">
        {/* Floating gold offer badge */}
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-block bg-gb-gold text-gb-navy text-[10px] md:text-xs font-extrabold tracking-widest uppercase px-4 py-1.5 rounded-full shadow-md whitespace-nowrap">
          FREE 3-CLASS PASS
        </span>

        {/* Close button */}
        <button
          type="button"
          data-trial-modal-close
          aria-label="Close"
          class="absolute top-3 right-3 z-10 inline-flex items-center justify-center w-9 h-9 rounded-full bg-gb-white hover:bg-gb-gold text-gb-red shadow-md transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gb-gold focus-visible:ring-offset-2 focus-visible:ring-offset-gb-red"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <h2
          id="trial-modal-heading"
          class="mt-1 flex items-center justify-center gap-2 text-lg md:text-2xl font-extrabold uppercase tracking-tight text-center [text-wrap:balance]"
        >
          <svg class="w-6 h-6 md:w-7 md:h-7 shrink-0 text-gb-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 0.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14a8 8 0 1016 0C20 9.61 17.89 5.69 14.83 3.36 14.5 2.21 13.5 0.67 13.5 0.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04a4.8 4.8 0 01-4.8 4.8z" />
          </svg>
          <span set:html="Unlock Your Free 3&#8209;Class Pass" />
        </h2>
        <p class="mt-2 text-center text-[11px] md:text-xs font-bold tracking-widest uppercase text-gb-white">
          + View Our Full Class Schedule Instantly
        </p>
        <p class="mt-3 text-center text-xs md:text-sm text-gb-white/85">
          No Risk. No Pressure. Free Uniform Rental Included.
        </p>
      </div>

      {/* Gold gradient divider */}
      <div class="h-1 bg-gradient-to-r from-gb-gold/30 via-gb-gold to-gb-gold/30" aria-hidden="true"></div>

      {/* FORM */}
      <form
        data-optin-form
        data-source="modal-optin"
        class="px-6 md:px-8 pt-6 pb-3 space-y-3.5"
        novalidate
      >
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
          style="position:absolute;left:-10000px;width:1px;height:1px;opacity:0" />

        <div class="relative">
          <label for="trial-modal-name" class="sr-only">Full Name</label>
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gb-text-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          <input
            id="trial-modal-name"
            name="name"
            type="text"
            inputmode="text"
            autocomplete="name"
            required
            class="w-full h-12 pl-10 pr-4 rounded-lg border border-gb-text-muted/30 bg-gb-white text-gb-text placeholder-gb-text-muted focus:outline-none focus:ring-2 focus:ring-gb-gold focus:border-gb-gold transition-colors"
            placeholder="Full Name*"
          />
        </div>

        <div class="relative">
          <label for="trial-modal-email" class="sr-only">Email</label>
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gb-text-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          <input
            id="trial-modal-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            class="w-full h-12 pl-10 pr-4 rounded-lg border border-gb-text-muted/30 bg-gb-white text-gb-text placeholder-gb-text-muted focus:outline-none focus:ring-2 focus:ring-gb-gold focus:border-gb-gold transition-colors"
            placeholder="Email*"
          />
        </div>

        <div class="relative">
          <label for="trial-modal-phone" class="sr-only">Phone</label>
          <PhoneInput
            id="trial-modal-phone"
            borderClass="border border-gb-text-muted/30"
            ringClass="focus-within:ring-2 focus-within:ring-gb-gold focus-within:border-gb-gold transition-colors"
            placeholder="Phone*"
          />
        </div>

        <div class="pt-1">
          <CTAButton variant="formSubmit" type="submit" label="Claim My Free 3-Class Pass" fullWidth={true} />
        </div>

        <p data-optin-error class="hidden text-sm text-gb-red text-center" role="alert">
          Something went wrong submitting your info. Please try again or call us.
        </p>
      </form>

      {/* TRUST FOOTER */}
      <div class="bg-gb-bg-light px-6 md:px-8 py-4 border-t border-gb-bg-light rounded-b-2xl">
        <div class="flex items-center justify-center gap-4 text-[11px] md:text-xs font-semibold text-gb-navy">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-gb-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            30 seconds
          </span>
          <span class="text-gb-text-muted/40" aria-hidden="true">•</span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-gb-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            No payment required
          </span>
        </div>
        <p class="mt-2.5 text-center text-[10px] md:text-[11px] italic leading-relaxed text-gb-text-muted">
          By submitting, you agree to receive text messages from Gracie Barra Whittier.
          Reply STOP to opt out at any time.
        </p>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* Fade in/out for the native <dialog>.
     Uses @starting-style + transition-behavior: allow-discrete so transitions
     run when the dialog toggles between display:none and display:block. */
  [data-trial-modal] {
    opacity: 0;
    transition:
      opacity 200ms ease,
      overlay 200ms ease allow-discrete,
      display 200ms ease allow-discrete;
  }
  [data-trial-modal][open] {
    opacity: 1;
  }
  @starting-style {
    [data-trial-modal][open] {
      opacity: 0;
    }
  }

  /* Backdrop fades in/out alongside the dialog. */
  [data-trial-modal]::backdrop {
    background-color: rgb(11 19 43 / 0);
    backdrop-filter: blur(0px);
    transition:
      background-color 200ms ease,
      backdrop-filter 200ms ease,
      overlay 200ms ease allow-discrete,
      display 200ms ease allow-discrete;
  }
  [data-trial-modal][open]::backdrop {
    background-color: rgb(11 19 43 / 0.85);
    backdrop-filter: blur(4px);
  }
  @starting-style {
    [data-trial-modal][open]::backdrop {
      background-color: rgb(11 19 43 / 0);
      backdrop-filter: blur(0px);
    }
  }

  /* Card pops in on open with a subtle lift + scale. */
  [data-trial-modal][open] [data-trial-modal-card] {
    animation: trial-modal-card-in 280ms cubic-bezier(0.16, 1, 0.3, 1) 60ms backwards;
  }
  @keyframes trial-modal-card-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-trial-modal],
    [data-trial-modal]::backdrop,
    [data-trial-modal][open] [data-trial-modal-card] {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  import { trackEvent } from '../../lib/analytics';

  const dialog = document.querySelector<HTMLDialogElement>('[data-trial-modal]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-trial-modal-close]');

  function close() {
    dialog?.close();
  }

  closeBtn?.addEventListener('click', close);

  // Click outside the inner card → close.
  dialog?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest('[data-trial-modal-card]')) close();
  });

  // Submission handler — mirrors OptInForm.astro logic but scoped to the modal form.
  const pageLoadTs = Date.now();
  const form = dialog?.querySelector<HTMLFormElement>('[data-optin-form]');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorEl = form.querySelector<HTMLElement>('[data-optin-error]');
      errorEl?.classList.add('hidden');

      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const phone = String(data.get('phone') ?? '').trim();

      if (!name || !email || !phone) {
        errorEl?.classList.remove('hidden');
        return;
      }

      const page = window.location.pathname;
      const source = (form.dataset.source && form.dataset.source.length > 0) ? form.dataset.source : 'modal-optin';
      const website = String(data.get('website') ?? '');

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            firstName: name.split(/\s+/)[0] || '',
            lastName: name.split(/\s+/).slice(1).join(' ') || '',
            email,
            phone,
            message: '',
            source,
            page,
            website,
            ts: pageLoadTs,
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.ok) throw new Error(`lead failed: ${json.code ?? res.status}`);
        trackEvent('generate_lead', { source, page });
        const qs = new URLSearchParams({ name, email, phone });
        window.location.href = `/kickstart?${qs.toString()}`;
      } catch {
        errorEl?.classList.remove('hidden');
      }
    });
  }
</script>
