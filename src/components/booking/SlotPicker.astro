---
/**
 * SlotPicker — STATE 4.
 * Card-wrapped list of bookable times for the selected date.
 * Each slot is a tile with the start time + duration.
 *
 * Emits booking:slot-selected with the chosen Slot.
 */
---

<div>
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-xl md:text-2xl font-bold text-gb-navy" data-slot-header></h3>
    <button type="button" data-change-date class="text-sm text-gb-text-muted hover:text-gb-navy underline">← Change date</button>
  </div>

  <div class="bg-white border-2 border-gb-gold rounded-2xl p-4 sm:p-6 shadow-lg">
    <p class="text-xs uppercase tracking-wider text-gb-text-muted font-semibold mb-3">
      Available times
    </p>

    <div data-slot-list class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div data-skeleton class="col-span-full text-center text-gb-text-muted py-8">
        Loading available times&hellip;
      </div>
    </div>

    <p data-no-slots class="hidden text-center text-gb-text-muted py-6">
      No available times on this date.
      <br />
      <button type="button" data-empty-back class="underline hover:text-gb-navy mt-2">Pick a different date</button>
    </p>
  </div>
</div>

<script>
  const root = document.getElementById('booking-flow');
  if (root) {
    const node = root.querySelector('[data-step="slot"]');
    const list = node?.querySelector('[data-slot-list]') as HTMLElement | null;
    const empty = node?.querySelector('[data-no-slots]') as HTMLElement | null;
    const header = node?.querySelector('[data-slot-header]') as HTMLElement | null;
    const back = node?.querySelector('[data-change-date]') as HTMLElement | null;
    const emptyBack = node?.querySelector('[data-empty-back]') as HTMLElement | null;

    back?.addEventListener('click', () => {
      root.dispatchEvent(new CustomEvent('booking:back-to-date'));
    });
    emptyBack?.addEventListener('click', () => {
      root.dispatchEvent(new CustomEvent('booking:back-to-date'));
    });

    root.addEventListener('booking:render', (e) => {
      const s = (e as CustomEvent).detail;
      if (s.step !== 'slot') return;
      if (header) {
        const dateLabel = s.selectedDate ? formatDate(s.selectedDate) : '';
        header.textContent = `${s.programName} · ${dateLabel}`;
      }
      if (!list || !empty) return;
      list.innerHTML = '';

      const loaded = s.slotsLoadedFor === s.selectedDate;
      if (!loaded) {
        const skel = document.createElement('div');
        skel.className = 'col-span-full text-center text-gb-text-muted py-8';
        skel.textContent = 'Loading available times…';
        list.appendChild(skel);
        empty.classList.add('hidden');
        return;
      }
      if (!s.slots || s.slots.length === 0) {
        empty.classList.remove('hidden');
        return;
      }
      empty.classList.add('hidden');

      for (const slot of s.slots) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className =
          'group flex items-center justify-between gap-3 px-5 py-4 rounded-xl border-2 border-gray-200 ' +
          'bg-white hover:border-gb-navy hover:shadow-sm hover:bg-gb-bg-light/30 ' +
          'transition-all text-left cursor-pointer';

        const time = slot.label.split(' · ')[1] ?? slot.label;
        const minutes = durationMinutes(slot.startISO, slot.endISO);
        const meta = slotMeta(s.program, slot.startISO);

        btn.innerHTML = `
          <div class="flex items-center gap-3 min-w-0">
            <div class="shrink-0 w-10 h-10 rounded-full bg-gb-bg-light flex items-center justify-center text-gb-navy">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-lg font-bold text-gb-navy leading-tight">${time}</div>
              <div class="text-xs text-gb-text-muted">${minutes} min class</div>
              <div class="mt-1.5">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold ${meta.badgeClass}">${meta.code}: ${meta.label}</span>
              </div>
            </div>
          </div>
          <span class="shrink-0 text-gb-navy font-semibold text-sm group-hover:translate-x-0.5 transition-transform">
            Book &rsaquo;
          </span>
        `;

        btn.addEventListener('click', () => {
          root.dispatchEvent(new CustomEvent('booking:slot-selected', { detail: slot }));
        });
        list.appendChild(btn);
      }
    });

    function formatDate(iso: string): string {
      const d = new Date(`${iso}T12:00:00`);
      return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
    }

    function durationMinutes(startISO: string, endISO: string): number {
      const ms = Date.parse(endISO) - Date.parse(startISO);
      return Math.round(ms / 60_000);
    }

    type ProgramKey = 'tiny'|'lc1'|'lc2'|'juniors'|'adults';

    function slotMeta(program: ProgramKey, startISO: string): {
      code: string; label: string; badgeClass: string;
    } {
      const d = new Date(startISO);
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Los_Angeles',
        weekday: 'short',
        hour: 'numeric',
        hour12: false,
      }).formatToParts(d);
      const wd = parts.find((p) => p.type === 'weekday')?.value ?? '';
      const hour = Number(parts.find((p) => p.type === 'hour')?.value ?? '0');
      const isMonWed = wd === 'Mon' || wd === 'Wed';
      const isTueThu = wd === 'Tue' || wd === 'Thu';
      const isSat = wd === 'Sat';

      // GB1 = cyan, GBK = navy — matches the studio flyer.
      const GB1 = 'bg-sky-500 text-white';
      const GBK = 'bg-gb-navy text-white';

      if (program === 'adults') {
        return { code: 'GB1', label: 'Adults: All Levels (Fundamentals)', badgeClass: GB1 };
      }

      const sectionForKids = isMonWed ? 'Section A' : isTueThu ? 'Section B' : '';

      if (program === 'tiny') {
        return { code: 'GBK', label: `Tiny Champs · ${sectionForKids}`, badgeClass: GBK };
      }
      if (program === 'lc1') {
        const label = isSat ? 'Little Champs 1 & 2 (Combined)' : `Little Champs 1 · ${sectionForKids}`;
        return { code: 'GBK', label, badgeClass: GBK };
      }
      if (program === 'lc2') {
        const label = isSat ? 'Little Champs 1 & 2 (Combined)' : `Little Champs 2 · ${sectionForKids}`;
        return { code: 'GBK', label, badgeClass: GBK };
      }
      if (program === 'juniors') {
        const label = isSat ? 'Juniors BJJ · All Sections' : `Juniors BJJ · ${sectionForKids}`;
        return { code: 'GBK', label, badgeClass: GBK };
      }
      return { code: '', label: '', badgeClass: '' };
    }
  }
</script>
