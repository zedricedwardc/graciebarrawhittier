---
/**
 * DatePicker — STATE 3.
 * Calendar grid view, navigable up to 3 months ahead.
 * A date is enabled only when GHL reports ≥1 free slot for that day.
 * Each enabled cell shows the count of available times.
 *
 * Emits: booking:date-selected (YYYY-MM-DD), booking:change-month ({delta: -1|1}).
 */
---

<div>
  <div class="flex items-center justify-between mb-4">
    <div>
      <p class="text-gb-text-muted uppercase tracking-widest text-xs font-semibold" data-program-age></p>
      <h3 class="text-2xl font-bold text-gb-navy" data-program-name></h3>
    </div>
    <button type="button" data-change-program class="text-sm text-gb-text-muted hover:text-gb-navy underline">← Change program</button>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl p-4 sm:p-6 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <button
        type="button"
        data-prev-month
        class="w-9 h-9 rounded-full hover:bg-gb-bg-light text-gb-navy text-xl flex items-center justify-center disabled:text-gray-300 disabled:hover:bg-transparent disabled:cursor-not-allowed"
        aria-label="Previous month"
      >‹</button>
      <p class="text-base sm:text-lg font-bold text-gb-navy" data-month-label>&nbsp;</p>
      <button
        type="button"
        data-next-month
        class="w-9 h-9 rounded-full hover:bg-gb-bg-light text-gb-navy text-xl flex items-center justify-center disabled:text-gray-300 disabled:hover:bg-transparent disabled:cursor-not-allowed"
        aria-label="Next month"
      >›</button>
    </div>

    <div class="grid grid-cols-7 mb-2 text-center text-[10px] uppercase tracking-wider text-gb-text-muted font-semibold">
      <div>S</div><div>M</div><div>T</div><div>W</div><div>T</div><div>F</div><div>S</div>
    </div>

    <div class="relative">
      <div class="grid grid-cols-7 gap-y-2 gap-x-1" data-date-grid>
        {/* cells populated client-side */}
      </div>
      <div data-month-loading class="hidden absolute inset-0 flex items-center justify-center bg-white/80 text-gb-text-muted text-sm">
        Loading available dates&hellip;
      </div>
    </div>

    <p data-month-empty class="hidden text-center text-gb-text-muted py-4 mt-2 text-sm">
      No available class times this month. Try the next month &rsaquo;
    </p>
  </div>
</div>

<script>
  type ProgramKey = 'tiny'|'lc1'|'lc2'|'juniors'|'adults';

  const PROGRAM_AGE: Record<ProgramKey, string> = {
    tiny: 'Ages 3–4', lc1: 'Ages 5–6', lc2: 'Ages 7–9', juniors: 'Ages 10–15', adults: 'Ages 16+',
  };

  const MONTH_LONG = ['January','February','March','April','May','June','July','August','September','October','November','December'];

  const root = document.getElementById('booking-flow');
  if (root) {
    const node = root.querySelector('[data-step="date"]');
    const ageEl = node?.querySelector<HTMLElement>('[data-program-age]');
    const nameEl = node?.querySelector<HTMLElement>('[data-program-name]');
    const monthLabel = node?.querySelector<HTMLElement>('[data-month-label]');
    const grid = node?.querySelector<HTMLElement>('[data-date-grid]');
    const loading = node?.querySelector<HTMLElement>('[data-month-loading]');
    const empty = node?.querySelector<HTMLElement>('[data-month-empty]');
    const back = node?.querySelector<HTMLButtonElement>('[data-change-program]');
    const prevBtn = node?.querySelector<HTMLButtonElement>('[data-prev-month]');
    const nextBtn = node?.querySelector<HTMLButtonElement>('[data-next-month]');

    back?.addEventListener('click', () => {
      root.dispatchEvent(new CustomEvent('booking:book-another'));
    });
    prevBtn?.addEventListener('click', () => {
      root.dispatchEvent(new CustomEvent('booking:change-month', { detail: { delta: -1 } }));
    });
    nextBtn?.addEventListener('click', () => {
      root.dispatchEvent(new CustomEvent('booking:change-month', { detail: { delta: 1 } }));
    });

    root.addEventListener('booking:render', (e) => {
      const s = (e as CustomEvent).detail;
      if (s.step !== 'date' || !s.program) return;

      if (ageEl) ageEl.textContent = PROGRAM_AGE[s.program as ProgramKey];
      if (nameEl) nameEl.textContent = s.programName;
      if (monthLabel) monthLabel.textContent = `${MONTH_LONG[s.viewMonth - 1]} ${s.viewYear}`;

      // Cap nav: today's month .. today + 3 months.
      const today = todayInTZ();
      const beforeToday =
        (s.viewYear < today.year) ||
        (s.viewYear === today.year && s.viewMonth <= today.month);
      const maxAhead = addMonths(today.year, today.month, 3);
      const atMax =
        (s.viewYear > maxAhead.year) ||
        (s.viewYear === maxAhead.year && s.viewMonth >= maxAhead.month);
      if (prevBtn) prevBtn.disabled = beforeToday;
      if (nextBtn) nextBtn.disabled = atMax;

      if (loading) loading.classList.toggle('hidden', !s.monthLoading);

      const monthKey = `${s.viewYear}-${String(s.viewMonth).padStart(2, '0')}`;
      const monthLoaded = (s.loadedMonths instanceof Set) ? s.loadedMonths.has(monthKey) : false;
      const slotsByDate = s.slotsByDate || {};

      // Count slots in this month.
      let monthSlotCount = 0;
      const lastDay = lastDayOfMonth(s.viewYear, s.viewMonth);
      for (let d = 1; d <= lastDay; d++) {
        const iso = `${monthKey}-${String(d).padStart(2, '0')}`;
        if ((slotsByDate[iso] || []).length > 0) monthSlotCount++;
      }

      if (empty) {
        empty.classList.toggle('hidden', !(monthLoaded && !s.monthLoading && monthSlotCount === 0));
      }

      renderGrid(grid, s, today);
    });

    function renderGrid(grid: HTMLElement | null | undefined, s: any, today: { year: number; month: number; day: number }) {
      if (!grid) return;
      grid.innerHTML = '';

      const { viewYear, viewMonth, slotsByDate, selectedDate } = s;
      const firstWeekday = new Date(Date.UTC(viewYear, viewMonth - 1, 1)).getUTCDay();
      const lastDay = lastDayOfMonth(viewYear, viewMonth);

      for (let i = 0; i < firstWeekday; i++) {
        const blank = document.createElement('div');
        blank.className = 'h-14 sm:h-16';
        grid.appendChild(blank);
      }

      for (let day = 1; day <= lastDay; day++) {
        const iso = `${viewYear}-${String(viewMonth).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const dailySlots = slotsByDate[iso] || [];
        const hasSlots = dailySlots.length > 0;
        const isPast =
          viewYear < today.year ||
          (viewYear === today.year && viewMonth < today.month) ||
          (viewYear === today.year && viewMonth === today.month && day < today.day);
        const isToday =
          viewYear === today.year && viewMonth === today.month && day === today.day;
        const isSelected = selectedDate === iso;
        const bookable = !isPast && hasSlots;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.date = iso;
        btn.disabled = !bookable;

        // Variant logic: 4 visual states.
        // 1. selected (navy fill)
        // 2. bookable (white card with red dot)
        // 3. today + bookable handled by (2) + a small TODAY marker
        // 4. unavailable (subtle, no chrome)
        let cls = 'relative h-14 sm:h-16 w-full rounded-lg text-center transition flex flex-col items-center justify-center px-1';
        if (isSelected && bookable) {
          cls += ' bg-gb-navy text-white shadow-md';
        } else if (bookable) {
          cls += ' bg-white border border-gray-200 hover:border-gb-navy hover:shadow-sm text-gb-navy cursor-pointer';
        } else {
          cls += ' text-gray-300 cursor-not-allowed';
        }
        btn.className = cls;

        const dayNum = `<div class="text-base sm:text-lg font-bold leading-none">${day}</div>`;
        let extra = '';
        if (bookable && !isSelected) {
          const noun = dailySlots.length === 1 ? 'time' : 'times';
          extra = `<div class="mt-1 inline-flex items-center gap-1 text-[10px] font-semibold text-gb-red leading-none">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-gb-red"></span>${dailySlots.length} ${noun}
          </div>`;
        } else if (bookable && isSelected) {
          const noun = dailySlots.length === 1 ? 'time' : 'times';
          extra = `<div class="mt-1 text-[10px] font-semibold text-white/90 leading-none">${dailySlots.length} ${noun}</div>`;
        }
        const todayMark = isToday
          ? `<div class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 text-[8px] uppercase tracking-wider font-bold ${isSelected ? 'text-white/80' : 'text-gb-navy/60'}">Today</div>`
          : '';

        btn.innerHTML = dayNum + extra + todayMark;

        if (bookable) {
          btn.addEventListener('click', () => {
            root!.dispatchEvent(new CustomEvent('booking:date-selected', { detail: iso }));
          });
        }
        grid.appendChild(btn);
      }
    }

    function todayInTZ(): { year: number; month: number; day: number } {
      const fmt = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Los_Angeles',
        year: 'numeric', month: '2-digit', day: '2-digit',
      });
      const iso = fmt.format(new Date());
      const parts = iso.split('-').map(Number);
      return { year: parts[0]!, month: parts[1]!, day: parts[2]! };
    }

    function addMonths(year: number, month: number, delta: number): { year: number; month: number } {
      const total = (year * 12 + (month - 1)) + delta;
      return { year: Math.floor(total / 12), month: (total % 12) + 1 };
    }

    function lastDayOfMonth(year: number, month: number): number {
      return new Date(Date.UTC(year, month, 0)).getUTCDate();
    }
  }
</script>
