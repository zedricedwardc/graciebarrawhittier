---
/**
 * DatePicker — STATE 3.
 * Horizontal-scroll chips for the next 14 days.
 * A date is enabled only when GHL reports ≥1 free slot for that day.
 * Each enabled chip shows the count of available times beneath the date.
 *
 * Emits booking:date-selected with the YYYY-MM-DD string.
 */
import { TZ } from '../../data/schedule';
---

<div>
  <div class="flex items-center justify-between mb-4">
    <div>
      <p class="text-gb-text-muted uppercase tracking-widest text-xs font-semibold" data-program-age></p>
      <h3 class="text-2xl font-bold text-gb-navy" data-program-name></h3>
    </div>
    <button type="button" data-change-program class="text-sm text-gb-text-muted hover:text-gb-navy underline">← Change program</button>
  </div>

  <p class="text-gb-text mb-3 font-semibold">Pick a date</p>
  <div data-date-loading class="text-center text-gb-text-muted py-6">
    Loading available dates&hellip;
  </div>
  <div class="flex gap-2 overflow-x-auto pb-2 -mx-1 px-1 hidden" data-date-row>
    {/* chips populated client-side from state.slotsByDate */}
  </div>
  <p data-date-empty class="hidden text-center text-gb-text-muted py-4">
    No available class times in the next 14 days. Please call (562) 640-1400.
  </p>
</div>

<script define:vars={{ TZ }}>
  const root = document.getElementById('booking-flow');
  if (root) {
    const node = root.querySelector('[data-step="date"]');
    const ageEl = node?.querySelector('[data-program-age]');
    const nameEl = node?.querySelector('[data-program-name]');
    const row = node?.querySelector('[data-date-row]');
    const loading = node?.querySelector('[data-date-loading]');
    const empty = node?.querySelector('[data-date-empty]');
    const back = node?.querySelector('[data-change-program]');

    const PROGRAM_AGE = {
      tiny: 'Ages 3–4', lc1: 'Ages 5–6', lc2: 'Ages 7–9', juniors: 'Ages 10–15', adults: 'Ages 16+',
    };

    back?.addEventListener('click', () => {
      root.dispatchEvent(new CustomEvent('booking:book-another'));
    });

    root.addEventListener('booking:render', (e) => {
      const s = e.detail;
      if (s.step !== 'date' || !s.program) return;
      ageEl.textContent = PROGRAM_AGE[s.program];
      nameEl.textContent = s.programName;

      const loaded = s.availabilityLoadedFor === s.program;
      if (!loaded) {
        loading.classList.remove('hidden');
        row.classList.add('hidden');
        empty.classList.add('hidden');
        return;
      }

      const slotsByDate = s.slotsByDate || {};
      const dateKeys = Object.keys(slotsByDate).filter((k) => (slotsByDate[k] || []).length > 0);
      if (dateKeys.length === 0) {
        loading.classList.add('hidden');
        row.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      empty.classList.add('hidden');
      row.classList.remove('hidden');
      row.innerHTML = '';

      const today = new Date();
      for (let i = 0; i < 14; i++) {
        const d = new Date(today);
        d.setDate(today.getDate() + i);
        const wd = weekdayInTZ(d, TZ);
        const iso = isoDate(d, TZ);
        const dailySlots = slotsByDate[iso] || [];
        const hasSlots = dailySlots.length > 0;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.date = iso;
        btn.disabled = !hasSlots;
        btn.className =
          'shrink-0 min-w-[72px] py-2 px-3 rounded-xl border-2 text-center transition-colors ' +
          (hasSlots
            ? 'border-gray-300 hover:border-gb-navy text-gb-text bg-white'
            : 'border-gray-200 text-gray-300 bg-gray-50 cursor-not-allowed');
        const countLine = hasSlots
          ? '<div class="text-[10px] font-semibold text-gb-red mt-0.5">' + dailySlots.length + ' time' + (dailySlots.length === 1 ? '' : 's') + '</div>'
          : '<div class="text-[10px] text-gray-300 mt-0.5">—</div>';
        btn.innerHTML =
          '<div class="text-[10px] uppercase tracking-wider">' + WEEKDAY_SHORT[wd] + '</div>' +
          '<div class="text-lg font-bold">' + d.getDate() + '</div>' +
          '<div class="text-[10px] text-gb-text-muted">' + MONTH_SHORT[d.getMonth()] + '</div>' +
          countLine;
        if (hasSlots) {
          btn.addEventListener('click', () => {
            row.querySelectorAll('button').forEach((b) => b.classList.remove('bg-gb-navy','text-white','border-gb-navy'));
            btn.classList.add('bg-gb-navy','text-white','border-gb-navy');
            root.dispatchEvent(new CustomEvent('booking:date-selected', { detail: iso }));
          });
        }
        row.appendChild(btn);
      }
    });

    const WEEKDAY_SHORT = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    const MONTH_SHORT = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    function weekdayInTZ(d, tz) {
      const fmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short' });
      const wd = fmt.format(d);
      return ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].indexOf(wd);
    }
    function isoDate(d, tz) {
      const fmt = new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' });
      return fmt.format(d);
    }
  }
</script>
