---
/**
 * RebookHeader — personalized greeting + credits remaining for the /rebook page.
 *
 * Renders inside #booking-flow as a non-step element so it shows above whichever
 * step is active. Updates from the booking-flow state via the booking:render event.
 */
---

<div
  data-rebook-header
  hidden
  class="bg-gb-white rounded-2xl shadow-lg border-4 border-gb-gold p-6 md:p-8 mb-6"
>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <p class="text-xs md:text-sm font-bold tracking-widest uppercase text-gb-gold">
        Welcome back
      </p>
      <h2 class="mt-1 text-2xl md:text-3xl font-extrabold text-gb-navy" data-rebook-greeting>
        Pick your next class
      </h2>
      <p class="mt-2 text-sm text-gb-text-muted" data-rebook-tagline>
        Book your next free trial class — same as before.
      </p>
    </div>

    <div class="shrink-0 inline-flex items-center gap-3 bg-gb-bg-light rounded-xl px-4 py-3">
      <svg class="w-7 h-7 text-gb-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M16 3v4M8 3v4M3 11h18" />
        <path d="M9 15l2 2 4-4" />
      </svg>
      <div>
        <div class="text-2xl font-extrabold text-gb-navy leading-none" data-rebook-credits>0</div>
        <div class="text-[11px] uppercase tracking-wider font-semibold text-gb-text-muted leading-tight mt-0.5">
          classes left
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('booking-flow');
  if (root) {
    const header = document.querySelector<HTMLElement>('[data-rebook-header]');
    const greetingEl = header?.querySelector<HTMLElement>('[data-rebook-greeting]');
    const taglineEl = header?.querySelector<HTMLElement>('[data-rebook-tagline]');
    const creditsEl = header?.querySelector<HTMLElement>('[data-rebook-credits]');

    root.addEventListener('booking:render', (e) => {
      const s = (e as CustomEvent).detail;
      // Hide on the lookup form (step === 'lookup') and on terminal states.
      if (!header) return;
      const showOn = ['date', 'slot', 'confirm', 'success'];
      header.hidden = !s.rebook?.authenticated || !showOn.includes(s.step);

      const traineeName = s.rebook?.traineeName ?? '';
      const credits = s.rebook?.creditsRemaining ?? 0;

      if (greetingEl) {
        greetingEl.textContent = traineeName
          ? `Pick ${traineeName}'s next class`
          : 'Pick your next class';
      }
      if (taglineEl) {
        const noun = credits === 1 ? 'class' : 'classes';
        taglineEl.textContent = credits > 0
          ? `${credits} free ${noun} remaining on the trial pass.`
          : 'No credits left — please contact us to renew.';
      }
      if (creditsEl) creditsEl.textContent = String(credits);
    });
  }
</script>
