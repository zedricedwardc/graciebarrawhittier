---
/**
 * Nav — desktop horizontal nav + slot for mobile drawer trigger.
 * Logo + nav links + a single red "Get Started Free" CTA.
 *
 * "Get Started Free" is page-aware: if the current page has an #trial element,
 * the inline script below intercepts the click and smooth-scrolls to it.
 * Otherwise (e.g. /contact, /reviews) the link falls through to /#trial.
 */
import CTAButton from '../cta/CTAButton.astro';
import MobileNavDrawer from './MobileNavDrawer.astro';
import StickyMobileCTA from '../cta/StickyMobileCTA.astro';

export interface Props {
  /** Hide the mobile CTA bar at the top of the header (e.g. legal pages). */
  hideStickyCTA?: boolean;
}

const { hideStickyCTA = false } = Astro.props;

const links = [
  { label: 'Home', href: '/' },
  { label: 'Kids Martial Arts', href: '/kids-martial-arts' },
  { label: 'Adults Jiu-Jitsu', href: '/adults-jiu-jitsu' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Contact Us', href: '/contact' },
];
---

<header class="sticky top-0 z-30 bg-gb-white/95 backdrop-blur border-b border-gb-bg-light">
  {!hideStickyCTA && <StickyMobileCTA />}
  <nav
    class="max-w-7xl mx-auto px-4 md:px-6 h-16 md:h-20 flex items-center justify-between"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Gracie Barra Whittier home">
      <img
        src="/logo/favicon.webp"
        alt="Gracie Barra Whittier — Brazilian Jiu-Jitsu"
        class="h-12 md:h-14 w-auto"
        width="56"
        height="56"
      />
      <span class="sr-only">Gracie Barra Whittier</span>
      <span class="text-xs md:text-sm font-semibold tracking-wide uppercase text-gb-black/90">
                Gracie Barra Whittier
              </span>
    </a>

    <ul class="hidden md:flex items-center gap-7 text-sm font-medium text-gb-text">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="hover:text-gb-red transition-colors"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden md:block">
      <CTAButton variant="nav" label="Get Started Free" href="/#trial" class="js-trial-link" />
    </div>

    <div class="md:hidden">
      <MobileNavDrawer />
    </div>
  </nav>
</header>

<script>
  // Smart-link for any "Get Started" CTA that points to #trial:
  // 1. If the current page has an inline #trial section → smooth-scroll to it.
  // 2. Else if the page has a [data-trial-modal] dialog (e.g. /contact, /reviews) → open the modal.
  // 3. Otherwise let the browser navigate to /#trial (homepage opt-in fallback).
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const link = target?.closest<HTMLAnchorElement>('a.js-trial-link');
    if (!link) return;

    const trial = document.getElementById('trial');
    const modal = document.querySelector<HTMLDialogElement>('[data-trial-modal]');
    if (!trial && !modal) return; // fall through to /#trial navigation

    e.preventDefault();

    // Close the mobile drawer if it's open before scrolling/opening modal.
    const drawer = document.querySelector<HTMLDialogElement>('[data-mobile-nav-drawer]');
    if (drawer?.open) drawer.close();

    requestAnimationFrame(() => {
      if (trial) {
        trial.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', '#trial');
      } else if (modal) {
        modal.showModal();
      }
    });
  });
</script>
