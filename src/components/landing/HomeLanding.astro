          decoding="async"
        />
      </div>
      <div class="bg-gb-white rounded-2xl shadow-sm border border-gb-bg-light p-6 md:p-10">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gb-navy">Why Gracie Barra Whittier?</h2>
        <div class="mt-4 space-y-4 text-sm md:text-base text-gb-text-muted leading-relaxed">
          <p>Gracie Barra Whittier is more than a martial arts academy — it's a structured path to confidence, discipline, and real-world self-defense.</p>
          <p>Our certified instructors follow the proven Gracie Barra curriculum, guiding students of all ages through a system designed to produce measurable progress on and off the mats.</p>
          <p>Whether you're enrolling your child or starting your own journey, you'll find a safe, welcoming environment built around growth, accountability, and community.</p>
          <p>Explore our class schedule and see why families across Whittier trust us.</p>
        </div>

        <ul class="mt-6 space-y-2.5">
          {whyBullets.map((b) => (
            <li class="flex items-start gap-2.5 text-sm md:text-base text-gb-text">
              <svg class="w-5 h-5 mt-0.5 shrink-0 text-gb-red" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" transform="translate(2,2)" />
              </svg>
              <span>{b}</span>
            </li>
          ))}
        </ul>

        <p class="mt-6 text-sm md:text-base font-semibold text-gb-red leading-relaxed">
          Proudly serving the Whittier community with world-class Brazilian Jiu-Jitsu instruction in a clean, safe, and welcoming academy.
        </p>

        <div class="mt-6">
          <CTAButton variant="primary" label="Claim My Free 3-Class Pass" href="#trial" fullWidth={true} />
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
     A GLOBAL STANDARD. A LOCAL COMMUNITY.
     ============================================================ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <img
          src="/logo/favicon.webp"
          alt=""
          aria-hidden="true"
          class="w-14 h-14 md:w-25 md:h-25 mx-auto"
          width="64"
          height="64"
        />
        <h2 class="mt-4 text-2xl md:text-4xl font-extrabold text-gb-red">A Global Standard. A Local Community.</h2>
        <p class="mt-3 text-sm md:text-base text-gb-text-muted max-w-2xl mx-auto leading-relaxed">
          Gracie Barra is one of the most respected Brazilian Jiu-Jitsu organizations in the world — and you can experience that same world-class training right here in Whittier.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {stats.map((s) => (
          <div class="bg-gb-white rounded-2xl p-5 md:p-6 text-center shadow-sm flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-gb-red/10 text-gb-red flex items-center justify-center mb-4">
              {s.icon === 'globe' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20" />
                  <path d="M12 2a15 15 0 010 20a15 15 0 010-20z" />
                </svg>
              )}
              {s.icon === 'people' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M9 11a4 4 0 100-8 4 4 0 000 8zm0 2c-3.3 0-6 1.8-6 4v2h12v-2c0-2.2-2.7-4-6-4zm9-2a3 3 0 100-6 3 3 0 000 6zm0 2c-1 0-1.9.2-2.7.6 1.7 1 2.7 2.5 2.7 4.4v2h6v-2c0-2.5-2.7-5-6-5z" />
                </svg>
              )}
              {s.icon === 'star' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2l2.95 6.94L22 10l-5.5 4.78L18.18 22 12 18.27 5.82 22 7.5 14.78 2 10l7.05-1.06L12 2z" />
                </svg>
              )}
              {s.icon === 'shield' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2L4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5l-8-3zm-1 14l-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6z" />
                </svg>
              )}
            </div>
            <p class="text-2xl md:text-3xl font-extrabold text-gb-navy leading-none">{s.value}</p>
            <p class="mt-1 text-sm font-bold text-gb-navy">{s.label}</p>
            <p class="mt-3 text-xs text-gb-text-muted leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
     SEE LIFE INSIDE GRACIE BARRA WHITTIER
     ============================================================ */}
  <section class="px-4 md:px-6 pt-4 md:pt-6 pb-12 md:pb-16">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-6 md:mb-8">
        <h2 class="text-2xl md:text-4xl font-extrabold text-gb-navy">See Life Inside Gracie Barra Whittier</h2>
        <p class="mt-3 text-sm md:text-base text-gb-text-muted max-w-2xl mx-auto leading-relaxed">
          Gracie Barra is one of the most respected Brazilian Jiu-Jitsu organizations in the world — and you can experience that same world-class training right here in Whittier.
        </p>
      </div>

      <div data-gallery-carousel>
        <div class="overflow-hidden -mx-4 md:-mx-6">
          <div
            class="flex gap-3 md:gap-4 px-4 md:px-6 will-change-transform"
            data-carousel-track
          >
            {[...galleryImages, ...galleryImages].map((g, i) => (
              <div
                class="shrink-0 w-[78%] sm:w-[48%] md:w-[32%] aspect-[4/3] overflow-hidden rounded-xl bg-gb-bg-light"
                aria-hidden={i >= galleryImages.length ? 'true' : undefined}
              >
                <img
                  src={g.src}
                  alt={i >= galleryImages.length ? '' : g.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
              </div>
            ))}
          </div>
        </div>

        <div class="mt-4 flex justify-center gap-2" data-carousel-dots>
          {galleryImages.map((_, i) => (
            <button
              type="button"
              data-dot
              data-index={i}
              aria-label={`Go to slide ${i + 1}`}
              class="w-2 h-2 rounded-full bg-gb-text-muted/30 hover:bg-gb-text-muted/60 transition-colors"
            />
          ))}
        </div>
      </div>

      <div class="mt-8 text-center">
        <CTAButton variant="primary" label="Claim My Free 3-Class Pass" href="#trial" />
      </div>
    </div>
  </section>

  <script>
    const carousels = document.querySelectorAll<HTMLElement>('[data-gallery-carousel]');
    carousels.forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-carousel-track]');
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
      if (!track) return;

      const SPEED_PX_PER_SEC = 40;
      let offset = 0;
      let halfWidth = 0;
      let cardStep = 0;
      let rafId: number | undefined;
      let lastT = 0;
      let activeIdx = -1;

      const recalc = () => {
        const children = track.children;
        if (children.length < 2) return;
        const halfIndex = Math.floor(children.length / 2);
        const halfStart = (children[halfIndex] as HTMLElement).offsetLeft;
        halfWidth = halfStart;
        const a = (children[0] as HTMLElement).offsetLeft;
        const b = (children[1] as HTMLElement).offsetLeft;
        cardStep = b - a;
        if (offset >= halfWidth) offset = offset % halfWidth;
      };

      const updateDots = () => {
        if (cardStep <= 0 || dots.length === 0) return;
        const idx = Math.round(offset / cardStep) % dots.length;
        if (idx === activeIdx) return;
        activeIdx = idx;
        dots.forEach((d, i) => {
          const isActive = i === idx;
          d.classList.toggle('bg-gb-navy', isActive);
          d.classList.toggle('w-6', isActive);
          d.classList.toggle('bg-gb-text-muted/30', !isActive);
        });
      };

      const apply = () => {
        track.style.transform = `translate3d(${-offset}px, 0, 0)`;
        updateDots();
      };

      const tick = (t: number) => {
        if (!lastT) lastT = t;
        const dt = t - lastT;
        lastT = t;
        offset += (SPEED_PX_PER_SEC * dt) / 1000;
        if (halfWidth > 0 && offset >= halfWidth) offset -= halfWidth;
        apply();
        rafId = requestAnimationFrame(tick);
      };

      const start = () => {
        if (rafId !== undefined) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        lastT = 0;
        rafId = requestAnimationFrame(tick);
      };
      const stop = () => {
        if (rafId !== undefined) {
          cancelAnimationFrame(rafId);
          rafId = undefined;
        }
      };

      recalc();
      apply();
      window.addEventListener('resize', () => {
        recalc();
        apply();
      });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          offset = cardStep * i;
          apply();
        });
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      start();
    });
  </script>

  {/* ============================================================
     FAQ — bento navy card
     ============================================================ */}
  <section class="px-4 md:px-6 pt-2 pb-12 md:pt-4 md:pb-16" aria-labelledby="faq-heading">
    <div class="max-w-6xl mx-auto bg-gb-navy rounded-2xl shadow-lg text-gb-white px-6 md:px-10 lg:px-14 py-12 md:py-16">
