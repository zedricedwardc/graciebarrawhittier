---
/**
 * StickyMobileCTA — edge-to-edge two-up CTA bar visible <md (mobile only).
 * Rendered as the top row of the sticky <Nav> header so it sits at the very top.
 * Two solid red boxes split by a thin divider: "Call Us" (tel:) and
 * "Claim Free Class Pass" (/#trial), each with an icon stacked above the label.
 */
import { nap } from '../../content/nap';

export interface Props {
  /** Where "Claim Free Class" points. Ad landing pages pass '#trial' to stay on-page. */
  trialHref?: string;
}

const { trialHref = '/#trial' } = Astro.props;

const boxClass =
  'flex-1 min-w-0 flex flex-col items-center justify-center gap-1 ' +
  'bg-gb-red text-gb-white py-2.5 px-2 ' +
  'text-[11px] font-bold tracking-[0.08em] uppercase leading-tight text-center ' +
  'hover:bg-gb-red-dark active:bg-gb-red-dark transition-colors ' +
  'focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-gb-white';
---

<div
  class="md:hidden flex items-stretch w-full"
  data-sticky-mobile-cta
>
  <a
    href={`tel:${nap.phoneTel}`}
    class={`${boxClass} border-r border-gb-white/30`}
    aria-label={`Call ${nap.name} at ${nap.phone}`}
  >
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
    </svg>
    <span>Call Us</span>
  </a>
  <a
    href={trialHref}
    class={`${boxClass} js-trial-link`}
    aria-label="Claim Free Class Pass"
  >
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2"/>
      <path d="M16 3v4M8 3v4M3 11h18"/>
      <path d="M9 15l2 2 4-4"/>
    </svg>
    <span>Claim Free Class</span>
  </a>
</div>
