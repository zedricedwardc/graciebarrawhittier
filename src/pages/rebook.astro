---
/**
 * /rebook — multi-trainee rebook dashboard for active-trial-pass holders.
 *
 * Two entry paths:
 *   1. Magic link (?t=<token>) — minted at trial activation (Phase 4) and
 *      embedded in rebook reminder SMS/email. Page POSTs token to
 *      /api/rebook-context, receives all trainees on this contact + a
 *      `tokenTraineeKey` flag pointing at the trainee the magic link was
 *      minted for (that card auto-expands).
 *   2. Email lookup — fallback when customer doesn't have the link. Page
 *      POSTs { email } to /api/rebook-lookup, receives all trainees on the
 *      contact (no card auto-expanded — they pick).
 *
 * Each trainee renders as a card showing name, program, credits remaining,
 * and last attended date. Click "Book a class" on any card → DatePicker +
 * SlotPicker render inline below it. Pick slot → confirm → card updates
 * with the booking + decremented credit counter, area collapses. Customer
 * can then click another card to book for another trainee in the same
 * session — each booking uses the per-trainee sessionToken returned by
 * the lookup/context endpoints.
 *
 * The single #booking-flow DOM element is moved between cards as the user
 * switches active trainee, so the shared DatePicker + SlotPicker components
 * (which use document.getElementById('booking-flow')) keep working unchanged.
 */
import FunnelLayout from '../layouts/FunnelLayout.astro';
import DatePicker from '../components/booking/DatePicker.astro';
import SlotPicker from '../components/booking/SlotPicker.astro';

const renderTs = Date.now();
---

<FunnelLayout
  title="Book Your Next Class | Gracie Barra Whittier"
  description="Manage and book your active trial classes."
>
  <section class="max-w-5xl mx-auto px-4 md:px-6 pt-8 md:pt-12 pb-10" data-render-ts={renderTs}>
    <div class="text-center mb-6 md:mb-8">
      <p class="text-gb-text-muted uppercase tracking-widest text-xs md:text-sm font-semibold mb-2">
        Manage Your Classes
      </p>
      <h1 class="text-3xl md:text-5xl font-extrabold text-gb-navy leading-tight">
        Book Your Next Class
      </h1>
    </div>

    {/* Step: lookup (also entry point for magic-link validation) */}
    <div data-step="lookup">
      <div data-lookup-loading hidden class="bg-gb-white rounded-2xl shadow-lg border-2 border-gb-gold p-8 text-center text-gb-text-muted">
        Verifying your link&hellip;
      </div>

      <div data-lookup-form>
        <div class="bg-gb-white rounded-2xl shadow-lg border-2 border-gb-gold p-6 md:p-10">
          <h2 class="text-xl md:text-2xl font-bold text-gb-navy mb-2">Find your trial passes</h2>
          <p class="text-sm text-gb-text-muted mb-6">
            Enter the email you used when you signed up. We'll show every active class pass on your account.
          </p>

          <form data-rebook-lookup-form class="space-y-4" novalidate>
            <div>
              <label for="rebook-email" class="block text-sm font-medium text-gb-text mb-1">Email</label>
              <input
                id="rebook-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                required
                class="w-full h-12 px-4 rounded-lg border border-gray-300 bg-gb-white text-gb-text placeholder-gb-text-muted focus:outline-none focus:ring-2 focus:ring-gb-red focus:border-gb-red"
                placeholder="you@example.com"
              />
            </div>

            <button
              type="submit"
              data-lookup-submit
              class="w-full h-14 rounded-full bg-gb-red text-gb-white font-bold text-base hover:bg-gb-red-dark transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
            >
              Find My Classes
            </button>

            <p data-lookup-error class="hidden text-sm text-gb-red text-center" role="alert">
              We couldn't find any active class passes for that email. Double-check or
              <a href="/contact/" class="underline font-semibold hover:text-gb-red-dark">contact us</a>.
            </p>
          </form>
        </div>
      </div>
    </div>

    {/* Step: dashboard — trainee cards rendered here after lookup */}
    <div data-step="dashboard" hidden>
      <p class="text-sm text-gb-text-muted text-center mb-6">
        Pick a trainee below to book their next class.
      </p>
      <div data-trainee-list class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5"></div>

      {/* Enrolled students — settled members, no booking action; kept apart
          from the active-trial cards so the booking call-to-action stays clear. */}
      <div data-enrolled-section hidden class="mt-10 pt-8 border-t border-gb-bg-light">
        <h2 class="text-sm font-bold tracking-wider uppercase text-gb-text-muted text-center mb-5">
          Enrolled students
        </h2>
        <div data-enrolled-list class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5"></div>
      </div>
      {/*
        Tailwind safelist: these classes are toggled on the active card via JS
        in toggleCard()/collapseActive(). Tailwind only compiles classes it
        sees in source, so without this hidden marker the dynamic classes
        wouldn't make it into the CSS bundle.
      */}
      <span hidden class="sm:col-span-2 lg:col-span-3 order-first
        border-dashed border-gb-text-muted text-gb-text-muted
        bg-gb-bg-light text-gb-navy"></span>

      <button
        type="button"
        data-back-to-lookup
        class="mt-6 mx-auto block text-sm text-gb-text-muted underline hover:text-gb-navy transition-colors"
      >
        ← Look up a different email
      </button>
    </div>

    {/*
      Rebook-flow scoped overrides for shared DatePicker/SlotPicker components:
      - Hide the "Change program" link (no-op in this flow)
      - Soften the gold calendar border to neutral gray (the gold trainee
        card already provides the focal point; nested gold-on-gold is too loud)
    */}
    <style is:global>
      /*
        is:global so these rules reach into the shared DatePicker/SlotPicker
        components (Astro scopes <style> by default — the DatePicker's
        markup lives in a different .astro file and wouldn't get the
        scope hash applied).
      */
      section[data-flow="rebook"] [data-change-program] { display: none; }
      section[data-flow="rebook"] .border-gb-gold {
        border-color: var(--color-gb-bg-light, #e5e7eb) !important;
      }
    </style>

    {/*
      The single shared booking-flow controller — DatePicker + SlotPicker live
      here. Hidden parking spot when no card is active; moved into the active
      card's [data-card-booking-area] when one is expanded.
    */}
    <div hidden>
      <section id="booking-flow" data-flow="rebook">
        <div data-step="date" hidden>
          <DatePicker />
        </div>
        <div data-step="slot" hidden>
          <SlotPicker />
        </div>
        <div data-step="confirm" hidden>
          <div class="bg-gb-white rounded-2xl shadow-lg border-2 border-gb-gold p-6 md:p-8">
            <h3 class="text-lg md:text-xl font-bold text-gb-navy mb-2">Confirm your booking</h3>
            <p class="text-sm text-gb-text-muted mb-6" data-confirm-summary>&nbsp;</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <button
                type="button"
                data-confirm-back
                class="h-14 rounded-full bg-gb-white border-2 border-gb-navy text-gb-navy font-bold hover:bg-gb-bg-light transition-colors"
              >
                ← Change time
              </button>
              <button
                type="button"
                data-confirm-submit
                class="h-14 rounded-full bg-gb-red text-gb-white font-bold hover:bg-gb-red-dark transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
              >
                Confirm Booking
              </button>
            </div>

            <p data-confirm-error class="hidden mt-4 text-sm text-gb-red text-center" role="alert">
              Something went wrong booking. Please try again or call us at (562) 640-1400.
            </p>
          </div>
        </div>
        <div data-step="error" hidden>
          <div class="bg-gb-white rounded-2xl shadow-lg border-2 border-gb-gold p-6 md:p-8 text-center">
            <h3 class="text-lg md:text-xl font-bold text-gb-navy">Something went wrong</h3>
            <p class="mt-3 text-sm text-gb-text-muted" data-error-message>&nbsp;</p>
            <button
              type="button"
              data-error-retry
              class="mt-6 h-12 px-8 rounded-full bg-gb-red text-gb-white font-bold hover:bg-gb-red-dark transition-colors"
            >
              Try again
            </button>
          </div>
        </div>
      </section>
    </div>
  </section>
</FunnelLayout>

<script>
  /**
   * /rebook controller — multi-trainee dashboard.
   *
   * State machine:
   *   lookup → dashboard (cards visible)
   *   On card expand: cardStep='date' → 'slot' → 'confirm' → 'success' (back to dashboard)
   */
  type ProgramKey = 'tiny' | 'lc1' | 'lc2' | 'juniors' | 'adults';
  type Step = 'lookup' | 'dashboard';
  type CardStep = 'idle' | 'change-program' | 'date' | 'slot' | 'confirm' | 'success' | 'error';

  interface Slot { startISO: string; endISO: string; label: string; }
  type TraineeStatus = 'enrolled' | 'active' | 'exhausted' | 'pending';
  interface Trainee {
    traineeName: string;
    traineeKey: string;
    program: string;
    status: TraineeStatus;
    creditsRemaining: number;
    lastAttendanceISO: string | null;
    nextClassISO: string | null;
    sessionToken?: string;
    /** Session-only: set after a booking in this visit to show the confirmation badge. */
    justBooked?: boolean;
  }

  const PROGRAM_NAME: Record<ProgramKey, string> = {
    tiny: 'Tiny Champions',
    lc1: 'Little Champions 1',
    lc2: 'Little Champions 2',
    juniors: 'Juniors Jiu-Jitsu',
    adults: 'Adults Brazilian Jiu-Jitsu',
  };

  const PROGRAM_AGE: Record<ProgramKey, string> = {
    tiny: 'Ages 3–4',
    lc1: 'Ages 5–6',
    lc2: 'Ages 7–9',
    juniors: 'Ages 10–15',
    adults: 'Ages 16+',
  };

  const PROGRAM_ORDER: ProgramKey[] = ['tiny', 'lc1', 'lc2', 'juniors', 'adults'];

  const root = document.querySelector<HTMLElement>('[data-render-ts]');
  if (root) {
    const state = {
      step: 'lookup' as Step,
      contactId: null as string | null,
      contactToken: null as string | null,
      trainees: [] as Trainee[],
      activeTraineeKey: null as string | null,
      cardStep: 'idle' as CardStep,
      // Booking-flow state (for the active trainee). Mirrors fields DatePicker/SlotPicker read.
      program: null as ProgramKey | null,
      programName: '',
      selectedDate: null as string | null,
      selectedSlot: null as Slot | null,
      slots: [] as Slot[],
      slotsByDate: {} as Record<string, Slot[]>,
      slotsLoadedFor: null as string | null,
      loadedMonths: new Set<string>() as Set<string>,
      viewYear: 0,
      viewMonth: 0,
      monthLoading: false,
      submitting: false,
      pageRenderTs: Number(root.dataset.renderTs ?? Date.now()),
      lastError: '',
      addPerson: {
        open: false,
        step: 'details' as 'details' | 'date' | 'slot' | 'confirm' | 'error',
        firstName: '',
        age: 0,
      },
    };

    const lookupLoading = root.querySelector<HTMLElement>('[data-lookup-loading]');
    const lookupForm = root.querySelector<HTMLElement>('[data-lookup-form]');
    const lookupFormEl = root.querySelector<HTMLFormElement>('[data-rebook-lookup-form]');
    const lookupSubmit = root.querySelector<HTMLButtonElement>('[data-lookup-submit]');
    const lookupError = root.querySelector<HTMLElement>('[data-lookup-error]');

    const dashboardEl = root.querySelector<HTMLElement>('[data-step="dashboard"]');
    const traineeList = root.querySelector<HTMLElement>('[data-trainee-list]');
    const enrolledSection = root.querySelector<HTMLElement>('[data-enrolled-section]');
    const enrolledList = root.querySelector<HTMLElement>('[data-enrolled-list]');
    const backToLookupBtn = root.querySelector<HTMLButtonElement>('[data-back-to-lookup]');

    const bookingFlow = document.getElementById('booking-flow') as HTMLElement | null;
    const bookingFlowParking = bookingFlow?.parentElement ?? null;

    const confirmSummary = bookingFlow?.querySelector<HTMLElement>('[data-confirm-summary]') ?? null;
    const confirmBack = bookingFlow?.querySelector<HTMLButtonElement>('[data-confirm-back]') ?? null;
    const confirmSubmit = bookingFlow?.querySelector<HTMLButtonElement>('[data-confirm-submit]') ?? null;
    const confirmError = bookingFlow?.querySelector<HTMLElement>('[data-confirm-error]') ?? null;

    const errorMessage = bookingFlow?.querySelector<HTMLElement>('[data-error-message]') ?? null;
    const errorRetry = bookingFlow?.querySelector<HTMLButtonElement>('[data-error-retry]') ?? null;

    // ─── Step / card rendering ────────────────────────────────────────────
    function renderStep() {
      const lookup = root!.querySelector<HTMLElement>('[data-step="lookup"]');
      if (lookup) lookup.hidden = state.step !== 'lookup';
      if (dashboardEl) dashboardEl.hidden = state.step !== 'dashboard';
    }

    function renderCards() {
      if (!traineeList) return;
      // Split: active-trial cards (bookable) go in the main grid with the
      // add-person tile; enrolled students drop into their own section.
      const bookable = state.trainees.filter((t) => t.status !== 'enrolled');
      const enrolled = state.trainees.filter((t) => t.status === 'enrolled');

      traineeList.innerHTML = '';
      for (const t of bookable) {
        traineeList.appendChild(buildCard(t));
      }
      traineeList.appendChild(buildAddPersonTile());

      if (enrolledList) {
        enrolledList.innerHTML = '';
        for (const t of enrolled) {
          enrolledList.appendChild(buildCard(t));
        }
      }
      if (enrolledSection) enrolledSection.hidden = enrolled.length === 0;
    }

    function buildAddPersonTile(): HTMLElement {
      const tile = document.createElement('article');
      tile.dataset.addPersonTile = '';
      tile.className = 'rounded-2xl border-2 border-dashed border-gb-text-muted p-5 md:p-6 flex flex-col';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.addPersonOpen = '';
      btn.className = 'flex-1 w-full text-gb-navy font-bold text-base flex flex-col items-center justify-center gap-2 min-h-[7rem] opacity-50 hover:opacity-100 hover:text-gb-red transition-all';
      btn.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" class="w-9 h-9" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
          <path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span>Add a new person</span>`;
      btn.addEventListener('click', () => openAddPerson());
      tile.appendChild(btn);
      const area = document.createElement('div');
      area.dataset.addPersonArea = '';
      area.hidden = true;
      tile.appendChild(area);
      return tile;
    }

    /**
     * Classes toggled on the active card to (a) span the full grid row
     * and (b) jump to grid position 1 — so the active card always reads
     * as `[full-width active] / [collapsed cards below in the normal grid]`
     * instead of orphaning earlier cards in their narrow column.
     */
    const ACTIVE_SPAN_CLASSES = ['sm:col-span-2', 'lg:col-span-3', 'order-first'];

    function statusBadge(t: Trainee): string {
      if (t.status === 'enrolled') {
        return `<div class="text-right shrink-0"><span class="inline-block bg-gb-green/10 text-gb-green text-[10px] font-bold tracking-wider px-2 py-1 rounded uppercase whitespace-nowrap">Enrolled</span></div>`;
      }
      if (t.status === 'pending') {
        return `<div class="text-right shrink-0"><span class="inline-block bg-gb-red/10 text-gb-red text-[10px] font-bold tracking-wider px-2 py-1 rounded uppercase whitespace-nowrap">Trial booked</span></div>`;
      }
      return `<div class="text-right shrink-0">
          <p class="text-2xl md:text-3xl font-extrabold text-gb-red leading-none">${t.creditsRemaining}</p>
          <p class="text-xs text-gb-text-muted">${t.creditsRemaining === 1 ? 'class left' : 'classes left'}</p>
        </div>`;
    }

    function buildCard(t: Trainee): HTMLElement {
      const isActive = state.activeTraineeKey === t.traineeKey;
      const isExhausted = t.status === 'exhausted';
      const programLabel = PROGRAM_NAME[t.program as ProgramKey] ?? t.program;

      const card = document.createElement('article');
      card.dataset.traineeCard = '';
      card.dataset.traineeKey = t.traineeKey;
      // Border / bg keyed off trainee status:
      //   enrolled  — green tint + green border (settled student)
      //   active    — white + gold border (trial running)
      //   exhausted — red tint + red border ("trial complete, enroll next")
      //   pending   — white + light border (trial booked, not yet activated)
      // flex flex-col + mt-auto on the actions block bottom-aligns the
      // button / note across cards in a row, regardless of how many lines
      // the trainee name or program label wraps to.
      const baseClass = 'rounded-2xl shadow-md border-2 p-5 md:p-6 transition-colors flex flex-col';
      let stateClass: string;
      if (t.status === 'enrolled') {
        stateClass = 'bg-gb-green/5 border-gb-green';
      } else if (isExhausted) {
        stateClass = 'bg-gb-red/5 border-gb-red';
      } else if (t.status === 'active') {
        stateClass = 'bg-gb-white border-gb-gold';
      } else {
        stateClass = 'bg-gb-white border-gb-bg-light';
      }
      card.className = isActive
        ? `${baseClass} ${stateClass} ${ACTIVE_SPAN_CLASSES.join(' ')}`
        : `${baseClass} ${stateClass}`;

      const header = document.createElement('div');
      header.className = 'flex items-start justify-between gap-4';
      header.innerHTML = `
        <div class="flex-1 min-w-0">
          ${
            isExhausted
              ? `<span class="inline-block bg-gb-red/10 text-gb-red text-[10px] font-bold tracking-wider px-2 py-0.5 rounded uppercase whitespace-nowrap mb-1">Trial complete</span>`
              : ''
          }
          <h3 class="text-lg md:text-xl font-extrabold text-gb-navy truncate">${escapeHtml(t.traineeName)}</h3>
          <p class="text-sm text-gb-text-muted">${escapeHtml(programLabel)}</p>
          ${appointmentLine(t)}
          ${
            t.justBooked && t.status !== 'pending' && t.status !== 'enrolled'
              ? `<span class="inline-block mt-2 bg-gb-green/10 text-gb-green text-[10px] font-bold tracking-wider px-2 py-1 rounded uppercase whitespace-nowrap">✓ Class booked</span>`
              : ''
          }
        </div>
        ${statusBadge(t)}
      `;
      card.appendChild(header);

      const actions = document.createElement('div');

      if (t.status === 'pending' || t.status === 'enrolled') {
        // Note-only cards: bottom-align the note (mt-auto) so it lines up
        // across cards in a row regardless of how far the header wraps.
        actions.className = 'mt-auto pt-5';
        const note = document.createElement('p');
        note.className = 'text-sm text-gb-text-muted';
        note.textContent = t.status === 'pending'
          ? "We'll see them in class — booking opens once they've attended."
          : 'Enrolled student.';
        actions.appendChild(note);
        card.appendChild(actions);
        return card;
      }

      // Bookable cards: the button sits a fixed gap under the header — no
      // mt-auto, so it never floats away from the card content.
      actions.className = 'mt-5';

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.bookHere = '';
      // Three button modes: cancel (active card), schedule-enrollment
      // (exhausted credits), book (default). All three route through
      // toggleCard — only the label + classes change.
      if (isActive) {
        btn.textContent = 'Cancel';
        btn.className = 'w-full h-12 rounded-full font-bold transition-colors bg-gb-white border-2 border-gb-navy text-gb-navy hover:bg-gb-bg-light';
      } else if (isExhausted) {
        btn.textContent = 'Schedule enrollment class';
        btn.className = 'w-full h-12 rounded-full font-bold transition-colors bg-gb-red text-gb-white hover:bg-gb-red-dark';
      } else {
        btn.textContent = 'Book a class';
        btn.className = 'w-full h-12 rounded-full font-bold transition-colors bg-gb-red text-gb-white hover:bg-gb-red-dark';
      }
      actions.appendChild(btn);

      // "Change class" only makes sense while credits remain — once the
      // trial pass is exhausted the conversion CTA takes priority and we
      // remove the change-class option.
      if (!isExhausted) {
        const changeLink = document.createElement('button');
        changeLink.type = 'button';
        changeLink.dataset.changeClassHere = '';
        changeLink.textContent = 'Change class';
        changeLink.className = 'mt-2 w-full text-sm text-gb-text-muted underline hover:text-gb-navy transition-colors';
        changeLink.addEventListener('click', () => openChangeProgram(t.traineeKey));
        actions.appendChild(changeLink);
      }

      card.appendChild(actions);

      const bookingArea = document.createElement('div');
      bookingArea.dataset.cardBookingArea = '';
      bookingArea.hidden = !isActive;
      bookingArea.className = 'mt-5 pt-5 border-t border-gb-bg-light';
      card.appendChild(bookingArea);

      btn.addEventListener('click', () => toggleCard(t.traineeKey));
      return card;
    }

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    }
    /** "Thu, May 28 · 4:00 PM" in America/Los_Angeles. */
    function formatDateTime(iso: string): string {
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return iso;
      const tz = 'America/Los_Angeles';
      const datePart = new Intl.DateTimeFormat('en-US', {
        timeZone: tz, weekday: 'short', month: 'short', day: 'numeric',
      }).format(d);
      const timePart = new Intl.DateTimeFormat('en-US', {
        timeZone: tz, hour: 'numeric', minute: '2-digit',
      }).format(d);
      return `${datePart} · ${timePart}`;
    }
    function isFuture(iso: string): boolean {
      const d = new Date(iso);
      return !Number.isNaN(d.getTime()) && d.getTime() > Date.now();
    }
    /**
     * The persistent under-the-program-name line for a card:
     *   - future appointment → navy semibold "Next class" / "Trial class" line
     *   - no future appointment → muted "No upcoming class booked" note
     */
    function appointmentLine(t: Trainee): string {
      if (t.nextClassISO && isFuture(t.nextClassISO)) {
        const label = t.status === 'pending' ? 'Trial class' : 'Next class';
        return `<p class="mt-1 text-sm font-semibold text-gb-navy">${label}: ${escapeHtml(formatDateTime(t.nextClassISO))}</p>`;
      }
      return `<p class="mt-1 text-xs text-gb-text-muted">No upcoming class booked</p>`;
    }

    // ─── Card expand/collapse — moves the shared #booking-flow DOM ──────
    function toggleCard(traineeKey: string) {
      if (state.activeTraineeKey === traineeKey) {
        collapseActive();
        return;
      }
      collapseAll();

      const t = state.trainees.find((x) => x.traineeKey === traineeKey);
      if (!t || !bookingFlow) return;

      const card = traineeList?.querySelector<HTMLElement>(`[data-trainee-key="${cssEscape(traineeKey)}"]`);
      const area = card?.querySelector<HTMLElement>('[data-card-booking-area]');
      if (!card || !area) return;

      area.appendChild(bookingFlow);
      area.hidden = false;
      // Drop any prior border/bg colors (default OR exhausted) before applying
      // active styling. classList.remove ignores classes that aren't present.
      card.classList.remove('border-gb-bg-light', 'border-gb-red', 'bg-gb-red/5', 'bg-gb-white');
      card.classList.add('bg-gb-white', 'border-gb-gold', ...ACTIVE_SPAN_CLASSES);

      const btn = card.querySelector<HTMLButtonElement>('[data-book-here]');
      if (btn) {
        btn.textContent = 'Cancel';
        btn.className = 'w-full h-12 rounded-full font-bold transition-colors bg-gb-white border-2 border-gb-navy text-gb-navy hover:bg-gb-bg-light';
      }

      state.activeTraineeKey = traineeKey;
      state.program = (t.program as ProgramKey) || 'adults';
      state.programName = PROGRAM_NAME[state.program] ?? state.program;
      state.selectedDate = null;
      state.selectedSlot = null;
      state.slots = [];
      state.slotsByDate = {};
      state.loadedMonths = new Set<string>();
      const today = todayInTZ();
      state.viewYear = today.year;
      state.viewMonth = today.month;
      state.cardStep = 'date';

      renderBookingFlow();
      void loadMonth(state.program, state.viewYear, state.viewMonth);

      card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /** Tear down whichever panel is currently open — active trainee card OR the add-person panel. */
    function collapseAll() {
      if (state.addPerson.open) closeAddPerson();
      else collapseActive();
    }

    function collapseActive() {
      if (!state.activeTraineeKey) return;

      const card = traineeList?.querySelector<HTMLElement>(`[data-trainee-key="${cssEscape(state.activeTraineeKey)}"]`);
      const area = card?.querySelector<HTMLElement>('[data-card-booking-area]');
      const btn = card?.querySelector<HTMLButtonElement>('[data-book-here]');
      if (area && bookingFlow && bookingFlowParking) {
        // Move bookingFlow back to its parking spot (no-op if it wasn't in
        // this area — e.g. when collapsing the change-program picker).
        bookingFlowParking.appendChild(bookingFlow);
        // Wipe any inline content (change-program picker writes into this
        // area directly; bookingFlow has already been moved out, so this
        // only clears leftover picker HTML).
        area.innerHTML = '';
        area.hidden = true;
      }
      const t = state.trainees.find((x) => x.traineeKey === state.activeTraineeKey);
      const isExhausted = t ? t.status === 'exhausted' : false;
      if (card) {
        card.classList.remove('border-gb-gold', 'border-gb-bg-light', 'border-gb-red', 'bg-gb-red/5', 'bg-gb-white', ...ACTIVE_SPAN_CLASSES);
        if (isExhausted) {
          card.classList.add('bg-gb-red/5', 'border-gb-red');
        } else {
          card.classList.add('bg-gb-white', 'border-gb-bg-light');
        }
      }
      if (btn && t) {
        btn.disabled = false;
        if (isExhausted) {
          btn.textContent = 'Schedule enrollment class';
          btn.className = 'w-full h-12 rounded-full font-bold transition-colors bg-gb-red text-gb-white hover:bg-gb-red-dark';
        } else {
          btn.textContent = 'Book a class';
          btn.className = 'w-full h-12 rounded-full font-bold transition-colors bg-gb-red text-gb-white hover:bg-gb-red-dark';
        }
      }

      state.activeTraineeKey = null;
      state.cardStep = 'idle';
    }

    // ─── Change-class flow ────────────────────────────────────────────────
    // Renders a program-picker directly into the card's booking area (not the
    // shared #booking-flow DOM, which is reserved for date/slot/confirm).
    // On submit: POST /api/rebook-change-program, then transition the same
    // card into the booking flow with the new program.
    function openChangeProgram(traineeKey: string) {
      if (state.activeTraineeKey === traineeKey && state.cardStep === 'change-program') {
        collapseActive();
        return;
      }
      collapseAll();

      const t = state.trainees.find((x) => x.traineeKey === traineeKey);
      if (!t) return;

      const card = traineeList?.querySelector<HTMLElement>(`[data-trainee-key="${cssEscape(traineeKey)}"]`);
      const area = card?.querySelector<HTMLElement>('[data-card-booking-area]');
      if (!card || !area) return;

      area.hidden = false;
      card.classList.add('border-gb-gold', ...ACTIVE_SPAN_CLASSES);
      card.classList.remove('border-gb-bg-light');

      const btn = card.querySelector<HTMLButtonElement>('[data-book-here]');
      if (btn) {
        btn.textContent = 'Cancel';
        btn.className = 'w-full h-12 rounded-full font-bold transition-colors bg-gb-white border-2 border-gb-navy text-gb-navy hover:bg-gb-bg-light';
      }

      state.activeTraineeKey = traineeKey;
      state.cardStep = 'change-program';

      renderChangeProgramPicker(area, t);
      card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    const AGE_TO_PROGRAM: Array<{ age: number; program: ProgramKey }> = [
      { age: 3, program: 'tiny' }, { age: 5, program: 'lc1' }, { age: 7, program: 'lc2' },
      { age: 10, program: 'juniors' }, { age: 16, program: 'adults' },
    ];

    function openAddPerson() {
      if (state.addPerson.open) { closeAddPerson(); return; }
      collapseActive();
      state.addPerson = { open: true, step: 'details', firstName: '', age: 0 };
      const tile = traineeList?.querySelector<HTMLElement>('[data-add-person-tile]');
      const openBtn = tile?.querySelector<HTMLButtonElement>('[data-add-person-open]');
      const area = tile?.querySelector<HTMLElement>('[data-add-person-area]');
      if (!tile || !area || !openBtn) return;
      tile.classList.add('border-gb-gold', ...ACTIVE_SPAN_CLASSES);
      tile.classList.remove('border-dashed', 'border-gb-text-muted');
      openBtn.hidden = true;
      area.hidden = false;
      renderAddPersonDetails(area);
      tile.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function closeAddPerson() {
      state.addPerson.open = false;
      if (bookingFlow && bookingFlowParking) bookingFlowParking.appendChild(bookingFlow);
      renderCards();
    }

    function renderAddPersonDetails(area: HTMLElement) {
      area.innerHTML = `
        <h4 class="text-base md:text-lg font-bold text-gb-navy mb-1">Add a new person</h4>
        <p class="text-sm text-gb-text-muted mb-4">Enter the new student's name and age. We'll use the account details we already have.</p>
        <div class="space-y-3">
          <label class="block">
            <span class="text-sm font-medium text-gb-text">Student first name</span>
            <input data-ap-first type="text" maxlength="50"
              class="mt-1 w-full h-12 px-4 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gb-red focus:border-gb-red" />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-gb-text">Student age</span>
            <select data-ap-age
              class="mt-1 w-full h-12 px-4 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gb-red focus:border-gb-red bg-white">
              <option value="">Select age range</option>
              <option value="3">Ages 3–4</option>
              <option value="5">Ages 5–6</option>
              <option value="7">Ages 7–9</option>
              <option value="10">Ages 10–15</option>
              <option value="16">Ages 16+</option>
            </select>
          </label>
        </div>
        <p data-ap-error class="hidden mt-3 text-sm text-gb-red" role="alert"></p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
          <button type="button" data-ap-cancel
            class="h-12 rounded-full bg-gb-white border-2 border-gb-navy text-gb-navy font-bold hover:bg-gb-bg-light transition-colors">Cancel</button>
          <button type="button" data-ap-continue
            class="h-12 rounded-full bg-gb-red text-gb-white font-bold hover:bg-gb-red-dark transition-colors">Continue</button>
        </div>
      `;
      const firstEl = area.querySelector<HTMLInputElement>('[data-ap-first]');
      const ageEl = area.querySelector<HTMLSelectElement>('[data-ap-age]');
      const errEl = area.querySelector<HTMLElement>('[data-ap-error]');
      area.querySelector('[data-ap-cancel]')?.addEventListener('click', () => closeAddPerson());
      area.querySelector('[data-ap-continue]')?.addEventListener('click', () => {
        const firstName = (firstEl?.value ?? '').trim();
        const age = Number(ageEl?.value ?? '');
        if (!firstName || !age) {
          if (errEl) { errEl.textContent = 'Please enter a name and pick an age range.'; errEl.classList.remove('hidden'); }
          return;
        }
        state.addPerson.firstName = firstName;
        state.addPerson.age = age;
        startAddPersonBooking();
      });
    }

    function addPersonProgram(): ProgramKey {
      const sorted = [...AGE_TO_PROGRAM].sort((a, b) => b.age - a.age);
      return (sorted.find((m) => state.addPerson.age >= m.age)?.program) ?? 'adults';
    }

    function startAddPersonBooking() {
      const tile = traineeList?.querySelector<HTMLElement>('[data-add-person-tile]');
      const area = tile?.querySelector<HTMLElement>('[data-add-person-area]');
      if (!tile || !area || !bookingFlow) return;
      area.innerHTML = '';
      area.appendChild(bookingFlow);

      state.activeTraineeKey = null;
      state.program = addPersonProgram();
      state.programName = PROGRAM_NAME[state.program] ?? state.program;
      state.selectedDate = null;
      state.selectedSlot = null;
      state.slots = [];
      state.slotsByDate = {};
      state.loadedMonths = new Set<string>();
      const today = todayInTZ();
      state.viewYear = today.year;
      state.viewMonth = today.month;
      state.cardStep = 'date';
      state.addPerson.step = 'date';

      renderBookingFlow();
      void loadMonth(state.program, state.viewYear, state.viewMonth);
    }

    function renderChangeProgramPicker(area: HTMLElement, t: Trainee) {
      const currentKey = (t.program as ProgramKey);
      area.innerHTML = `
        <h4 class="text-base md:text-lg font-bold text-gb-navy mb-1">Switch ${escapeHtml(t.traineeName)}'s class</h4>
        <p class="text-sm text-gb-text-muted mb-4">
          Pick the class ${escapeHtml(t.traineeName)} should be in. We'll save the change and show open times for that class.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" data-program-grid></div>
        <p data-change-error class="hidden mt-3 text-sm text-gb-red" role="alert">
          We couldn't update the class right now. Please try again or call us at (562) 640-1400.
        </p>
      `;

      const grid = area.querySelector<HTMLElement>('[data-program-grid]');
      if (!grid) return;

      for (const key of PROGRAM_ORDER) {
        const isCurrent = key === currentKey;
        const optBtn = document.createElement('button');
        optBtn.type = 'button';
        optBtn.dataset.pickProgram = key;
        optBtn.disabled = isCurrent;
        optBtn.className = isCurrent
          ? 'flex items-center justify-between gap-3 text-left p-3 rounded-xl border-2 border-gb-bg-light bg-gb-bg-light/50 cursor-not-allowed'
          : 'flex items-center justify-between gap-3 text-left p-3 rounded-xl border-2 border-gb-bg-light hover:border-gb-navy hover:bg-gb-bg-light transition-colors';
        optBtn.innerHTML = `
          <div class="min-w-0">
            <div class="text-sm font-bold text-gb-navy">${escapeHtml(PROGRAM_NAME[key])}</div>
            <div class="text-xs text-gb-text-muted">${escapeHtml(PROGRAM_AGE[key])}</div>
          </div>
          <span class="text-xs font-semibold ${isCurrent ? 'text-gb-text-muted' : 'text-gb-red'}">${isCurrent ? 'Current' : 'Switch →'}</span>
        `;
        if (!isCurrent) optBtn.addEventListener('click', () => void submitChangeProgram(t, key));
        grid.appendChild(optBtn);
      }
    }

    async function submitChangeProgram(t: Trainee, newProgram: ProgramKey) {
      if (!state.contactId) return;
      const card = traineeList?.querySelector<HTMLElement>(`[data-trainee-key="${cssEscape(t.traineeKey)}"]`);
      const area = card?.querySelector<HTMLElement>('[data-card-booking-area]');
      const errEl = area?.querySelector<HTMLElement>('[data-change-error]');
      const optionBtns = area?.querySelectorAll<HTMLButtonElement>('[data-pick-program]');
      errEl?.classList.add('hidden');
      optionBtns?.forEach((b) => { b.disabled = true; });

      try {
        const res = await fetch('/api/rebook-change-program', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contactId: state.contactId,
            traineeKey: t.traineeKey,
            sessionToken: t.sessionToken,
            program: newProgram,
          }),
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.code ?? 'unknown');

        // Mutate in-memory state, re-render cards, then auto-open the date picker
        // for the new program so the customer can immediately book.
        t.program = newProgram;
        state.activeTraineeKey = null;
        state.cardStep = 'idle';
        renderCards();
        if (t.creditsRemaining > 0) toggleCard(t.traineeKey);
      } catch (err) {
        console.warn('[rebook] change-program failed', err);
        errEl?.classList.remove('hidden');
        optionBtns?.forEach((b) => {
          if (b.dataset.pickProgram !== t.program) b.disabled = false;
        });
      }
    }

    function cssEscape(s: string): string {
      return s.replace(/"/g, '\\"');
    }

    function activeTrainee(): Trainee | null {
      if (!state.activeTraineeKey) return null;
      return state.trainees.find((x) => x.traineeKey === state.activeTraineeKey) ?? null;
    }

    // ─── Booking-flow render — toggles which step is visible ──────────────
    // DatePicker + SlotPicker read `step` from the event detail (matching the
    // /kickstart booking-flow shape). We use `cardStep` to disambiguate from
    // the page's outer `step` (lookup vs dashboard), so we expose cardStep
    // AS `step` in the dispatched detail.
    function renderBookingFlow() {
      if (!bookingFlow) return;
      const stepEls = ['date', 'slot', 'confirm', 'error'] as const;
      for (const s of stepEls) {
        const el = bookingFlow.querySelector<HTMLElement>(`[data-step="${s}"]`);
        if (el) el.hidden = state.cardStep !== s;
      }
      bookingFlow.dispatchEvent(
        new CustomEvent('booking:render', { detail: { ...state, step: state.cardStep } }),
      );
    }

    // ─── Booking-flow events (DatePicker / SlotPicker dispatch these) ────
    if (bookingFlow) {
      bookingFlow.addEventListener('booking:change-month', async (e: Event) => {
        if (!state.program) return;
        const { delta } = (e as CustomEvent).detail as { delta: 1 | -1 };
        const next = addMonths(state.viewYear, state.viewMonth, delta);
        const today = todayInTZ();
        const maxAhead = addMonths(today.year, today.month, 3);
        const beforeToday = next.year < today.year || (next.year === today.year && next.month < today.month);
        const afterMax = next.year > maxAhead.year || (next.year === maxAhead.year && next.month > maxAhead.month);
        if (beforeToday || afterMax) return;
        state.viewYear = next.year;
        state.viewMonth = next.month;
        renderBookingFlow();
        await loadMonth(state.program, next.year, next.month);
      });

      bookingFlow.addEventListener('booking:date-selected', (e: Event) => {
        const date = (e as CustomEvent).detail as string;
        state.selectedDate = date;
        state.selectedSlot = null;
        state.slots = state.slotsByDate[date] ?? [];
        state.slotsLoadedFor = date;
        state.cardStep = 'slot';
        renderBookingFlow();
      });

      bookingFlow.addEventListener('booking:slot-selected', (e: Event) => {
        const slot = (e as CustomEvent).detail as Slot;
        state.selectedSlot = slot;
        const t = activeTrainee();
        const who = t ? t.traineeName : state.addPerson.firstName;
        if (confirmSummary && state.selectedSlot && who) {
          confirmSummary.textContent = `Booking ${state.programName} for ${who} on ${state.selectedSlot.label}.`;
        }
        state.cardStep = 'confirm';
        renderBookingFlow();
      });

      bookingFlow.addEventListener('booking:back-to-date', () => {
        state.selectedSlot = null;
        state.cardStep = 'date';
        renderBookingFlow();
      });

      // Fixed program per card — DatePicker's "← Change program" is a no-op here.
      bookingFlow.addEventListener('booking:book-another', () => {});

      confirmBack?.addEventListener('click', () => {
        state.cardStep = 'slot';
        renderBookingFlow();
      });

      confirmSubmit?.addEventListener('click', async () => {
        if (state.addPerson.open && !state.activeTraineeKey) {
          await submitAddPerson();
        } else {
          await submitBooking();
        }
      });

      errorRetry?.addEventListener('click', () => {
        state.cardStep = 'confirm';
        renderBookingFlow();
      });
    }

    // ─── Lookup form ──────────────────────────────────────────────────────
    lookupFormEl?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (lookupSubmit?.disabled) return;
      lookupError?.classList.add('hidden');

      const data = new FormData(lookupFormEl);
      const email = String(data.get('email') ?? '').trim();
      if (!email) {
        lookupError?.classList.remove('hidden');
        return;
      }
      if (lookupSubmit) {
        lookupSubmit.disabled = true;
        lookupSubmit.textContent = 'Searching…';
      }

      try {
        const res = await fetch('/api/rebook-lookup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const json = await res.json();
        if (!json.ok) {
          lookupError?.classList.remove('hidden');
          return;
        }
        applyLookupContext({ contactId: json.contactId, contactToken: json.contactToken, trainees: json.trainees, autoExpandTraineeKey: null });
      } catch {
        lookupError?.classList.remove('hidden');
      } finally {
        if (lookupSubmit) {
          lookupSubmit.disabled = false;
          lookupSubmit.textContent = 'Find My Classes';
        }
      }
    });

    backToLookupBtn?.addEventListener('click', () => {
      collapseAll();
      if (bookingFlow && bookingFlowParking) bookingFlowParking.appendChild(bookingFlow);
      state.contactId = null;
      state.contactToken = null;
      state.trainees = [];
      state.step = 'lookup';
      renderStep();
    });

    // ─── Magic-link entry path ────────────────────────────────────────────
    async function tryMagicLink(): Promise<boolean> {
      const params = new URLSearchParams(location.search);
      const token = params.get('t');
      if (!token) return false;

      if (lookupLoading) lookupLoading.hidden = false;
      if (lookupForm) lookupForm.hidden = true;
      try {
        const res = await fetch('/api/rebook-context', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token }),
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.code ?? 'unknown');
        applyLookupContext({
          contactId: data.contactId,
          contactToken: data.contactToken,
          trainees: data.trainees,
          autoExpandTraineeKey: data.tokenTraineeKey ?? null,
        });
        return true;
      } catch {
        if (lookupLoading) lookupLoading.hidden = true;
        if (lookupForm) lookupForm.hidden = false;
        return false;
      }
    }

    function applyLookupContext(ctx: { contactId: string; contactToken: string; trainees: Trainee[]; autoExpandTraineeKey: string | null }) {
      state.contactId = ctx.contactId;
      state.contactToken = ctx.contactToken;
      state.trainees = ctx.trainees;
      state.step = 'dashboard';
      renderStep();
      renderCards();
      if (ctx.autoExpandTraineeKey) {
        const found = ctx.trainees.find((x) => x.traineeKey === ctx.autoExpandTraineeKey);
        if (found && found.status === 'active') {
          toggleCard(found.traineeKey);
        }
      }
    }

    // ─── Network: month load, booking submit ──────────────────────────────
    async function loadMonth(program: ProgramKey, year: number, month: number) {
      const monthKey = `${year}-${String(month).padStart(2, '0')}`;
      if (state.loadedMonths.has(monthKey)) return;
      const today = todayInTZ();
      const isCurrentMonth = year === today.year && month === today.month;
      const fromDay = isCurrentMonth ? today.day : 1;
      const lastDay = lastDayOfMonth(year, month);
      const from = `${monthKey}-${String(fromDay).padStart(2, '0')}`;
      const to = `${monthKey}-${String(lastDay).padStart(2, '0')}`;

      state.monthLoading = true;
      renderBookingFlow();
      try {
        const r = await fetch(`/api/availability?program=${program}&from=${from}&to=${to}&t=${Date.now()}`);
        const data = await r.json();
        if (!data.ok) throw new Error(data.code ?? 'unknown');
        if (state.program !== program) return;
        for (const slot of data.slots as Slot[]) {
          const day = slot.startISO.slice(0, 10);
          (state.slotsByDate[day] ??= []).push(slot);
        }
        state.loadedMonths.add(monthKey);
      } catch {
        if (state.program !== program) return;
        state.lastError = "We can't load class times right now.";
        if (errorMessage) errorMessage.textContent = state.lastError;
        state.cardStep = 'error';
      } finally {
        state.monthLoading = false;
        renderBookingFlow();
      }
    }

    async function submitAddPerson() {
      if (state.submitting) return;
      if (!state.contactId || !state.contactToken || !state.selectedSlot) return;
      state.submitting = true;
      if (confirmSubmit) { confirmSubmit.disabled = true; confirmSubmit.textContent = 'Booking…'; }
      confirmError?.classList.add('hidden');

      const slot = state.selectedSlot;
      try {
        const res = await fetch('/api/rebook-add-person', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contactId: state.contactId,
            sessionToken: state.contactToken,
            program: addPersonProgram(),
            trainee: { firstName: state.addPerson.firstName, age: state.addPerson.age },
            slotStartISO: slot.startISO,
            ts: state.pageRenderTs,
            website: '',
          }),
        });
        const data = await res.json();
        if (!data.ok) {
          const code = data.code ?? 'unknown';
          if (code === 'SLOT_TAKEN' && confirmError) {
            confirmError.textContent = 'That slot just filled up — please pick another time.';
          } else if (confirmError) {
            // Restore the default message in case a previous SLOT_TAKEN customized it.
            confirmError.textContent = 'Something went wrong booking. Please try again or call us at (562) 640-1400.';
          }
          throw new Error(code);
        }

        const newTrainee: Trainee = {
          traineeName: data.trainee.traineeName,
          traineeKey: data.trainee.traineeKey,
          program: data.trainee.program,
          status: 'pending',
          creditsRemaining: 0,
          lastAttendanceISO: null,
          nextClassISO: data.trainee.nextClassISO,
        };
        // The new card renders at the top of the grid already carrying the
        // "Trial booked" badge + "Trial class: <date>" line — that is the
        // confirmation, so no separate success banner is needed here.
        state.trainees.unshift(newTrainee);
        if (bookingFlow && bookingFlowParking) bookingFlowParking.appendChild(bookingFlow);
        state.addPerson.open = false;
        renderCards();
      } catch (err) {
        console.warn('[rebook] add-person failed', err);
        confirmError?.classList.remove('hidden');
      } finally {
        state.submitting = false;
        if (confirmSubmit) { confirmSubmit.disabled = false; confirmSubmit.textContent = 'Confirm Booking'; }
      }
    }

    async function submitBooking() {
      if (state.submitting) return;
      const t = activeTrainee();
      if (!state.program || !state.selectedSlot || !state.contactId || !t) return;
      state.submitting = true;
      if (confirmSubmit) {
        confirmSubmit.disabled = true;
        confirmSubmit.textContent = 'Booking…';
      }
      confirmError?.classList.add('hidden');

      const slotForSuccess = state.selectedSlot;
      try {
        const res = await fetch('/api/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            program: state.program,
            slotStartISO: state.selectedSlot.startISO,
            rebook: {
              contactId: state.contactId,
              traineeKey: t.traineeKey,
              sessionToken: t.sessionToken,
            },
            parent: { firstName: t.traineeName, lastName: '', email: '', phone: '' },
            trainee: { firstName: t.traineeName, age: 30, isSelf: state.program === 'adults' },
            marketingConsent: false,
            website: '',
            ts: state.pageRenderTs,
          }),
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.code ?? 'unknown');

        // Update in-memory trainee credits + next-class, flag the booking
        // so the re-rendered card shows the "Class booked" confirmation badge.
        t.creditsRemaining = Math.max(0, t.creditsRemaining - 1);
        t.nextClassISO = slotForSuccess.startISO;
        t.justBooked = true;
        collapseActive();
        renderCards();
      } catch (err) {
        confirmError?.classList.remove('hidden');
        console.warn('[rebook] /api/book failed', err);
      } finally {
        state.submitting = false;
        if (confirmSubmit) {
          confirmSubmit.disabled = false;
          confirmSubmit.textContent = 'Confirm Booking';
        }
      }
    }

    // ─── Helpers ──────────────────────────────────────────────────────────
    function todayInTZ(): { year: number; month: number; day: number } {
      const fmt = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Los_Angeles',
        year: 'numeric', month: '2-digit', day: '2-digit',
      });
      const iso = fmt.format(new Date());
      const parts = iso.split('-').map(Number);
      return { year: parts[0]!, month: parts[1]!, day: parts[2]! };
    }
    function addMonths(year: number, month: number, delta: number): { year: number; month: number } {
      const total = year * 12 + (month - 1) + delta;
      return { year: Math.floor(total / 12), month: (total % 12) + 1 };
    }
    function lastDayOfMonth(year: number, month: number): number {
      return new Date(Date.UTC(year, month, 0)).getUTCDate();
    }

    // ─── Boot ─────────────────────────────────────────────────────────────
    renderStep();
    void tryMagicLink();
  }
</script>
