---
/**
 * /offer — generic in-studio QR landing page.
 *
 * Reached by scanning a QR code posted inside the academy. Visitors are
 * already standing in the studio, so there is NO nav, footer, schedule, or
 * marketing content — just the offer and the opt-in form.
 *
 * FunnelLayout: NO nav, NO footer, NO AI chat, NO sticky CTA, always
 * noindex,nofollow (this page should never rank or be linked publicly).
 *
 * OptInForm posts to /api/lead (source: qr-offer-optin) and on success
 * redirects to /kickstart to book the first class.
 */
import FunnelLayout from '../layouts/FunnelLayout.astro';
import OptInForm from '../components/form/OptInForm.astro';
---

<FunnelLayout
  title="Start Your Free 3-Class Pass"
  description="Claim your Free 3-Class Pass at Gracie Barra Whittier. No risk, no contracts, free uniform rental included."
>
  <div class="bg-gb-bg-light min-h-full">
    {/* Intro — short, since the visitor is already inside the academy */}
    <section class="max-w-2xl mx-auto px-4 md:px-6 pt-10 md:pt-14 text-center">
      <img
        src="/logo/gb-whittier-logo.webp"
        alt="Gracie Barra Whittier"
        class="w-16 h-16 md:w-20 md:h-20 mx-auto"
        width="80"
        height="80"
      />
      <h1 class="mt-4 text-2xl sm:text-3xl md:text-4xl font-extrabold uppercase tracking-tight text-gb-navy leading-tight">
        Start Your Free 3-Class Pass
      </h1>
      <p class="mt-3 text-sm md:text-base text-gb-text-muted leading-relaxed">
        Enter your info below to claim your pass and book your first class. Takes
        30 seconds &mdash; no payment required.
      </p>
    </section>

    {/* Opt-in form — navy variant: self-contained card with offer badge */}
    <OptInForm
      id="trial"
      variant="navy"
      source="qr-offer-optin"
      header="UNLOCK YOUR FREE 3-CLASS PASS"
      offerLabel="FREE 3-CLASS PASS"
      riskLine="No Risk. No Pressure. Free Uniform Rental Included."
      submitLabel="Claim My Free 3-Class Pass"
    />
  </div>
</FunnelLayout>
