---
/**
 * /blog — public blog index. Lists PUBLISHED posts from GHL Blogs as a card grid.
 * SSR (default output: 'server') so the list reflects the latest published posts;
 * lib/ghl-blog caches ~5 min and degrades to [] on failure → friendly empty state.
 *
 * Supports ?sort=oldest and ?page=N (9 posts per page). Sorting + slicing live in
 * lib/blog-pagination (pure, unit-tested); this page only wires params → markup.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import CTAButton from '../../components/cta/CTAButton.astro';
import { listAllPublishedPosts } from '../../lib/ghl-blog';
import { parseBlogListParams, paginatePosts, type BlogSort } from '../../lib/blog-pagination';

const site = 'https://www.graciebarrawhittier.com';

const { sort, page: rawPage } = parseBlogListParams(Astro.url.searchParams);
const all = await listAllPublishedPosts();
const { pagePosts, page, totalPages } = paginatePosts(all, { sort, page: rawPage });

/** Canonical /blog/ URL for a sort+page state; omits defaults for clean URLs. */
function blogUrl(s: BlogSort, n: number): string {
  const params = new URLSearchParams();
  if (s === 'oldest') params.set('sort', s);
  if (n > 1) params.set('page', String(n));
  const qs = params.toString();
  return qs ? `/blog/?${qs}` : '/blog/';
}

/**
 * Page-number items for the pagination nav. Up to 7 plain numbers; beyond that,
 * the standard window pattern: 1 … (page−1, page, page+1) … last.
 */
function pageItems(current: number, total: number): (number | '…')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const items: (number | '…')[] = [1];
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);
  if (start > 2) items.push('…');
  for (let i = start; i <= end; i++) items.push(i);
  if (end < total - 1) items.push('…');
  items.push(total);
  return items;
}

// Default view (newest, page 1) keeps the clean /blog/ canonical; other states
// self-canonicalize so paginated/sorted pages don't all claim to be /blog/.
const canonical = `${site}${blogUrl(sort, page)}`;
---

<BaseLayout
  title="Blog | Gracie Barra Whittier"
  description="Brazilian Jiu-Jitsu tips, academy news, and student stories from Gracie Barra Whittier — your BJJ academy in Whittier, CA."
  canonical={canonical}
>
  <div class="bg-gb-bg-light">
    <section class="px-4 md:px-6 pt-12 md:pt-16 pb-4 md:pb-6">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="text-3xl md:text-5xl font-extrabold text-gb-red leading-tight">
          Gracie Barra Whittier Blog
        </h1>
        <p class="mt-4 text-sm md:text-base text-gb-text-muted max-w-2xl mx-auto leading-relaxed">
          Jiu-Jitsu tips, academy news, and stories from the mats — straight from our Whittier community.
        </p>
      </div>
    </section>

    <section class="px-4 md:px-6 pt-4 md:pt-6 pb-12 md:pb-16">
      <div class="max-w-6xl mx-auto">
        {
          all.length > 1 && (
            <form
              method="get"
              action="/blog/"
              data-blog-sort-form
              class="flex items-center justify-end gap-2 mb-5 md:mb-6"
            >
              <label for="blog-sort" class="text-sm font-medium text-gb-text">
                Sort by
              </label>
              <select
                id="blog-sort"
                name="sort"
                class="h-12 px-4 pr-8 rounded-lg border border-gray-300 bg-white text-sm text-gb-text focus:ring-2 focus:ring-gb-red focus:border-gb-red"
              >
                <option value="newest" selected={sort === 'newest'}>Newest first</option>
                <option value="oldest" selected={sort === 'oldest'}>Oldest first</option>
              </select>
              <button
                type="submit"
                data-sort-apply
                class="h-12 px-5 rounded-lg border border-gb-navy bg-white text-sm font-semibold text-gb-navy hover:bg-gb-navy hover:text-white transition-colors"
              >
                Apply
              </button>
            </form>
          )
        }
        {
          pagePosts.length > 0 ? (
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
              {pagePosts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
          ) : (
            <div class="max-w-xl mx-auto bg-gb-white rounded-2xl shadow-sm p-8 md:p-10 text-center">
              <h2 class="text-2xl font-extrabold text-gb-navy">No posts yet</h2>
              <p class="mt-3 text-sm md:text-base text-gb-text-muted leading-relaxed">
                We're working on new articles. In the meantime, come train with us — your first
                three classes are on the house.
              </p>
              <div class="mt-6 flex justify-center">
                <CTAButton variant="primary" label="Claim My Free 3-Class Pass" href="/#trial" />
              </div>
            </div>
          )
        }
        {
          totalPages > 1 && (
            <nav aria-label="Blog pages" class="mt-10 md:mt-12 flex justify-center">
              <ul class="flex flex-wrap items-center justify-center gap-2">
                {page > 1 && (
                  <li>
                    <a
                      href={blogUrl(sort, page - 1)}
                      rel="prev"
                      class="inline-flex items-center justify-center h-10 px-4 rounded-full border border-gb-navy bg-white text-sm font-semibold text-gb-navy hover:bg-gb-navy hover:text-white transition-colors"
                    >
                      &lsaquo; Prev
                    </a>
                  </li>
                )}
                {pageItems(page, totalPages).map((item) =>
                  item === '…' ? (
                    <li aria-hidden="true" class="px-1 text-sm text-gb-text-muted select-none">
                      &hellip;
                    </li>
                  ) : item === page ? (
                    <li>
                      <span
                        aria-current="page"
                        class="inline-flex items-center justify-center h-10 min-w-10 px-3 rounded-full bg-gb-navy text-sm font-semibold text-white"
                      >
                        {item}
                      </span>
                    </li>
                  ) : (
                    <li>
                      <a
                        href={blogUrl(sort, item)}
                        aria-label={`Page ${item}`}
                        class="inline-flex items-center justify-center h-10 min-w-10 px-3 rounded-full border border-gb-navy bg-white text-sm font-semibold text-gb-navy hover:bg-gb-navy hover:text-white transition-colors"
                      >
                        {item}
                      </a>
                    </li>
                  )
                )}
                {page < totalPages && (
                  <li>
                    <a
                      href={blogUrl(sort, page + 1)}
                      rel="next"
                      class="inline-flex items-center justify-center h-10 px-4 rounded-full border border-gb-navy bg-white text-sm font-semibold text-gb-navy hover:bg-gb-navy hover:text-white transition-colors"
                    >
                      Next &rsaquo;
                    </a>
                  </li>
                )}
              </ul>
            </nav>
          )
        }
      </div>
    </section>
  </div>

  <SchemaBreadcrumb
    items={[
      { name: 'Home', url: `${site}/` },
      { name: 'Blog', url: `${site}/blog/` },
    ]}
  />

  <script is:inline>
    // Progressive enhancement: with JS, the sort select submits on change and the
    // Apply button is hidden. Without JS, the visible Apply button submits the form.
    (function () {
      var form = document.querySelector('[data-blog-sort-form]');
      if (!form) return;
      var apply = form.querySelector('[data-sort-apply]');
      if (apply) apply.classList.add('hidden');
      var select = form.querySelector('select[name="sort"]');
      if (select) {
        select.addEventListener('change', function () {
          form.submit();
        });
      }
    })();
  </script>
</BaseLayout>
