---
/**
 * /blog — public blog index. Lists PUBLISHED posts from GHL Blogs as a card grid.
 * SSR (default output: 'server') so the list reflects the latest published posts;
 * lib/ghl-blog caches ~5 min and degrades to [] on failure → friendly empty state.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import CTAButton from '../../components/cta/CTAButton.astro';
import { listPublishedPosts } from '../../lib/ghl-blog';

const site = 'https://www.graciebarrawhittier.com';
const posts = await listPublishedPosts();
---

<BaseLayout
  title="Blog | Gracie Barra Whittier"
  description="Brazilian Jiu-Jitsu tips, academy news, and student stories from Gracie Barra Whittier — your BJJ academy in Whittier, CA."
  canonical={`${site}/blog/`}
>
  <div class="bg-gb-bg-light">
    <section class="px-4 md:px-6 pt-12 md:pt-16 pb-4 md:pb-6">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="text-3xl md:text-5xl font-extrabold text-gb-red leading-tight">
          Gracie Barra Whittier Blog
        </h1>
        <p class="mt-4 text-sm md:text-base text-gb-text-muted max-w-2xl mx-auto leading-relaxed">
          Jiu-Jitsu tips, academy news, and stories from the mats — straight from our Whittier community.
        </p>
      </div>
    </section>

    <section class="px-4 md:px-6 pt-4 md:pt-6 pb-12 md:pb-16">
      <div class="max-w-6xl mx-auto">
        {
          posts.length > 0 ? (
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
              {posts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
          ) : (
            <div class="max-w-xl mx-auto bg-gb-white rounded-2xl shadow-sm p-8 md:p-10 text-center">
              <h2 class="text-2xl font-extrabold text-gb-navy">No posts yet</h2>
              <p class="mt-3 text-sm md:text-base text-gb-text-muted leading-relaxed">
                We're working on new articles. In the meantime, come train with us — your first
                three classes are on the house.
              </p>
              <div class="mt-6 flex justify-center">
                <CTAButton variant="primary" label="Claim My Free 3-Class Pass" href="/#trial" />
              </div>
            </div>
          )
        }
      </div>
    </section>
  </div>

  <SchemaBreadcrumb
    items={[
      { name: 'Home', url: `${site}/` },
      { name: 'Blog', url: `${site}/blog/` },
    ]}
  />
</BaseLayout>
