---
/**
 * /blog/[slug] — single public blog post (SSR).
 * Fetches the PUBLISHED post by slug from GHL Blogs; 404s via Astro.redirect('/404')
 * when not found (matches the repo's prerendered 404.astro). Renders the post's
 * rawHTML inside a BRANDED prose wrapper (navy headings, gb-red links, constrained
 * reading width, responsive images), then funnels traffic with a TrustStrip + CTA.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustStrip from '../../components/cta/TrustStrip.astro';
import CTAButton from '../../components/cta/CTAButton.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import { getPostBySlug } from '../../lib/ghl-blog';

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;

if (!post) {
  return Astro.redirect('/404');
}

const site = 'https://www.graciebarrawhittier.com';
const canonical = `${site}/blog/${post.slug}/`;

function formatDate(iso: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
const publishedLabel = formatDate(post.publishedAt);

// JSON-LD Article schema, passed to BaseLayout's `schema` prop.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  ...(post.imageUrl ? { image: post.imageUrl } : {}),
  ...(post.publishedAt ? { datePublished: post.publishedAt } : {}),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@type': 'Organization', name: 'Gracie Barra Whittier' },
  publisher: {
    '@type': 'Organization',
    name: 'Gracie Barra Whittier',
    logo: { '@type': 'ImageObject', url: `${site}/logo/gb-whittier-logo.webp` },
  },
};
---

<BaseLayout
  title={`${post.title} | Gracie Barra Whittier`}
  description={post.description}
  canonical={canonical}
  ogImage={post.imageUrl || undefined}
  ogImageAlt={post.imageAltText || post.title}
  schema={articleSchema}
>
  <div class="bg-gb-bg-light">
    <article class="px-4 md:px-6 pt-12 md:pt-16 pb-6 md:pb-8">
      <div class="max-w-3xl mx-auto bg-gb-white rounded-2xl shadow-sm p-6 md:p-10">
        <header class="text-center">
          {
            publishedLabel && (
              <p class="text-xs font-semibold uppercase tracking-wide text-gb-text-muted">
                {publishedLabel}
              </p>
            )
          }
          <h1 class="mt-2 text-3xl md:text-5xl font-extrabold text-gb-navy leading-tight">
            {post.title}
          </h1>
        </header>

        {
          post.imageUrl && (
            <img
              src={post.imageUrl}
              alt={post.imageAltText || post.title}
              class="mt-8 w-full rounded-2xl shadow-sm object-cover"
              loading="eager"
              decoding="async"
            />
          )
        }

        <div class="gb-prose mt-8 md:mt-10" set:html={post.rawHTML} />
      </div>
    </article>

    {/* Conversion furniture — funnel blog traffic to the free trial. */}
    <section class="px-4 md:px-6 pb-12 md:pb-16">
      <div class="max-w-3xl mx-auto bg-gb-white rounded-2xl shadow-sm p-6 md:p-8 text-center">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gb-navy">
          Ready to step on the mat?
        </h2>
        <p class="mt-3 text-sm md:text-base text-gb-text-muted max-w-xl mx-auto leading-relaxed">
          Start your Brazilian Jiu-Jitsu journey at Gracie Barra Whittier with a free 3-class pass.
        </p>
        <div class="mt-6 flex justify-center">
          <CTAButton variant="primary" label="Claim My Free 3-Class Pass" href="/#trial" />
        </div>
        <TrustStrip class="mt-6" />
      </div>
    </section>
  </div>

  <SchemaBreadcrumb
    items={[
      { name: 'Home', url: `${site}/` },
      { name: 'Blog', url: `${site}/blog/` },
      { name: post.title, url: canonical },
    ]}
  />
</BaseLayout>

<style>
  /* Branded prose wrapper for GHL rawHTML. Constrained by max-w-3xl on the parent;
   * tokens only (gb-navy headings, gb-red links, Inter via inherited html font). */
  .gb-prose {
    color: var(--gb-text);
    font-size: 1rem;
    line-height: 1.75;
  }
  .gb-prose > :first-child {
    margin-top: 0;
  }
  .gb-prose h1,
  .gb-prose h2,
  .gb-prose h3,
  .gb-prose h4 {
    color: var(--gb-navy);
    font-weight: 800;
    line-height: 1.2;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .gb-prose h1 {
    font-size: 1.875rem;
  }
  .gb-prose h2 {
    font-size: 1.5rem;
  }
  .gb-prose h3 {
    font-size: 1.25rem;
  }
  .gb-prose h4 {
    font-size: 1.125rem;
  }
  .gb-prose p,
  .gb-prose > div,
  .gb-prose ul,
  .gb-prose ol,
  .gb-prose blockquote,
  .gb-prose figure,
  .gb-prose table {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .gb-prose a {
    color: var(--gb-red);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .gb-prose a:hover {
    color: var(--gb-red-dark);
  }
  .gb-prose strong {
    color: var(--gb-text);
    font-weight: 700;
  }
  .gb-prose ul,
  .gb-prose ol {
    padding-left: 1.5rem;
  }
  .gb-prose ul {
    list-style: disc;
  }
  .gb-prose ol {
    list-style: decimal;
  }
  .gb-prose li {
    margin-top: 0.375rem;
    margin-bottom: 0.375rem;
  }
  .gb-prose img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }
  .gb-prose blockquote {
    border-left: 4px solid var(--gb-gold);
    padding-left: 1rem;
    color: var(--gb-text-muted);
    font-style: italic;
  }
  .gb-prose figure img {
    margin-bottom: 0.5rem;
  }
  .gb-prose figcaption {
    font-size: 0.875rem;
    color: var(--gb-text-muted);
    text-align: center;
  }
  .gb-prose hr {
    border: 0;
    border-top: 1px solid var(--gb-bg-light);
    margin: 2rem 0;
  }
  /* Video embeds (YouTube/Vimeo iframes from the admin editor). */
  .gb-prose iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    border-radius: 0.75rem;
    margin: 1.5rem 0;
  }
</style>
