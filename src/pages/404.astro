---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/cta/CTAButton.astro';
---

<BaseLayout
  title="Page Not Found | Gracie Barra Whittier"
  description="The page you are looking for cannot be found. Return to Gracie Barra Whittier home."
>
  <section class="max-w-3xl mx-auto px-4 md:px-6 py-20 text-center">
    <p class="text-sm font-semibold text-gb-red tracking-wider">404</p>
    <h1 class="mt-2 text-3xl md:text-5xl font-bold text-gb-navy">
      Page Not Found
    </h1>
    <p class="mt-4 text-gb-text-muted">
      The page you're looking for doesn't exist. Let's get you back on track.
    </p>
    <div class="mt-8 flex justify-center">
      <CTAButton variant="secondary" label="Return Home" href="/" />
    </div>
  </section>
</BaseLayout>
