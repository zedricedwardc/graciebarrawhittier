---
export const prerender = true;
/**
 * /congrats — post-booking confirmation page.
 * FunnelLayout: NO nav, NO footer, NO AI chat.
 * No links out except phone, email, map directions, and a small
 * "back to home" escape hatch in the footer of the page.
 */
import FunnelLayout from '../layouts/FunnelLayout.astro';
import TrustStrip from '../components/cta/TrustStrip.astro';
import { nap } from '../content/nap.ts';

const mapsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  nap.address,
)}`;
---

<FunnelLayout
  title="Booking Confirmed — Gracie Barra Whittier"
  description="Your first class is booked at Gracie Barra Whittier. Here's what to do next before you arrive."
>
  <!-- Confirmation header -->
  <section class="max-w-3xl mx-auto px-4 md:px-6 pt-12 md:pt-20 pb-8 text-center">
    <div
      class="w-16 h-16 mx-auto mb-6 rounded-full bg-gb-red text-white flex items-center justify-center"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <h1 class="text-3xl md:text-5xl font-extrabold text-gb-navy leading-tight">
      Booking Confirmed &mdash; See You On The Mat!
    </h1>
    <p class="mt-5 text-base md:text-lg text-gb-text-muted max-w-2xl mx-auto">
      Your first class is booked. We've sent the details to your email. Here's
      what to do next:
    </p>
  </section>

  <!-- 3-step list -->
  <section class="max-w-3xl mx-auto px-4 md:px-6 pb-10">
    <ol class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
      <li class="bg-gb-bg-light rounded-2xl p-6 text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-gb-red text-white font-bold text-lg flex items-center justify-center">
          1
        </div>
        <h2 class="font-semibold text-gb-navy mb-2 text-lg">Arrive 10 minutes early</h2>
        <p class="text-gb-text-muted text-sm">
          Gives us time to greet you, hand out your uniform, and get you settled
          before class begins.
        </p>
      </li>
      <li class="bg-gb-bg-light rounded-2xl p-6 text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-gb-red text-white font-bold text-lg flex items-center justify-center">
          2
        </div>
        <h2 class="font-semibold text-gb-navy mb-2 text-lg">Wear comfortable workout clothes</h2>
        <p class="text-gb-text-muted text-sm">
          We provide the uniform for your trial classes &mdash; just bring
          yourself.
        </p>
      </li>
      <li class="bg-gb-bg-light rounded-2xl p-6 text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-gb-red text-white font-bold text-lg flex items-center justify-center">
          3
        </div>
        <h2 class="font-semibold text-gb-navy mb-2 text-lg">Meet our instructors and Alex</h2>
        <p class="text-gb-text-muted text-sm">
          You'll meet Professor Phil, Professor Eric, and our Program Director
          Alex on day one.
        </p>
      </li>
    </ol>
  </section>

  <!-- Studio info block -->
  <section class="max-w-3xl mx-auto px-4 md:px-6 pb-10">
    <div class="bg-gb-navy text-white rounded-2xl p-6 md:p-8">
      <h2 class="text-xl md:text-2xl font-bold mb-4">{nap.name}</h2>
      <dl class="space-y-3 text-base">
        <div class="flex flex-col sm:flex-row sm:gap-3">
          <dt class="font-semibold text-gb-white/70 sm:w-24 shrink-0">Address</dt>
          <dd>
            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-gb-white/40 underline-offset-4 hover:text-gb-white"
            >
              {nap.address}
            </a>
          </dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-3">
          <dt class="font-semibold text-gb-white/70 sm:w-24 shrink-0">Phone</dt>
          <dd>
            <a
              href={`tel:${nap.phoneTel}`}
              class="underline decoration-gb-white/40 underline-offset-4 hover:text-gb-white"
            >
              {nap.phone}
            </a>
          </dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-3">
          <dt class="font-semibold text-gb-white/70 sm:w-24 shrink-0">Email</dt>
          <dd>
            <a
              href={`mailto:${nap.email}`}
              class="underline decoration-gb-white/40 underline-offset-4 hover:text-gb-white"
            >
              {nap.email}
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="py-8 md:py-10 px-4">
    <TrustStrip
      items={[
        'Free uniform rental included',
        'No contracts',
        'No pressure',
        'World-class Gracie Barra curriculum',
      ]}
    />
  </section>

  <!-- Optional escape hatch -->
  <section class="text-center pb-12">
    <a
      href="/"
      class="inline-block text-sm text-gb-text-muted hover:text-gb-navy underline underline-offset-4"
    >
      &larr; Back to home
    </a>
  </section>
</FunnelLayout>
