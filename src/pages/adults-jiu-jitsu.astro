---
/**
 * /adults-jiu-jitsu — audience: adults 16+, beginner-friendly tone.
 * Copy verbatim from build brief Part 3 Adults section.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/cta/CTAButton.astro';
import OptInForm from '../components/form/OptInForm.astro';
import FAQ from '../components/faq/FAQ.astro';
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro';
import { adultsFaqs } from '../content/adults-faqs';
import adultsHero from '../assets/images/adults/adults-hero.jpg';

const benefits = [
  {
    title: 'Real self-defense',
    body:
      "BJJ works based on leverage and technique — not size or strength. It's why it's the #1 choice for law enforcement and military worldwide.",
    icon: 'shield',
  },
  {
    title: 'Total fitness',
    body:
      "Cardio, strength, flexibility, coordination — all in one hour. You'll be too focused on learning to notice you're working out.",
    icon: 'flame',
  },
  {
    title: 'Mental toughness',
    body:
      'The mat teaches you to stay calm under pressure. That skill shows up everywhere in your life.',
    icon: 'brain',
  },
  {
    title: 'Community',
    body:
      "Your training partners become people you trust. The BJJ community at GB Whittier is unlike anything else you'll find.",
    icon: 'people',
  },
];

const firstClassSteps = [
  {
    title: 'Arrive 10 minutes early',
    detail: 'Get checked in, meet a few familiar faces, and step on the mat unhurried.',
  },
  {
    title: 'Uniform provided',
    detail: 'A clean gi is ready for you — no need to buy anything to take your trial classes.',
  },
  {
    title: 'Warm up',
    detail: 'Group warm-ups loosen you up and introduce a few core movement patterns.',
  },
  {
    title: 'Fundamentals',
    detail:
      'Coach demonstrates one or two foundational techniques. Step-by-step, no prior experience assumed.',
  },
  {
    title: 'Practice with a partner',
    detail:
      "You'll drill the technique with a patient training partner at your own pace — no live sparring on day one.",
  },
  {
    title: 'Debrief with Alex',
    detail:
      'Our Program Director Alex chats with you after class about goals, schedule, and next steps. No pressure.',
  },
];

const breadcrumb = [
  { name: 'Home', url: 'https://gbwhittier.com/' },
  { name: 'Adults Jiu-Jitsu', url: 'https://gbwhittier.com/adults-jiu-jitsu/' },
];
---

<BaseLayout
  title="Adult BJJ Classes in Whittier, CA"
  description="Beginner-friendly adult Brazilian Jiu-Jitsu classes at Gracie Barra Whittier, CA. Build fitness, self-defense, and confidence. 3 classes free."
  canonical="https://gbwhittier.com/adults-jiu-jitsu/"
>
  <!-- Section 1: Hero -->
  <section class="relative bg-gb-navy text-gb-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-20 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-gb-white/80 text-xs md:text-sm font-bold tracking-widest uppercase">
          Brazilian Jiu-Jitsu for Adults in Whittier, CA
        </p>
        <h1 class="mt-3 text-3xl md:text-4xl font-extrabold leading-tight">
          Adult Brazilian Jiu-Jitsu Classes in Whittier, CA
        </h1>
        <p class="mt-4 text-2xl md:text-4xl font-extrabold leading-tight text-gb-white">
          The Most Effective Martial Art. Beginner-Friendly. Life-Changing.
        </p>
        <p class="mt-5 text-base md:text-lg text-gb-white/85 max-w-xl">
          Gracie Barra Whittier's adult BJJ program is built for people with zero experience
          who want real results — in fitness, self-defense, and mental toughness. No prior
          training required.
        </p>
        <div class="mt-7">
          <CTAButton
            variant="primary"
            label="Claim My Free 3-Class Pass"
            href="#trial-form"
          />
        </div>
      </div>
      <div class="relative">
        <Image
          src={adultsHero}
          alt="Adult Brazilian Jiu-Jitsu class training at Gracie Barra Whittier, CA"
          widths={[480, 720, 1080]}
          sizes="(min-width: 768px) 50vw, 100vw"
          format="webp"
          class="rounded-2xl shadow-2xl w-full h-auto object-cover"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Section 2: Case for BJJ -->
  <section class="bg-gb-white py-14 md:py-20" aria-labelledby="adults-benefits-heading">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
      <h2
        id="adults-benefits-heading"
        class="text-2xl md:text-4xl font-extrabold text-gb-navy text-center max-w-3xl mx-auto"
      >
        Why Adults Choose Brazilian Jiu-Jitsu Over Every Other Martial Art
      </h2>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          benefits.map((b) => (
            <article class="bg-gb-bg-light rounded-2xl p-6 flex flex-col">
              <span class="inline-flex w-12 h-12 rounded-full bg-gb-red/10 text-gb-red items-center justify-center mb-4" aria-hidden="true">
                {b.icon === 'shield' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                )}
                {b.icon === 'flame' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
                  </svg>
                )}
                {b.icon === 'brain' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" />
                    <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z" />
                  </svg>
                )}
                {b.icon === 'people' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                )}
              </span>
              <h3 class="text-lg font-extrabold text-gb-navy">{b.title}</h3>
              <p class="mt-2 text-sm md:text-base text-gb-text-muted leading-relaxed">
                {b.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 3: Beginner Reassurance -->
  <section class="bg-gb-bg-light py-14 md:py-20" aria-labelledby="adults-beginner-heading">
    <div class="max-w-6xl mx-auto px-4 md:px-6 grid md:grid-cols-2 gap-10 items-center">
      <div class="order-2 md:order-1">
        <h2
          id="adults-beginner-heading"
          class="text-2xl md:text-4xl font-extrabold text-gb-navy"
        >
          You Don't Need Experience. You Need to Show Up.
        </h2>
        <p class="mt-5 text-base md:text-lg text-gb-text-muted leading-relaxed">
          The hardest part of BJJ is walking through the door the first time. Once you do,
          you'll find that every black belt and senior student in the room started exactly
          where you are — confused, a little nervous, and out of breath. That's normal.
          That's the beginning.
        </p>
        <p class="mt-4 text-base md:text-lg text-gb-text-muted leading-relaxed">
          The culture at Gracie Barra Whittier is welcoming and ego-free. No one is here
          to prove anything to you, and no one expects you to prove anything to them.
          <strong class="text-gb-navy">Professor Phil</strong>, our lead adult instructor,
          coaches every Fundamentals class with patience, clarity, and a deep belief that
          BJJ should be available to anyone willing to step on the mat.
        </p>
        <div class="mt-7">
          <CTAButton
            variant="secondary"
            label="Start My Free Trial"
            href="#trial-form"
          />
        </div>
      </div>
      <div class="order-1 md:order-2">
        <img
          src="/images/adults/adults-fundamentals.jpg"
          alt="Adult Fundamentals Brazilian Jiu-Jitsu class led by Professor Phil at Gracie Barra Whittier"
          loading="lazy"
          width="800"
          height="600"
          class="w-full aspect-[4/3] object-cover rounded-2xl shadow-md"
        />
      </div>
    </div>
  </section>

  <!-- Section 4: What to Expect -->
  <section class="bg-gb-white py-14 md:py-20" aria-labelledby="adults-firstclass-heading">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2
        id="adults-firstclass-heading"
        class="text-2xl md:text-4xl font-extrabold text-gb-navy text-center max-w-3xl mx-auto"
      >
        What Your First Adult BJJ Class Looks Like
      </h2>
      <ol class="mt-10 grid md:grid-cols-2 gap-5">
        {
          firstClassSteps.map((step, idx) => (
            <li class="flex gap-4 bg-gb-bg-light rounded-xl p-5">
              <span
                class="shrink-0 w-9 h-9 rounded-full bg-gb-red text-gb-white font-bold inline-flex items-center justify-center"
                aria-hidden="true"
              >
                {idx + 1}
              </span>
              <div>
                <h3 class="text-base md:text-lg font-bold text-gb-navy">{step.title}</h3>
                <p class="mt-1 text-sm md:text-base text-gb-text-muted leading-relaxed">
                  {step.detail}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Section 5: Opt-in Form -->
  <OptInForm
    id="trial-form"
    header="UNLOCK YOUR FREE 3-CLASS PASS"
  />

  <!-- Section 6: Conversion CTA -->
  <section class="bg-gb-navy text-gb-white py-14 md:py-20" aria-labelledby="adults-cta-heading">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <h2
        id="adults-cta-heading"
        class="text-2xl md:text-4xl font-extrabold"
      >
        Start Your BJJ Journey This Week
      </h2>
      <p class="mt-5 text-base md:text-lg text-gb-white/85 leading-relaxed">
        3 free classes. No experience needed. Free uniform rental included. Come see what
        Brazilian Jiu-Jitsu at Gracie Barra Whittier can do for you.
      </p>
      <div class="mt-8 flex justify-center">
        <CTAButton
          variant="primary"
          label="Claim My Free 3-Class Pass"
          href="#trial-form"
        />
      </div>
      <p class="mt-5 text-sm text-gb-white/75">
        3 free classes &bull; Free uniform rental &bull; No contracts &bull; No pressure
      </p>
    </div>
  </section>

  <!-- Section 7: FAQ -->
  <FAQ items={adultsFaqs} heading="Questions About Adult Jiu-Jitsu" />

  <SchemaBreadcrumb items={breadcrumb} />
</BaseLayout>
