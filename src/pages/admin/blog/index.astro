---
/**
 * /admin/blog — internal blog admin, surfaced as a GHL custom menu link
 * (iframe). Modeled on Shopify's admin (Polaris): a blog-posts *index* (table
 * with search/tabs/Add button) is the landing view; the post *editor* opens
 * in-place when you Add or Edit. NO BaseLayout (no public Nav/Footer/CTA in an
 * embedded tool); it ships its own self-contained styles.
 *
 * SSR token gate
 * --------------
 * Reads `t` from the query string and verifies it with verifyAdminToken. If the
 * token is missing/invalid/expired we render a minimal 401 page and stop. The
 * same token is embedded into the page (data-admin-token) so every client fetch
 * sends it back as `x-admin-token` to the /api/admin/blog/* routes.
 *
 * Framing header
 * --------------
 * Astro/Vercel block framing by default. We set a route-scoped CSP frame-ancestors
 * header HERE (before any early return) so the GHL iframe can load the page.
 *
 * Rich-text editor
 * ----------------
 * Lightweight, zero-dependency contenteditable + document.execCommand toolbar.
 * Inline/featured images upload through /api/admin/blog/upload; the editor's
 * innerHTML is serialized straight to `rawHTML`. execCommand is deprecated but
 * universally supported and avoids shipping a WYSIWYG bundle for a tool a single
 * admin uses occasionally.
 */
import { verifyAdminToken } from '../../../lib/admin-token';
import { listPublishedPosts, type BlogPostSummary } from '../../../lib/ghl-blog';
import '../../../styles/tokens.css';

// Allow GHL to iframe this page. Must be set before any early return so the
// 401 response is also frameable inside the GHL admin shell.
//
// frame-ancestors checks the domain in the BROWSER's address bar — staff who
// log in through an agency whitelabel domain (not app.gohighlevel.com) get
// "refused to connect" unless that domain is listed. Defaults cover GHL's own
// domains plus the LocalCraze whitelabel; other agencies append theirs via
// ADMIN_FRAME_ANCESTORS (space-separated CSP sources, e.g. "https://*.agency.com").
const DEFAULT_FRAME_ANCESTORS = [
  'https://*.gohighlevel.com',
  'https://*.leadconnectorhq.com',
  'https://app.gohighlevel.com',
  'https://*.localcraze.com',
];
const extraFrameAncestors = (
  (import.meta.env as Record<string, string | undefined>).ADMIN_FRAME_ANCESTORS ??
  process.env.ADMIN_FRAME_ANCESTORS ??
  ''
)
  .split(/\s+/)
  .filter(Boolean);
Astro.response.headers.set(
  'Content-Security-Policy',
  `frame-ancestors ${[...DEFAULT_FRAME_ANCESTORS, ...extraFrameAncestors].join(' ')}`,
);

const t = Astro.url.searchParams.get('t');
const v = t ? verifyAdminToken(t) : { ok: false as const };

// Initial post list (SSR) — only fetched when authed. Degrades to [] on failure.
let posts: BlogPostSummary[] = [];
if (v.ok) {
  try {
    posts = await listPublishedPosts({ limit: 50 });
  } catch {
    posts = [];
  }
}

if (!v.ok) {
  Astro.response.status = 401;
}

/** Human date + time for the index table, e.g. "Jun 10, 2026, 2:17 PM". Empty for bad input. */
function fmtDate(iso: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  return Number.isNaN(d.getTime())
    ? ''
    : d.toLocaleString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      });
}

// Styles for the minimal 401 page.
const DENIED_STYLES = `
  body { font-family: var(--font-sans); background: #f1f1f1; color: #303030;
         display: grid; place-items: center; min-height: 100vh; margin: 0; padding: 1.5rem; }
  .card { background: #fff; border: 1px solid #e3e3e3; border-radius: 12px; padding: 2rem 2.25rem;
          max-width: 26rem; text-align: center; box-shadow: 0 1px 0 rgba(0,0,0,.05); }
  h1 { font-size: 1.25rem; margin: 0 0 .5rem; }
  p { color: #616161; margin: 0; font-size: .95rem; }
`;

// Shopify/Polaris-flavored admin styles. Neutral canvas, hairline-bordered
// white cards, an index table with tabs/filter/search, and a two-column editor.
const STYLES = `
  * { box-sizing: border-box; }
  :root {
    --p-bg: #f1f1f1;
    --p-surface: #ffffff;
    --p-border: #e3e3e3;
    --p-border-strong: #8a8a8a;
    --p-text: #1a1a1a;
    --p-subdued: #616161;
    --p-focus: #005bd3;
    --p-primary: #5c6ac4;
    --p-primary-hover: #4959bd;
    --p-link: #2c6ecb;
    --p-critical: #d72c0d;
    --p-success: #0a7c3e;
    --p-row: #f6f6f7;
    --p-radius: 12px;
    --p-radius-sm: 8px;
    --p-shadow: 0 1px 0 rgba(0,0,0,.05);
  }
  body {
    font-family: var(--font-sans, 'Inter', system-ui, -apple-system, sans-serif);
    background: var(--p-bg);
    color: var(--p-text);
    margin: 0;
    padding: 0 0 4rem;
    line-height: 1.5;
    font-size: 14px;
    -webkit-font-smoothing: antialiased;
  }
  .visually-hidden { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0; }
  .view[hidden] { display: none; }
  .wrap { max-width: 1000px; margin: 0 auto; padding: 1.5rem 1rem 0; }

  /* ── Index header ─────────────────────────────────────────────── */
  .adm-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .crumb { display: inline-flex; align-items: center; gap: .3rem; font-size: .82rem; color: var(--p-subdued); margin: 0 0 .35rem; }
  .adm-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; }

  /* ── Bulk action bar ──────────────────────────────────────────── */
  .bulkbar { display: flex; align-items: center; gap: .75rem; padding: .6rem 1rem; background: #f6f6f7; border-bottom: 1px solid var(--p-border); }
  .bulkbar[hidden] { display: none; }
  .bulkbar .count { font-size: .82rem; font-weight: 600; color: var(--p-text); }
  .bulkbar .spacer { flex: 1; }

  /* ── Filter control ───────────────────────────────────────────── */
  .filter-select { font: inherit; font-size: .82rem; height: 34px; padding: 0 .8rem; border: 1px solid var(--p-border-strong); border-radius: var(--p-radius-sm); background: #fafafa; color: var(--p-text); cursor: pointer; }
  .filter-select:focus { outline: none; border-color: var(--p-focus); box-shadow: 0 0 0 2px rgba(0,91,211,.25); }

  /* ── Help footer ──────────────────────────────────────────────── */
  .help-footer { text-align: center; margin: 1.25rem 0 0; font-size: .82rem; }
  .help-footer a { color: var(--p-subdued); text-decoration: none; }
  .help-footer a:hover { color: var(--p-link); text-decoration: underline; }

  /* ── Cards ────────────────────────────────────────────────────── */
  .card { background: var(--p-surface); border: 1px solid var(--p-border); border-radius: var(--p-radius); box-shadow: var(--p-shadow); }
  .card.pad { padding: 1rem 1.25rem 1.25rem; }
  .card h2 { font-size: .8125rem; font-weight: 650; margin: 0 0 .85rem; }

  /* ── Tabs + filter bar ────────────────────────────────────────── */
  .tabs { display: flex; gap: 1rem; padding: .35rem 1rem 0; border-bottom: 1px solid var(--p-border); }
  .tab { padding: .6rem .25rem; font-size: .85rem; font-weight: 550; color: var(--p-text); border-bottom: 2px solid var(--p-text); }
  .filterbar { display: flex; gap: .6rem; padding: .85rem 1rem; align-items: center; }
  .filter-btn { font: inherit; font-size: .82rem; height: 34px; padding: 0 .8rem; border: 1px solid var(--p-border-strong); border-radius: var(--p-radius-sm); background: #fafafa; color: var(--p-text); cursor: default; opacity: .85; }
  .search { flex: 1; position: relative; }
  .search input { width: 100%; height: 34px; padding: 0 .7rem 0 2rem; border: 1px solid var(--p-border-strong); border-radius: var(--p-radius-sm); font: inherit; color: var(--p-text); background: var(--p-surface); }
  .search input:focus { outline: none; border-color: var(--p-focus); box-shadow: 0 0 0 2px rgba(0,91,211,.25); }
  .search .ic { position: absolute; left: .65rem; top: 50%; transform: translateY(-50%); color: var(--p-subdued); font-size: .95rem; pointer-events: none; }

  /* ── Index table ──────────────────────────────────────────────── */
  .tbl { width: 100%; border-collapse: collapse; }
  .tbl th { text-align: left; font-size: .78rem; font-weight: 650; color: var(--p-subdued); padding: .55rem .75rem; border-bottom: 1px solid var(--p-border); }
  .tbl td { padding: .7rem .75rem; border-bottom: 1px solid var(--p-border); vertical-align: middle; }
  .tbl tr:last-child td { border-bottom: 0; }
  .tbl tbody tr:hover { background: var(--p-row); }
  .c-check { width: 2.5rem; }
  .c-act { width: 1%; white-space: nowrap; text-align: right; }
  .cell-title { display: flex; align-items: center; gap: .7rem; min-width: 0; }
  .thumb { width: 40px; height: 40px; border-radius: 6px; object-fit: cover; border: 1px solid var(--p-border); background: #eee; flex-shrink: 0; }
  .thumb.ph { display: inline-block; }
  .t-link { color: var(--p-link); font-weight: 600; text-decoration: none; cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: none; border: 0; font: inherit; padding: 0; }
  .t-link:hover { text-decoration: underline; }
  .t-slug { font-size: .76rem; color: var(--p-subdued); }
  .badge { display: inline-flex; align-items: center; gap: .4rem; font-size: .78rem; font-weight: 550; color: var(--p-success); }
  .badge .dot { width: .5rem; height: .5rem; border-radius: 50%; background: var(--p-success); }
  .col-date { color: var(--p-subdued); font-size: .82rem; white-space: nowrap; }
  .col-blog, .col-author { color: var(--p-subdued); font-size: .82rem; }
  .empty-row td { color: var(--p-subdued); padding: 1.25rem .75rem; }

  /* ── Editor view ──────────────────────────────────────────────── */
  .topbar { position: sticky; top: 0; z-index: 10; background: var(--p-surface); border-bottom: 1px solid var(--p-border); }
  .topbar-inner { max-width: 1000px; margin: 0 auto; padding: .55rem 1rem; display: flex; align-items: center; gap: .75rem; }
  .back-link { display: inline-flex; align-items: center; gap: .35rem; font-size: .9rem; font-weight: 600; color: var(--p-text); background: none; border: 0; cursor: pointer; padding: .25rem .25rem; }
  .back-link:hover { color: var(--p-link); }
  .topbar .spacer { flex: 1; }

  .page { max-width: 1000px; margin: 0 auto; padding: 1.25rem 1rem 0; }
  .grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 860px) { .grid { grid-template-columns: minmax(0,2fr) minmax(0,1fr); align-items: start; } }
  .col-side { display: grid; gap: 1rem; }

  .field { margin-bottom: 1rem; }
  .field:last-child { margin-bottom: 0; }
  .field label { display: block; font-weight: 500; font-size: .8125rem; margin-bottom: .35rem; }
  .hint { font-size: .8rem; color: var(--p-subdued); margin: .45rem 0 0; }
  .hint.is-ok { color: var(--p-success); }
  .hint.is-err { color: var(--p-critical); }
  input[type="text"] { width: 100%; height: 36px; padding: 0 .7rem; border: 1px solid var(--p-border-strong); border-radius: var(--p-radius-sm); font: inherit; color: var(--p-text); background: var(--p-surface); }
  input[type="file"] { font: inherit; font-size: .82rem; max-width: 100%; }
  input[type="text"]:focus, input[type="file"]:focus-visible, .editor:focus { outline: none; border-color: var(--p-focus); box-shadow: 0 0 0 2px rgba(0,91,211,.25); }
  .preview { display: block; margin-top: .65rem; width: 100%; max-height: 180px; object-fit: cover; border-radius: var(--p-radius-sm); border: 1px solid var(--p-border); }

  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .15rem; padding: .35rem; border: 1px solid var(--p-border-strong); border-bottom: 0; border-radius: var(--p-radius-sm) var(--p-radius-sm) 0 0; background: #fafafa; }
  .toolbar button { font: inherit; font-size: .8rem; line-height: 1; padding: .4rem .45rem; border: 1px solid transparent; border-radius: 6px; background: transparent; color: var(--p-text); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: .1rem; min-height: 28px; }
  .toolbar button:hover { background: #ececec; }
  .toolbar button:disabled { opacity: .4; cursor: not-allowed; }
  .toolbar button.is-on { background: #e4e9f1; }
  .toolbar button:focus-visible { outline: 2px solid var(--p-focus); outline-offset: 1px; }
  .toolbar button svg { display: block; }
  .toolbar .sep { width: 1px; align-self: stretch; margin: .15rem .25rem; background: var(--p-border); }
  .tb-select { font: inherit; font-size: .78rem; height: 28px; max-width: 7.5rem; padding: 0 .3rem; border: 1px solid transparent; border-radius: 6px; background: transparent; color: var(--p-text); cursor: pointer; }
  .tb-select:hover { background: #ececec; }
  .tb-select:disabled { opacity: .4; cursor: not-allowed; }
  .tb-select:focus-visible { outline: 2px solid var(--p-focus); outline-offset: 1px; }
  .toolbar .chip { display: block; width: .9rem; height: .2rem; border-radius: 1px; }
  .toolbar [data-cmd="color"], .toolbar [data-cmd="highlight"] { flex-direction: column; gap: 2px; padding-top: .25rem; padding-bottom: .25rem; }
  .source-area { display: block; width: 100%; min-height: 300px; padding: .85rem; border: 1px solid var(--p-border-strong); border-radius: 0 0 var(--p-radius-sm) var(--p-radius-sm); background: #0f172a; color: #e2e8f0; font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; font-size: .8rem; line-height: 1.5; resize: vertical; }
  .source-area:focus { outline: none; border-color: var(--p-focus); box-shadow: 0 0 0 2px rgba(0,91,211,.25); }
  .source-area[hidden] { display: none; }
  .editor { min-height: 300px; padding: .85rem; border: 1px solid var(--p-border-strong); border-radius: 0 0 var(--p-radius-sm) var(--p-radius-sm); background: var(--p-surface); overflow-y: auto; }
  .editor h2 { font-size: 1.3rem; margin: .75rem 0 .4rem; }
  .editor h3 { font-size: 1.1rem; margin: .6rem 0 .35rem; }
  .editor a { color: var(--p-focus); }
  .editor img { max-width: 100%; height: auto; border-radius: 6px; }
  .editor ul, .editor ol { padding-left: 1.4rem; }
  /* Paragraph spacing mirrors the public post page (.gb-prose) so the editor
   * previews what publishes. > div covers legacy posts written before the
   * defaultParagraphSeparator='p' fix. */
  .editor p, .editor > div { margin: .85rem 0; }
  .editor > :first-child { margin-top: 0; }
  .editor blockquote { border-left: 3px solid #d0d0d0; margin: .75rem 0; padding: .1rem .85rem; color: var(--p-subdued); font-style: italic; }
  .editor hr { border: 0; border-top: 1px solid #d0d0d0; margin: 1rem 0; }
  /* Embeds aren't interactive while editing — click selects, Delete removes. */
  .editor iframe { display: block; width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; border-radius: 6px; pointer-events: none; background: #eee; }

  .btn { font: inherit; font-size: .85rem; font-weight: 600; cursor: pointer; border: 1px solid transparent; border-radius: var(--p-radius-sm); padding: 0 .9rem; height: 34px; display: inline-flex; align-items: center; justify-content: center; }
  .btn:disabled { opacity: .55; cursor: not-allowed; }
  .btn-primary { background: var(--p-primary); color: #fff; }
  .btn-primary:hover:not(:disabled) { background: var(--p-primary-hover); }
  .btn-ghost { background: var(--p-surface); border-color: var(--p-border-strong); color: var(--p-text); }
  .btn-ghost:hover:not(:disabled) { background: #f7f7f7; }
  .btn-small { height: 30px; padding: 0 .7rem; font-size: .8rem; background: var(--p-surface); border-color: var(--p-border-strong); color: var(--p-text); }
  .btn-small:hover:not(:disabled) { background: #f7f7f7; }
  .btn-danger { color: var(--p-critical); border-color: var(--p-border-strong); }
  .btn-danger:hover:not(:disabled) { background: #fbeae5; border-color: var(--p-critical); }
  .btn:focus-visible { outline: 2px solid var(--p-focus); outline-offset: 2px; }

  .status { margin: 0; font-size: .85rem; }
  .status.is-ok { color: var(--p-success); }
  .status.is-err { color: var(--p-critical); }
  #list-status { margin: 0 0 .75rem; }
  #list-status:empty { display: none; }
  .side-note { font-size: .8rem; color: var(--p-subdued); margin: .5rem 0 0; }
`;
---

{
  !v.ok ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex,nofollow" />
        <title>Access denied</title>
        <style set:html={DENIED_STYLES} />
      </head>
      <body>
        <div class="card">
          <h1>Access denied</h1>
          <p>This link is invalid or expired.</p>
        </div>
      </body>
    </html>
  ) : (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex,nofollow" />
        <title>Blog editor</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        />
        <style set:html={STYLES} />
      </head>
      <body>
        {/* Token embedded for client fetches → sent as x-admin-token header. */}
        <div id="admin-root" data-admin-token={t}>

          {/* ════ INDEX VIEW (default) ═══════════════════════════════════ */}
          <section id="list-view" class="view">
            <div class="wrap">
              <header class="adm-header">
                <div>
                  <p class="crumb">‹ Website</p>
                  <h1>Blog posts</h1>
                </div>
                <button type="button" id="add-btn" class="btn btn-primary">Add blog post</button>
              </header>

              {/* Post-save/delete confirmations land HERE (the topbar status
                  lives in the editor view, which is hidden once we return to
                  the list — see form-status for in-editor messages). */}
              <p class="status" id="list-status" role="status" aria-live="polite"></p>

              <div class="card">
                <div class="tabs"><span class="tab">All</span></div>
                <div class="filterbar">
                  <label class="visually-hidden" for="post-filter">Filter posts</label>
                  <select id="post-filter" class="filter-select" aria-label="Filter posts">
                    <option value="all">All posts</option>
                    <option value="with-image">With featured image</option>
                    <option value="without-image">Without featured image</option>
                  </select>
                  <div class="search">
                    <span class="ic" aria-hidden="true">⌕</span>
                    <input id="post-search" type="text" placeholder="Search blog posts" autocomplete="off" aria-label="Search blog posts" />
                  </div>
                </div>

                {/* Bulk action bar — shown when ≥1 row is selected. */}
                <div class="bulkbar" id="bulk-bar" hidden>
                  <span class="count" id="bulk-count">0 selected</span>
                  <span class="spacer"></span>
                  <button type="button" id="bulk-clear-btn" class="btn btn-small">Clear</button>
                  <button type="button" id="bulk-delete-btn" class="btn btn-small btn-danger">Delete</button>
                </div>

                <table class="tbl">
                  <thead>
                    <tr>
                      <th class="c-check"><input type="checkbox" id="select-all" aria-label="Select all" /></th>
                      <th>Title</th>
                      <th>Blog</th>
                      <th>Author</th>
                      <th>Date</th>
                      <th class="c-act"></th>
                    </tr>
                  </thead>
                  <tbody id="post-list">
                    {posts.length === 0 ? (
                      <tr class="empty-row" data-empty>
                        <td colspan="6">No blog posts yet. Click “Add blog post” to write your first one.</td>
                      </tr>
                    ) : (
                      posts.map((p) => (
                        <tr
                          class="post-row"
                          data-post-id={p.id}
                          data-title={p.title}
                          data-image-url={p.imageUrl}
                          data-description={p.description}
                          data-image-alt={p.imageAltText}
                          data-slug={p.slug}
                          data-blog={p.blogName}
                          data-author={p.authorName}
                        >
                          <td class="c-check"><input type="checkbox" class="row-check" aria-label={`Select ${p.title}`} /></td>
                          <td>
                            <div class="cell-title">
                              {p.imageUrl ? (
                                <img class="thumb" src={p.imageUrl} alt="" loading="lazy" />
                              ) : (
                                <span class="thumb ph" aria-hidden="true"></span>
                              )}
                              <span style="min-width:0; display:flex; flex-direction:column;">
                                <button type="button" class="t-link post-title" data-edit>{p.title}</button>
                                <span class="t-slug">/{p.slug}</span>
                              </span>
                            </div>
                          </td>
                          <td class="col-blog">{p.blogName}</td>
                          <td class="col-author">{p.authorName}</td>
                          <td class="col-date">{fmtDate(p.publishedAt)}</td>
                          <td class="c-act"><button type="button" class="btn btn-small btn-danger" data-delete>Delete</button></td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>

              <p class="help-footer">
                <a href="/blog" target="_blank" rel="noopener">Learn more about blog posts ↗</a>
              </p>
            </div>
          </section>

          {/* ════ EDITOR VIEW (hidden until Add/Edit) ════════════════════ */}
          <section id="editor-view" class="view" hidden>
            <header class="topbar">
              <div class="topbar-inner">
                <button type="button" id="back-btn" class="back-link">‹ Blog posts</button>
                <span class="spacer"></span>
                <p class="status" id="form-status" role="status" aria-live="polite"></p>
                <button type="button" id="cancel-edit-btn" class="btn btn-ghost" hidden>Discard</button>
                <button type="button" id="publish-btn" class="btn btn-primary">Publish</button>
              </div>
            </header>

            <div class="page">
              <div class="grid">
                <div class="col-main">
                  <section class="card pad">
                    <h2 class="visually-hidden">Post editor</h2>
                    {/* Hidden id field — set when editing an existing post. */}
                    <input type="hidden" id="post-id" value="" />
                    <div class="field">
                      <label for="post-title">Title</label>
                      <input id="post-title" type="text" maxlength="300" placeholder="e.g. 5 Benefits of Brazilian Jiu-Jitsu for Kids" autocomplete="off" />
                    </div>
                    <div class="field">
                      <label for="post-body">Content</label>
                      <div class="toolbar" role="toolbar" aria-label="Formatting" aria-controls="post-body">
                        <button type="button" data-cmd="bold" title="Bold" aria-label="Bold"><b>B</b></button>
                        <button type="button" data-cmd="italic" title="Italic" aria-label="Italic"><i>I</i></button>
                        <button type="button" data-cmd="underline" title="Underline" aria-label="Underline"><u>U</u></button>
                        <button type="button" data-cmd="strike" title="Strikethrough" aria-label="Strikethrough"><s>S</s></button>
                        <span class="sep" aria-hidden="true"></span>
                        <select id="tb-font" class="tb-select" title="Font" aria-label="Font">
                          <option value="">Font</option>
                          <option value="inherit">Default</option>
                          <option value="Arial, Helvetica, sans-serif">Sans-serif</option>
                          <option value="Georgia, 'Times New Roman', serif">Serif</option>
                          <option value="'Courier New', monospace">Monospace</option>
                        </select>
                        <select id="tb-size" class="tb-select" title="Font size" aria-label="Font size">
                          <option value="">Size</option>
                          <option value="12px">12px</option>
                          <option value="14px">14px</option>
                          <option value="16px">16px</option>
                          <option value="18px">18px</option>
                          <option value="20px">20px</option>
                          <option value="24px">24px</option>
                          <option value="28px">28px</option>
                          <option value="32px">32px</option>
                        </select>
                        <select id="tb-block" class="tb-select" title="Paragraph style" aria-label="Paragraph style">
                          <option value="p">Paragraph</option>
                          <option value="h1">Heading 1</option>
                          <option value="h2">Heading 2</option>
                          <option value="h3">Heading 3</option>
                          <option value="h4">Heading 4</option>
                        </select>
                        <span class="sep" aria-hidden="true"></span>
                        <button type="button" data-cmd="align-left" title="Align left" aria-label="Align left"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M1 2.5h12M1 5.5h8M1 8.5h12M1 11.5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg></button>
                        <button type="button" data-cmd="align-center" title="Align center" aria-label="Align center"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M1 2.5h12M3 5.5h8M1 8.5h12M3 11.5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg></button>
                        <button type="button" data-cmd="align-right" title="Align right" aria-label="Align right"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M1 2.5h12M5 5.5h8M1 8.5h12M5 11.5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg></button>
                        <button type="button" data-cmd="align-justify" title="Justify" aria-label="Justify"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M1 2.5h12M1 5.5h12M1 8.5h12M1 11.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg></button>
                        <button type="button" data-cmd="outdent" title="Decrease indent" aria-label="Decrease indent"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M1 2.5h12M7 5.5h6M7 8.5h6M1 11.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/><path d="M4.5 5.25 1.5 7l3 1.75z" fill="currentColor"/></svg></button>
                        <button type="button" data-cmd="indent" title="Increase indent" aria-label="Increase indent"><svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M1 2.5h12M7 5.5h6M7 8.5h6M1 11.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/><path d="M1.5 5.25 4.5 7l-3 1.75z" fill="currentColor"/></svg></button>
                        <select id="tb-lh" class="tb-select" title="Line height" aria-label="Line height">
                          <option value="">Spacing</option>
                          <option value="default">Default</option>
                          <option value="1">1</option>
                          <option value="1.15">1.15</option>
                          <option value="1.5">1.5</option>
                          <option value="2">2</option>
                        </select>
                        <span class="sep" aria-hidden="true"></span>
                        <button type="button" data-cmd="ul" title="Bullet list" aria-label="Bullet list">•&nbsp;List</button>
                        <button type="button" data-cmd="ol" title="Numbered list" aria-label="Numbered list">1.&nbsp;List</button>
                        <button type="button" data-cmd="quote" title="Quote" aria-label="Quote">❝</button>
                        <span class="sep" aria-hidden="true"></span>
                        <button type="button" data-cmd="color" title="Text color" aria-label="Text color">A<span class="chip" id="fore-chip" style="background:#1a1a1a"></span></button>
                        <button type="button" data-cmd="highlight" title="Highlight color" aria-label="Highlight color">A<span class="chip" id="back-chip" style="background:#fff176"></span></button>
                        <input type="color" id="fore-color" value="#1a1a1a" class="visually-hidden" tabindex="-1" aria-hidden="true" />
                        <input type="color" id="back-color" value="#fff176" class="visually-hidden" tabindex="-1" aria-hidden="true" />
                        <span class="sep" aria-hidden="true"></span>
                        <button type="button" data-cmd="link" title="Insert link" aria-label="Insert link">Link</button>
                        <button type="button" data-cmd="image" title="Insert image" aria-label="Insert image">Image</button>
                        <button type="button" data-cmd="video" title="Embed video (YouTube/Vimeo)" aria-label="Embed video">Video</button>
                        <span class="sep" aria-hidden="true"></span>
                        <button type="button" data-cmd="hr" title="Divider line" aria-label="Divider line">—</button>
                        <button type="button" data-cmd="clear" title="Clear formatting" aria-label="Clear formatting"><s>T</s>x</button>
                        <button type="button" data-cmd="source" id="source-btn" title="Edit HTML source" aria-label="Edit HTML source">&lt;/&gt;</button>
                      </div>
                      <div id="post-body" class="editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Post body"></div>
                      <textarea id="post-source" class="source-area" aria-label="Post HTML source" spellcheck="false" hidden></textarea>
                      <input type="file" id="inline-file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" hidden />
                    </div>
                  </section>
                </div>

                <aside class="col-side">
                  <section class="card pad">
                    <h2>Visibility</h2>
                    <span class="badge"><span class="dot"></span> Visible on website</span>
                    <p class="side-note">Saving publishes the post to the website right away.</p>
                  </section>
                  <section class="card pad">
                    <h2>Featured image</h2>
                    <div class="field">
                      <label for="featured-file" class="visually-hidden">Featured image</label>
                      <input id="featured-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" />
                      <p class="hint" id="featured-status" aria-live="polite"></p>
                      <img id="featured-preview" class="preview" alt="" hidden />
                      <input type="hidden" id="featured-url" value="" />
                    </div>
                  </section>
                </aside>
              </div>
            </div>
          </section>
        </div>

        <script>
          // ─── /admin/blog client controller ──────────────────────────────
          // Two views (index table + editor); the token rides on every API call.
          const root = document.getElementById('admin-root');
          if (root) {
            const token = root.dataset.adminToken ?? '';
            const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
              document.getElementById(id) as T | null;

            const listView = $('list-view');
            const editorView = $('editor-view');
            const addBtn = $<HTMLButtonElement>('add-btn');
            const backBtn = $<HTMLButtonElement>('back-btn');
            const searchEl = $<HTMLInputElement>('post-search');
            const filterEl = $<HTMLSelectElement>('post-filter');
            const selectAllEl = $<HTMLInputElement>('select-all');
            const bulkBar = $('bulk-bar');
            const bulkCountEl = $('bulk-count');
            const bulkDeleteBtn = $<HTMLButtonElement>('bulk-delete-btn');
            const bulkClearBtn = $<HTMLButtonElement>('bulk-clear-btn');

            const postIdEl = $<HTMLInputElement>('post-id');
            const titleEl = $<HTMLInputElement>('post-title');
            const featuredFileEl = $<HTMLInputElement>('featured-file');
            const featuredStatusEl = $('featured-status');
            const featuredPreviewEl = $<HTMLImageElement>('featured-preview');
            const featuredUrlEl = $<HTMLInputElement>('featured-url');
            const bodyEl = $('post-body');
            const inlineFileEl = $<HTMLInputElement>('inline-file');
            const publishBtn = $<HTMLButtonElement>('publish-btn');
            const cancelEditBtn = $<HTMLButtonElement>('cancel-edit-btn');
            const formStatusEl = $('form-status');
            const listStatusEl = $('list-status');
            const postListEl = $('post-list');

            // ── Edit-session state ────────────────────────────────────────
            // editEpoch: bumped every time the editor target changes (Add,
            // Edit, Back, reset). startEdit's async prefill captures the epoch
            // before its fetch and bails if it no longer matches — a slow GET
            // for post A can never overwrite the editor after the admin
            // switched to post B (cross-post body corruption guard).
            let editEpoch = 0;
            // bodyDirty: true only after the admin actually types in the body.
            // Programmatic innerHTML writes do NOT fire 'input', so prefill
            // resets it explicitly. An untouched body is never re-sent on
            // Update — a description-derived fallback can't clobber the real
            // stored body.
            let bodyDirty = false;
            // bodyIsFallback: the GET told us rawHTML is a short summary
            // fallback, not the real stored body.
            let bodyIsFallback = false;

            bodyEl?.addEventListener('input', () => { bodyDirty = true; });

            function authHeaders(extra: Record<string, string> = {}): Record<string, string> {
              return { 'x-admin-token': token, ...extra };
            }
            function setStatus(el: HTMLElement | null, msg: string, kind: 'ok' | 'err' | '' = '') {
              if (!el) return;
              el.textContent = msg;
              el.classList.remove('is-ok', 'is-err');
              if (kind === 'ok') el.classList.add('is-ok');
              if (kind === 'err') el.classList.add('is-err');
            }

            // ── View switching ────────────────────────────────────────────
            function showEditor() {
              if (listView) listView.hidden = true;
              if (editorView) editorView.hidden = false;
              window.scrollTo({ top: 0 });
            }
            function showList() {
              if (editorView) editorView.hidden = true;
              if (listView) listView.hidden = false;
              window.scrollTo({ top: 0 });
            }

            addBtn?.addEventListener('click', () => { resetForm(); setStatus(formStatusEl, ''); setStatus(listStatusEl, ''); showEditor(); titleEl?.focus(); });
            backBtn?.addEventListener('click', () => { resetForm(); setStatus(formStatusEl, ''); showList(); });

            // ── Search + filter (client-side, composed) ───────────────────
            // A row is visible only if it matches BOTH the search query AND the
            // featured-image filter. Both the search input and the filter
            // <select> call this single entry point.
            function applyFilters() {
              const q = (searchEl?.value ?? '').trim().toLowerCase();
              const mode = filterEl?.value ?? 'all';
              postListEl?.querySelectorAll<HTMLElement>('.post-row').forEach((row) => {
                const title = (row.dataset.title ?? '').toLowerCase();
                const slug = (row.dataset.slug ?? '').toLowerCase();
                const matchesSearch = !q || title.includes(q) || slug.includes(q);
                const hasImage = !!(row.dataset.imageUrl ?? '').trim();
                const matchesFilter =
                  mode === 'with-image' ? hasImage
                  : mode === 'without-image' ? !hasImage
                  : true;
                row.style.display = matchesSearch && matchesFilter ? '' : 'none';
              });
              // Visibility changed → re-sync select-all + bulk bar against
              // what's now actually visible/checked.
              syncSelectionUI();
            }
            searchEl?.addEventListener('input', applyFilters);
            filterEl?.addEventListener('change', applyFilters);

            // ── Bulk select + bulk delete ─────────────────────────────────
            // "Visible" rows = rows not hidden by the search/filter pass.
            function visibleRows(): HTMLElement[] {
              return Array.from(postListEl?.querySelectorAll<HTMLElement>('.post-row') ?? [])
                .filter((row) => row.style.display !== 'none');
            }
            function rowCheckbox(row: HTMLElement): HTMLInputElement | null {
              return row.querySelector<HTMLInputElement>('.row-check');
            }
            function checkedVisibleRows(): HTMLElement[] {
              return visibleRows().filter((row) => rowCheckbox(row)?.checked);
            }
            // Reconcile the bulk bar + select-all state with the current
            // selection (only counting rows that are actually visible).
            function syncSelectionUI() {
              const vis = visibleRows();
              const checked = vis.filter((row) => rowCheckbox(row)?.checked);
              if (bulkBar) bulkBar.hidden = checked.length === 0;
              if (bulkCountEl) bulkCountEl.textContent = `${checked.length} selected`;
              if (selectAllEl) {
                selectAllEl.checked = vis.length > 0 && checked.length === vis.length;
                selectAllEl.indeterminate = checked.length > 0 && checked.length < vis.length;
              }
            }
            // Header checkbox toggles every CURRENTLY VISIBLE row.
            selectAllEl?.addEventListener('change', () => {
              const on = selectAllEl.checked;
              visibleRows().forEach((row) => { const cb = rowCheckbox(row); if (cb) cb.checked = on; });
              syncSelectionUI();
            });
            bulkClearBtn?.addEventListener('click', () => {
              postListEl?.querySelectorAll<HTMLInputElement>('.row-check').forEach((cb) => { cb.checked = false; });
              syncSelectionUI();
            });
            bulkDeleteBtn?.addEventListener('click', async () => {
              const rows = checkedVisibleRows();
              if (rows.length === 0) return;
              if (!window.confirm(`Delete ${rows.length} post${rows.length === 1 ? '' : 's'}? This removes them from the website.`)) return;
              bulkDeleteBtn.disabled = true;
              if (bulkClearBtn) bulkClearBtn.disabled = true;
              let failures = 0;
              for (const row of rows) {
                const id = row.dataset.postId ?? '';
                if (!id) continue;
                try {
                  const res = await fetch(`/api/admin/blog/${encodeURIComponent(id)}`, { method: 'DELETE', headers: authHeaders() });
                  const data = await res.json().catch(() => ({}));
                  if (!res.ok || !data.ok) throw new Error();
                  row.remove();
                } catch {
                  failures++;
                }
              }
              bulkDeleteBtn.disabled = false;
              if (bulkClearBtn) bulkClearBtn.disabled = false;
              ensureEmptyState();
              syncSelectionUI();
              if (failures > 0) window.alert(`${failures} post${failures === 1 ? '' : 's'} could not be deleted.`);
              else setStatus(listStatusEl, `${rows.length} post${rows.length === 1 ? '' : 's'} deleted.`, 'ok');
            });

            // ── Rich-text toolbar ─────────────────────────────────────────
            // Enter must create real <p> paragraphs (not bare <div>s) so posts
            // get proper paragraph spacing in the editor AND on the site.
            try { document.execCommand('defaultParagraphSeparator', false, 'p'); } catch { /* older engines */ }
            // An empty contenteditable leaves the first typed line as a BARE
            // text node (no <p>), which renders without paragraph spacing.
            // Seed an empty paragraph so typing starts inside a real <p>.
            const EMPTY_BODY = '<p><br></p>';
            // True when the body has no text and no images ("<p><br></p>" etc.).
            function isBodyEmpty(): boolean {
              if (!bodyEl) return true;
              if (bodyEl.querySelector('img')) return false;
              return (bodyEl.textContent ?? '').trim() === '';
            }
            // Wrap any top-level text/inline runs in <p> — legacy posts (and
            // odd paste paths) can leave bare text at the root, which gets no
            // paragraph margins on the public page.
            const BLOCK_TAGS = new Set(['P', 'DIV', 'H1', 'H2', 'H3', 'H4', 'UL', 'OL', 'BLOCKQUOTE', 'TABLE', 'FIGURE', 'HR', 'PRE', 'IFRAME']);
            function normalizeBlocks() {
              if (!bodyEl) return;
              let node: ChildNode | null = bodyEl.firstChild;
              while (node) {
                const isBlock = node.nodeType === 1 && BLOCK_TAGS.has((node as Element).nodeName);
                const isBlankText = node.nodeType === 3 && !(node.textContent ?? '').trim();
                if (isBlock || isBlankText) { node = node.nextSibling; continue; }
                const p = document.createElement('p');
                bodyEl.insertBefore(p, node);
                let runner: ChildNode | null = node;
                while (runner && !(runner.nodeType === 1 && BLOCK_TAGS.has((runner as Element).nodeName))) {
                  const next: ChildNode | null = runner.nextSibling;
                  p.appendChild(runner);
                  runner = next;
                }
                node = p.nextSibling;
              }
            }
            // ── Selection bookkeeping ─────────────────────────────────────
            // Dropdowns and color inputs steal focus from the contenteditable,
            // collapsing the selection. Remember the last in-body range and
            // restore it before running any command.
            let savedRange: Range | null = null;
            document.addEventListener('selectionchange', () => {
              const sel = document.getSelection();
              if (sel && sel.rangeCount > 0 && bodyEl && bodyEl.contains(sel.anchorNode)) {
                savedRange = sel.getRangeAt(0).cloneRange();
                syncBlockSelect();
              }
            });
            function restoreSelection() {
              if (!savedRange) return;
              const sel = document.getSelection();
              if (!sel) return;
              sel.removeAllRanges();
              sel.addRange(savedRange);
            }
            // Top-level blocks (direct children of the editor) touched by the
            // current selection — the unit that line-height/indent operate on.
            function selectedBlocks(): HTMLElement[] {
              if (!bodyEl) return [];
              normalizeBlocks();
              const sel = document.getSelection();
              if (!sel || sel.rangeCount === 0) return [];
              const range = sel.getRangeAt(0);
              const topOf = (n: Node | null): Node | null => {
                while (n && n.parentNode !== bodyEl) n = n.parentNode;
                return n;
              };
              const start = topOf(range.startContainer);
              const end = topOf(range.endContainer);
              if (!start || !end) return [];
              const out: HTMLElement[] = [];
              let cur: Node | null = start;
              while (cur) {
                if (cur.nodeType === 1) out.push(cur as HTMLElement);
                if (cur === end) break;
                cur = cur.nextSibling;
              }
              return out;
            }

            // Commands whose output should be a styled <span> (matches the
            // server sanitizer's style allowlist) instead of a legacy <font>.
            const CSS_CMDS = new Set(['foreColor', 'hiliteColor', 'backColor', 'fontName']);
            let sourceMode = false;
            function exec(command: string, value?: string) {
              if (sourceMode || !bodyEl) return;
              bodyEl.focus();
              restoreSelection();
              try { document.execCommand('styleWithCSS', false, CSS_CMDS.has(command) ? 'true' : 'false'); } catch { /* older engines */ }
              document.execCommand(command, false, value);
            }

            // execCommand('fontSize') only takes 1–7 — apply 7 as a marker,
            // then rewrite the produced <font> tags into sanitizer-friendly
            // <span style="font-size: …">.
            function applyFontSize(px: string) {
              if (!bodyEl) return;
              exec('fontSize', '7');
              bodyEl.querySelectorAll('font[size="7"]').forEach((f) => {
                const span = document.createElement('span');
                span.style.fontSize = px;
                while (f.firstChild) span.appendChild(f.firstChild);
                f.replaceWith(span);
              });
              bodyDirty = true;
            }
            function applyLineHeight(v: string) {
              if (sourceMode) return;
              bodyEl?.focus();
              restoreSelection();
              const blocks = selectedBlocks();
              if (blocks.length === 0) return;
              blocks.forEach((b) => {
                if (v === 'default') b.style.removeProperty('line-height');
                else b.style.lineHeight = v;
                if (!b.getAttribute('style')) b.removeAttribute('style');
              });
              bodyDirty = true;
            }
            // Indent/outdent as margin-left steps — execCommand('indent') nests
            // blockquotes, which the public page renders as styled quotes.
            function applyIndent(deltaRem: number) {
              if (sourceMode) return;
              bodyEl?.focus();
              restoreSelection();
              const blocks = selectedBlocks();
              if (blocks.length === 0) return;
              blocks.forEach((b) => {
                const cur = parseFloat(b.style.marginLeft || '0') || 0;
                const next = Math.max(0, Math.min(12, cur + deltaRem));
                if (next === 0) b.style.removeProperty('margin-left');
                else b.style.marginLeft = `${next}rem`;
                if (!b.getAttribute('style')) b.removeAttribute('style');
              });
              bodyDirty = true;
            }
            // YouTube/Vimeo URL → privacy-friendly embed markup. Returns null
            // when the URL isn't recognized (the sanitizer would drop any
            // other iframe host anyway).
            function videoEmbedHtml(url: string): string | null {
              let m = url.match(/(?:youtube\.com\/(?:watch\?.*?v=|shorts\/|embed\/)|youtu\.be\/)([\w-]{6,20})/);
              if (m) return `<iframe src="https://www.youtube-nocookie.com/embed/${m[1]}" title="Video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
              m = url.match(/vimeo\.com\/(?:video\/)?(\d{6,12})/);
              if (m) return `<iframe src="https://player.vimeo.com/video/${m[1]}" title="Video" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
              return null;
            }

            document.querySelectorAll<HTMLButtonElement>('.toolbar button[data-cmd]').forEach((btn) => {
              btn.addEventListener('click', (e) => {
                e.preventDefault();
                switch (btn.dataset.cmd) {
                  case 'bold': exec('bold'); break;
                  case 'italic': exec('italic'); break;
                  case 'underline': exec('underline'); break;
                  case 'strike': exec('strikeThrough'); break;
                  case 'ul': exec('insertUnorderedList'); break;
                  case 'ol': exec('insertOrderedList'); break;
                  case 'quote': exec('formatBlock', 'BLOCKQUOTE'); break;
                  case 'align-left': exec('justifyLeft'); break;
                  case 'align-center': exec('justifyCenter'); break;
                  case 'align-right': exec('justifyRight'); break;
                  case 'align-justify': exec('justifyFull'); break;
                  case 'indent': applyIndent(2); break;
                  case 'outdent': applyIndent(-2); break;
                  case 'color': foreColorEl?.click(); break;
                  case 'highlight': backColorEl?.click(); break;
                  case 'link': { const url = window.prompt('Link URL (include https://)'); if (url) exec('createLink', url); break; }
                  case 'image': inlineFileEl?.click(); break;
                  case 'video': {
                    const url = window.prompt('YouTube or Vimeo URL');
                    if (!url) break;
                    const html = videoEmbedHtml(url.trim());
                    if (!html) { window.alert('Could not read that URL — paste a YouTube or Vimeo video link.'); break; }
                    exec('insertHTML', `${html}<p><br></p>`);
                    break;
                  }
                  case 'hr': exec('insertHorizontalRule'); break;
                  case 'clear': exec('removeFormat'); break;
                  case 'source': toggleSource(); break;
                }
              });
            });

            // ── Toolbar dropdowns + color inputs ──────────────────────────
            const fontSelEl = $<HTMLSelectElement>('tb-font');
            const sizeSelEl = $<HTMLSelectElement>('tb-size');
            const blockSelEl = $<HTMLSelectElement>('tb-block');
            const lhSelEl = $<HTMLSelectElement>('tb-lh');
            const foreColorEl = $<HTMLInputElement>('fore-color');
            const backColorEl = $<HTMLInputElement>('back-color');
            const foreChipEl = $('fore-chip');
            const backChipEl = $('back-chip');
            fontSelEl?.addEventListener('change', () => {
              if (fontSelEl.value) exec('fontName', fontSelEl.value);
              fontSelEl.value = '';
            });
            sizeSelEl?.addEventListener('change', () => {
              if (sizeSelEl.value) applyFontSize(sizeSelEl.value);
              sizeSelEl.value = '';
            });
            blockSelEl?.addEventListener('change', () => {
              exec('formatBlock', blockSelEl.value.toUpperCase());
            });
            lhSelEl?.addEventListener('change', () => {
              if (lhSelEl.value) applyLineHeight(lhSelEl.value);
              lhSelEl.value = '';
            });
            foreColorEl?.addEventListener('input', () => {
              exec('foreColor', foreColorEl.value);
              if (foreChipEl) foreChipEl.style.background = foreColorEl.value;
            });
            backColorEl?.addEventListener('input', () => {
              exec('hiliteColor', backColorEl.value);
              if (backChipEl) backChipEl.style.background = backColorEl.value;
            });
            // Mirror the current block's tag into the paragraph-style dropdown.
            function syncBlockSelect() {
              if (!blockSelEl || !savedRange) return;
              let n: Node | null = savedRange.startContainer;
              while (n && n !== bodyEl) {
                if (n.nodeType === 1) {
                  const tag = (n as Element).nodeName.toLowerCase();
                  if (tag === 'h1' || tag === 'h2' || tag === 'h3' || tag === 'h4') { blockSelEl.value = tag; return; }
                }
                n = n.parentNode;
              }
              blockSelEl.value = 'p';
            }

            // ── HTML source view ──────────────────────────────────────────
            const sourceEl = $<HTMLTextAreaElement>('post-source');
            const sourceBtn = $<HTMLButtonElement>('source-btn');
            sourceEl?.addEventListener('input', () => { bodyDirty = true; });
            // Pull textarea HTML back into the editor (publish + toggle paths).
            function syncFromSource() {
              if (!sourceMode || !bodyEl || !sourceEl) return;
              bodyEl.innerHTML = sourceEl.value.trim() || EMPTY_BODY;
              normalizeBlocks();
            }
            function setSourceMode(on: boolean) {
              if (!bodyEl || !sourceEl) return;
              if (on === sourceMode) return;
              if (on) {
                sourceEl.value = bodyEl.innerHTML;
                bodyEl.hidden = true;
                sourceEl.hidden = false;
                sourceEl.focus();
              } else {
                syncFromSource();
                sourceEl.hidden = true;
                bodyEl.hidden = false;
              }
              sourceMode = on;
              sourceBtn?.classList.toggle('is-on', on);
              // Everything except the source toggle is inert while editing raw HTML.
              document.querySelectorAll<HTMLButtonElement>('.toolbar button[data-cmd]').forEach((b) => {
                if (b.dataset.cmd !== 'source') b.disabled = on;
              });
              document.querySelectorAll<HTMLSelectElement>('.toolbar .tb-select').forEach((s) => { s.disabled = on; });
            }
            function toggleSource() { setSourceMode(!sourceMode); }

            // ── Image upload (shared) ─────────────────────────────────────
            async function uploadImage(file: File): Promise<string | null> {
              const fd = new FormData();
              fd.append('file', file);
              const res = await fetch('/api/admin/blog/upload', {
                method: 'POST',
                headers: authHeaders(), // no Content-Type: browser sets the multipart boundary
                body: fd,
              });
              const data = await res.json().catch(() => ({}));
              if (res.ok && data.ok && data.url) return data.url as string;
              throw new Error(data.message ?? data.code ?? `Upload failed (${res.status})`);
            }

            featuredFileEl?.addEventListener('change', async () => {
              const file = featuredFileEl.files?.[0];
              if (!file) return;
              setStatus(featuredStatusEl, 'Uploading…');
              try {
                const url = await uploadImage(file);
                if (!url) throw new Error('No URL returned.');
                if (featuredUrlEl) featuredUrlEl.value = url;
                if (featuredPreviewEl) { featuredPreviewEl.src = url; featuredPreviewEl.hidden = false; }
                setStatus(featuredStatusEl, 'Image uploaded.', 'ok');
              } catch (err) {
                setStatus(featuredStatusEl, err instanceof Error ? err.message : 'Upload failed.', 'err');
              }
            });

            inlineFileEl?.addEventListener('change', async () => {
              const file = inlineFileEl.files?.[0];
              if (!file) return;
              setStatus(formStatusEl, 'Uploading image…');
              try {
                const url = await uploadImage(file);
                if (!url) throw new Error('No URL returned.');
                exec('insertImage', url);
                setStatus(formStatusEl, '', '');
              } catch (err) {
                setStatus(formStatusEl, err instanceof Error ? err.message : 'Image upload failed.', 'err');
              } finally {
                inlineFileEl.value = '';
              }
            });

            // ── Form reset / edit prefill ─────────────────────────────────
            function resetForm() {
              editEpoch++; // invalidate any in-flight prefill fetch
              setSourceMode(false); // leave raw-HTML view before swapping content
              bodyDirty = false;
              bodyIsFallback = false;
              if (postIdEl) postIdEl.value = '';
              if (titleEl) titleEl.value = '';
              if (featuredUrlEl) featuredUrlEl.value = '';
              if (featuredFileEl) featuredFileEl.value = '';
              if (featuredPreviewEl) { featuredPreviewEl.hidden = true; featuredPreviewEl.src = ''; }
              if (bodyEl) bodyEl.innerHTML = EMPTY_BODY;
              setStatus(featuredStatusEl, '');
              if (publishBtn) publishBtn.textContent = 'Publish';
              if (cancelEditBtn) cancelEditBtn.hidden = true;
            }

            cancelEditBtn?.addEventListener('click', () => { resetForm(); setStatus(formStatusEl, ''); showList(); });

            async function startEdit(row: HTMLElement) {
              // Capture the epoch BEFORE the fetch: any later Add/Edit/Back
              // bumps editEpoch and this prefill's response is discarded.
              const epoch = ++editEpoch;
              setSourceMode(false); // leave raw-HTML view before swapping content
              bodyDirty = false;
              bodyIsFallback = false;
              setStatus(listStatusEl, '');
              const id = row.dataset.postId ?? '';
              if (postIdEl) postIdEl.value = id;
              if (titleEl) titleEl.value = row.dataset.title ?? '';
              const imageUrl = row.dataset.imageUrl ?? '';
              if (featuredUrlEl) featuredUrlEl.value = imageUrl;
              if (featuredPreviewEl) {
                if (imageUrl) { featuredPreviewEl.src = imageUrl; featuredPreviewEl.hidden = false; }
                else { featuredPreviewEl.hidden = true; featuredPreviewEl.src = ''; }
              }
              if (bodyEl) bodyEl.innerHTML = EMPTY_BODY;
              setStatus(featuredStatusEl, '');
              if (publishBtn) publishBtn.textContent = 'Update';
              if (cancelEditBtn) cancelEditBtn.hidden = false;
              showEditor();
              titleEl?.focus();

              // The SSR list carries no rawHTML — fetch the full post so the
              // Content box shows the existing body (not blank).
              if (!id || !bodyEl) { setStatus(formStatusEl, ''); return; }
              setStatus(formStatusEl, 'Loading…');
              try {
                const res = await fetch(`/api/admin/blog/${encodeURIComponent(id)}`, { headers: authHeaders() });
                const data = await res.json().catch(() => ({}));
                // Stale response (admin switched posts / clicked Add / went
                // back): don't touch the DOM or status at all.
                if (epoch !== editEpoch) return;
                if (res.ok && data.ok && data.post) {
                  bodyEl.innerHTML = (data.post.rawHTML ?? '') || EMPTY_BODY;
                  // Legacy posts can start with bare root-level text — wrap it
                  // so it behaves like a paragraph while editing.
                  normalizeBlocks();
                  bodyIsFallback = !!data.post.bodyFallback;
                  if (data.post.imageUrl && featuredUrlEl) {
                    featuredUrlEl.value = data.post.imageUrl;
                    if (featuredPreviewEl) { featuredPreviewEl.src = data.post.imageUrl; featuredPreviewEl.hidden = false; }
                  }
                  setStatus(
                    formStatusEl,
                    bodyIsFallback
                      ? 'Showing a short summary — the original body couldn’t be loaded. Editing the content will replace it.'
                      : '',
                  );
                  // Programmatic innerHTML doesn't fire 'input' — make the
                  // freshly-prefilled body explicitly NOT dirty.
                  bodyDirty = false;
                } else {
                  setStatus(formStatusEl, 'Could not load the post body — retype it if you want to change it.', 'err');
                }
              } catch {
                if (epoch !== editEpoch) return;
                setStatus(formStatusEl, 'Could not load the post body — retype it if you want to change it.', 'err');
              }
            }

            // ── Publish / update ──────────────────────────────────────────
            publishBtn?.addEventListener('click', async () => {
              const id = postIdEl?.value ?? '';
              const title = (titleEl?.value ?? '').trim();
              // Normalize before serializing: raw-HTML edits sync back first,
              // bare root-level text gets wrapped in <p>, and a body that is
              // only the empty seed paragraph serializes to '' (so the "write
              // the post body" check fires).
              syncFromSource();
              normalizeBlocks();
              const rawHTML = isBodyEmpty() ? '' : (bodyEl?.innerHTML ?? '').trim();
              const imageUrl = featuredUrlEl?.value ?? '';
              const isEditing = !!id;

              if (!title) { setStatus(formStatusEl, 'Please add a title.', 'err'); return; }
              if (!isEditing && !rawHTML) { setStatus(formStatusEl, 'Please write the post body.', 'err'); return; }
              if (!isEditing && !imageUrl) { setStatus(formStatusEl, 'Please add a featured image.', 'err'); return; }

              publishBtn.disabled = true;
              setStatus(formStatusEl, isEditing ? 'Updating…' : 'Publishing…');
              try {
                let res: Response;
                if (isEditing) {
                  const body: Record<string, string> = { title };
                  // Only send the body if the admin actually edited it. An
                  // untouched prefill (especially a bodyFallback summary) is
                  // never re-sent, so it can't overwrite the real stored body.
                  if (bodyDirty && rawHTML) body.rawHTML = rawHTML;
                  if (imageUrl) body.imageUrl = imageUrl;
                  res = await fetch(`/api/admin/blog/${encodeURIComponent(id)}`, {
                    method: 'PUT', headers: authHeaders({ 'Content-Type': 'application/json' }), body: JSON.stringify(body),
                  });
                } else {
                  res = await fetch('/api/admin/blog', {
                    method: 'POST', headers: authHeaders({ 'Content-Type': 'application/json' }), body: JSON.stringify({ title, rawHTML, imageUrl }),
                  });
                }
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.ok) throw new Error(data.message ?? data.code ?? `Request failed (${res.status})`);

                if (isEditing) {
                  const row = postListEl?.querySelector<HTMLElement>(`[data-post-id="${cssEscape(id)}"]`);
                  if (row) {
                    row.dataset.title = title;
                    if (imageUrl) row.dataset.imageUrl = imageUrl;
                    const titleSpan = row.querySelector('.post-title');
                    if (titleSpan) titleSpan.textContent = title;
                  }
                } else {
                  if (!data.id) {
                    // Created, but no id came back — a hand-built row would be
                    // a ghost (edit/delete can't target it). Reload to refetch
                    // the real list; the token survives (it's in the URL).
                    window.location.reload();
                    return;
                  }
                  addPostRow({ id: data.id as string, title, slug: (data.slug as string) ?? '', imageUrl });
                }
                resetForm();
                setStatus(formStatusEl, '');
                showList();
                // Confirmation goes to the LIST view's status line — the
                // topbar status is inside the (now hidden) editor view.
                if (data.bodyPersisted === false) {
                  setStatus(listStatusEl, 'Saved, but the post body could not be stored — it may display a short summary. Try updating again.', 'err');
                } else {
                  setStatus(listStatusEl, isEditing ? 'Post updated.' : 'Post published.', 'ok');
                }
              } catch (err) {
                setStatus(formStatusEl, err instanceof Error ? err.message : 'Something went wrong.', 'err');
              } finally {
                publishBtn.disabled = false;
              }
            });

            // ── Delete (archive) ──────────────────────────────────────────
            async function deletePost(row: HTMLElement) {
              const id = row.dataset.postId ?? '';
              if (!id) return;
              const title = row.dataset.title ?? 'this post';
              if (!window.confirm(`Delete "${title}"? This removes it from the website.`)) return;
              const delBtn = row.querySelector<HTMLButtonElement>('[data-delete]');
              if (delBtn) delBtn.disabled = true;
              try {
                const res = await fetch(`/api/admin/blog/${encodeURIComponent(id)}`, { method: 'DELETE', headers: authHeaders() });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.ok) throw new Error(data.message ?? data.code ?? `Delete failed (${res.status})`);
                row.remove();
                ensureEmptyState();
                syncSelectionUI();
                setStatus(listStatusEl, 'Post deleted.', 'ok');
              } catch (err) {
                if (delBtn) delBtn.disabled = false;
                window.alert(err instanceof Error ? err.message : 'Could not delete.');
              }
            }

            // ── Table row helpers ─────────────────────────────────────────
            function cssEscape(s: string): string { return s.replace(/["\\]/g, '\\$&'); }
            function escapeHtml(s: string): string {
              return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
            }
            function fmtDateClient(d: Date): string {
              return d.toLocaleString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
              });
            }
            function bindRow(row: HTMLElement) {
              row.querySelector('[data-edit]')?.addEventListener('click', () => startEdit(row));
              row.querySelector('[data-delete]')?.addEventListener('click', () => deletePost(row));
              rowCheckbox(row)?.addEventListener('change', syncSelectionUI);
            }
            function addPostRow(p: { id: string; title: string; slug: string; imageUrl: string }) {
              if (!postListEl) return;
              postListEl.querySelector('[data-empty]')?.remove();
              // We don't get blog/author names back from the create call — reuse
              // an existing row's resolved names if present, else fall back to '—'.
              const sample = postListEl.querySelector<HTMLElement>('.post-row');
              const blogName = sample?.dataset.blog || '—';
              const authorName = sample?.dataset.author || '—';
              const tr = document.createElement('tr');
              tr.className = 'post-row';
              tr.dataset.postId = p.id;
              tr.dataset.title = p.title;
              tr.dataset.imageUrl = p.imageUrl;
              tr.dataset.slug = p.slug;
              tr.dataset.blog = blogName;
              tr.dataset.author = authorName;
              const thumb = p.imageUrl
                ? `<img class="thumb" src="${escapeHtml(p.imageUrl)}" alt="" loading="lazy" />`
                : `<span class="thumb ph" aria-hidden="true"></span>`;
              tr.innerHTML = `
                <td class="c-check"><input type="checkbox" class="row-check" aria-label="Select ${escapeHtml(p.title)}" /></td>
                <td>
                  <div class="cell-title">
                    ${thumb}
                    <span style="min-width:0; display:flex; flex-direction:column;">
                      <button type="button" class="t-link post-title" data-edit>${escapeHtml(p.title)}</button>
                      <span class="t-slug">/${escapeHtml(p.slug)}</span>
                    </span>
                  </div>
                </td>
                <td class="col-blog">${escapeHtml(blogName)}</td>
                <td class="col-author">${escapeHtml(authorName)}</td>
                <td class="col-date">${escapeHtml(fmtDateClient(new Date()))}</td>
                <td class="c-act"><button type="button" class="btn btn-small btn-danger" data-delete>Delete</button></td>`;
              postListEl.prepend(tr);
              bindRow(tr);
            }
            function ensureEmptyState() {
              if (!postListEl) return;
              if (!postListEl.querySelector('.post-row')) {
                const tr = document.createElement('tr');
                tr.className = 'empty-row';
                tr.dataset.empty = '';
                tr.innerHTML = `<td colspan="6">No blog posts yet. Click “Add blog post” to write your first one.</td>`;
                postListEl.appendChild(tr);
              }
            }

            postListEl?.querySelectorAll<HTMLElement>('.post-row').forEach(bindRow);
          }
        </script>
      </body>
    </html>
  )
}
