---
/**
 * /admin/blog — internal blog editor, surfaced as a GHL custom menu link
 * (iframe). Deliberately plain: NO BaseLayout (no public Nav/Footer/CTA in an
 * embedded admin tool), but it imports tokens.css so inputs/buttons feel like GB.
 *
 * SSR token gate
 * --------------
 * Reads `t` from the query string and verifies it with verifyAdminToken. If the
 * token is missing/invalid/expired we render a minimal 401 page and stop. The
 * same token is embedded into the page (a JS const) so every client fetch can
 * send it back as the `x-admin-token` header to the /api/admin/blog/* routes.
 *
 * Framing header
 * --------------
 * Astro/Vercel block framing by default. We set a route-scoped CSP frame-ancestors
 * header HERE (in this page's frontmatter, before any early return) rather than
 * via global middleware — global middleware would conflict with the other slices
 * editing this tree. `output: 'server'` is set in astro.config, so mutating
 * Astro.response.headers / Astro.response.status takes effect on the SSR response.
 *
 * Rich-text editor
 * ----------------
 * Lightweight, zero-dependency contenteditable + document.execCommand toolbar
 * (bold, H2, H3, bullet list, link, inline image). Inline images upload through
 * /api/admin/blog/upload and are inserted as <img src=hostedUrl>. The editor's
 * innerHTML is serialized straight to the `rawHTML` field we POST — no extra
 * sanitization layer here (trusted internal authors; the public renderer owns
 * any display-side hardening). Documented choice: execCommand is deprecated but
 * universally supported and avoids shipping a WYSIWYG bundle for a tool that a
 * single admin uses occasionally.
 */
import { verifyAdminToken } from '../../../lib/admin-token';
import { listPublishedPosts, type BlogPostSummary } from '../../../lib/ghl-blog';
import '../../../styles/tokens.css';

// Allow GHL to iframe this page. Must be set before any early return so the
// 401 response is also frameable inside the GHL admin shell.
Astro.response.headers.set(
  'Content-Security-Policy',
  'frame-ancestors https://*.gohighlevel.com https://*.leadconnectorhq.com https://app.gohighlevel.com',
);

const t = Astro.url.searchParams.get('t');
const v = t ? verifyAdminToken(t) : { ok: false as const };

// Initial post list (SSR) — only fetched when authed. Degrades to [] on failure
// (listPublishedPosts already serves last-good cache / empty on GHL errors).
let posts: BlogPostSummary[] = [];
if (v.ok) {
  try {
    posts = await listPublishedPosts({ limit: 50 });
  } catch {
    posts = [];
  }
}

if (!v.ok) {
  Astro.response.status = 401;
}

// Styles for the minimal 401 page.
const DENIED_STYLES = `
  body { font-family: var(--font-sans); background: var(--gb-bg-light); color: var(--gb-text);
         display: grid; place-items: center; min-height: 100vh; margin: 0; padding: 1.5rem; }
  .card { background: var(--gb-white); border-radius: 12px; padding: 2rem 2.25rem; max-width: 26rem;
          text-align: center; box-shadow: 0 1px 3px rgba(0,0,0,.12); }
  h1 { color: var(--gb-navy); font-size: 1.25rem; margin: 0 0 .5rem; }
  p { color: var(--gb-text-muted); margin: 0; font-size: .95rem; }
`;

// Styles for the authed editor. Modeled on Shopify's admin (Polaris): neutral
// gray canvas, white cards with hairline borders, a sticky save bar, and a
// two-column content/sidebar layout. Internal tool — intentionally NOT GB-branded.
const STYLES = `
  * { box-sizing: border-box; }
  :root {
    --p-bg: #f1f1f1;
    --p-surface: #ffffff;
    --p-border: #e3e3e3;
    --p-border-strong: #8a8a8a;
    --p-text: #303030;
    --p-subdued: #616161;
    --p-focus: #005bd3;
    --p-primary: #303030;
    --p-primary-hover: #1a1a1a;
    --p-critical: #e51c00;
    --p-success: #0a7c3e;
    --p-radius: 12px;
    --p-radius-sm: 8px;
    --p-shadow: 0 1px 0 rgba(0,0,0,.05);
  }
  body {
    font-family: var(--font-sans, 'Inter', system-ui, -apple-system, sans-serif);
    background: var(--p-bg);
    color: var(--p-text);
    margin: 0;
    padding: 0 0 4rem;
    line-height: 1.5;
    font-size: 14px;
    -webkit-font-smoothing: antialiased;
  }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* Sticky save bar */
  .topbar { position: sticky; top: 0; z-index: 10; background: var(--p-surface); border-bottom: 1px solid var(--p-border); }
  .topbar-inner { max-width: 1000px; margin: 0 auto; padding: .6rem 1rem; display: flex; align-items: center; gap: .75rem; }
  .topbar h1 { font-size: 1rem; font-weight: 650; margin: 0; color: var(--p-text); }
  .topbar .spacer { flex: 1; }

  .page { max-width: 1000px; margin: 0 auto; padding: 1.25rem 1rem 0; }
  .grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 860px) { .grid { grid-template-columns: minmax(0,2fr) minmax(0,1fr); align-items: start; } }
  .col-side { display: grid; gap: 1rem; }

  .card { background: var(--p-surface); border: 1px solid var(--p-border); border-radius: var(--p-radius); box-shadow: var(--p-shadow); padding: 1rem 1.25rem 1.25rem; }
  .card h2 { font-size: .8125rem; font-weight: 650; margin: 0 0 .85rem; color: var(--p-text); }

  .field { margin-bottom: 1rem; }
  .field:last-child { margin-bottom: 0; }
  .field label { display: block; font-weight: 500; font-size: .8125rem; margin-bottom: .35rem; color: var(--p-text); }
  .hint { font-size: .8rem; color: var(--p-subdued); margin: .45rem 0 0; }
  .hint.is-ok { color: var(--p-success); }
  .hint.is-err { color: var(--p-critical); }

  input[type="text"] { width: 100%; height: 36px; padding: 0 .7rem; border: 1px solid var(--p-border-strong); border-radius: var(--p-radius-sm); font: inherit; color: var(--p-text); background: var(--p-surface); }
  input[type="file"] { font: inherit; font-size: .82rem; max-width: 100%; }
  input[type="text"]:focus, input[type="file"]:focus-visible, .editor:focus { outline: none; border-color: var(--p-focus); box-shadow: 0 0 0 2px rgba(0,91,211,.25); }
  .preview { display: block; margin-top: .65rem; width: 100%; max-height: 180px; object-fit: cover; border-radius: var(--p-radius-sm); border: 1px solid var(--p-border); }

  /* Rich-text content box (toolbar joined to editor) */
  .toolbar { display: flex; flex-wrap: wrap; gap: .2rem; padding: .35rem; border: 1px solid var(--p-border-strong); border-bottom: 0; border-radius: var(--p-radius-sm) var(--p-radius-sm) 0 0; background: #fafafa; }
  .toolbar button { font: inherit; font-size: .8rem; line-height: 1; padding: .4rem .55rem; border: 1px solid transparent; border-radius: 6px; background: transparent; color: var(--p-text); cursor: pointer; }
  .toolbar button:hover { background: #ececec; }
  .toolbar button:focus-visible { outline: 2px solid var(--p-focus); outline-offset: 1px; }
  .editor { min-height: 300px; padding: .85rem; border: 1px solid var(--p-border-strong); border-radius: 0 0 var(--p-radius-sm) var(--p-radius-sm); background: var(--p-surface); overflow-y: auto; }
  .editor h2 { font-size: 1.3rem; margin: .75rem 0 .4rem; }
  .editor h3 { font-size: 1.1rem; margin: .6rem 0 .35rem; }
  .editor a { color: var(--p-focus); }
  .editor img { max-width: 100%; height: auto; border-radius: 6px; }
  .editor ul { padding-left: 1.4rem; }

  /* Buttons */
  .btn { font: inherit; font-size: .85rem; font-weight: 550; cursor: pointer; border: 1px solid transparent; border-radius: var(--p-radius-sm); padding: 0 .9rem; height: 34px; display: inline-flex; align-items: center; justify-content: center; }
  .btn:disabled { opacity: .55; cursor: not-allowed; }
  .btn-primary { background: var(--p-primary); color: #fff; }
  .btn-primary:hover:not(:disabled) { background: var(--p-primary-hover); }
  .btn-ghost { background: var(--p-surface); border-color: var(--p-border-strong); color: var(--p-text); }
  .btn-ghost:hover:not(:disabled) { background: #f7f7f7; }
  .btn-small { height: 30px; padding: 0 .7rem; font-size: .8rem; background: var(--p-surface); border-color: var(--p-border-strong); color: var(--p-text); }
  .btn-small:hover:not(:disabled) { background: #f7f7f7; }
  .btn-danger { color: var(--p-critical); border-color: var(--p-border-strong); }
  .btn-danger:hover:not(:disabled) { background: #fbeae5; border-color: var(--p-critical); }
  .btn:focus-visible { outline: 2px solid var(--p-focus); outline-offset: 2px; }

  .status { margin: 0; font-size: .85rem; }
  .status.is-ok { color: var(--p-success); }
  .status.is-err { color: var(--p-critical); }

  /* Sidebar bits */
  .badge { display: inline-flex; align-items: center; gap: .45rem; font-size: .8rem; font-weight: 550; color: var(--p-success); }
  .badge .dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--p-success); }
  .side-note { font-size: .8rem; color: var(--p-subdued); margin: .5rem 0 0; }

  /* Posts list (Shopify index rows) */
  .posts-card { margin-top: 1rem; }
  .post-list { list-style: none; margin: 0; padding: 0; }
  .post-list .empty { color: var(--p-subdued); font-size: .9rem; padding: .75rem 0; }
  .post-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .7rem .25rem; border-top: 1px solid var(--p-border); }
  .post-row:first-child { border-top: 0; }
  .post-meta { min-width: 0; display: flex; flex-direction: column; }
  .post-title { font-weight: 550; color: var(--p-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .post-slug { font-size: .78rem; color: var(--p-subdued); }
  .post-actions { display: flex; gap: .4rem; flex-shrink: 0; }
`;
---

{
  !v.ok ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex,nofollow" />
        <title>Access denied</title>
        <style set:html={DENIED_STYLES} />
      </head>
      <body>
        <div class="card">
          <h1>Access denied</h1>
          <p>This link is invalid or expired.</p>
        </div>
      </body>
    </html>
  ) : (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex,nofollow" />
        <title>Blog editor</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        />
        <style set:html={STYLES} />
      </head>
      <body>
        {/* Token embedded for client fetches → sent as x-admin-token header. */}
        <div id="admin-root" data-admin-token={t}>
          {/* ── Sticky save bar (Shopify contextual bar) ───────────────── */}
          <header class="topbar">
            <div class="topbar-inner">
              <h1>Blog posts</h1>
              <span class="spacer"></span>
              <p class="status" id="form-status" role="status" aria-live="polite"></p>
              <button type="button" id="cancel-edit-btn" class="btn btn-ghost" hidden>Discard</button>
              <button type="button" id="publish-btn" class="btn btn-primary">Publish</button>
            </div>
          </header>

          <div class="page">
            <div class="grid">
              {/* ── Main column: title + content ───────────────────────── */}
              <div class="col-main">
                <section class="card" aria-labelledby="editor-heading">
                  <h2 id="editor-heading" class="visually-hidden">Post editor</h2>

                  {/* Hidden id field — set when editing an existing post. */}
                  <input type="hidden" id="post-id" value="" />

                  <div class="field">
                    <label for="post-title">Title</label>
                    <input id="post-title" type="text" maxlength="300" placeholder="e.g. 5 Benefits of Brazilian Jiu-Jitsu for Kids" autocomplete="off" />
                  </div>

                  <div class="field">
                    <label for="post-body">Content</label>
                    <div class="toolbar" role="toolbar" aria-label="Formatting" aria-controls="post-body">
                      <button type="button" data-cmd="bold" title="Bold" aria-label="Bold"><b>B</b></button>
                      <button type="button" data-cmd="h2" title="Heading" aria-label="Heading 2">H2</button>
                      <button type="button" data-cmd="h3" title="Subheading" aria-label="Heading 3">H3</button>
                      <button type="button" data-cmd="ul" title="Bullet list" aria-label="Bullet list">• List</button>
                      <button type="button" data-cmd="link" title="Insert link" aria-label="Insert link">Link</button>
                      <button type="button" data-cmd="image" title="Insert image" aria-label="Insert image">Image</button>
                    </div>
                    <div id="post-body" class="editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Post body"></div>
                    {/* Hidden file input the toolbar's Image button triggers. */}
                    <input type="file" id="inline-file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" hidden />
                  </div>
                </section>
              </div>

              {/* ── Sidebar: visibility + featured image ───────────────── */}
              <aside class="col-side">
                <section class="card">
                  <h2>Visibility</h2>
                  <span class="badge"><span class="dot"></span> Visible on website</span>
                  <p class="side-note">Saving publishes the post to the website right away.</p>
                </section>

                <section class="card">
                  <h2>Featured image</h2>
                  <div class="field">
                    <label for="featured-file" class="visually-hidden">Featured image</label>
                    <input id="featured-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" />
                    <p class="hint" id="featured-status" aria-live="polite"></p>
                    <img id="featured-preview" class="preview" alt="" hidden />
                    {/* Holds the hosted GHL media URL returned by the upload route. */}
                    <input type="hidden" id="featured-url" value="" />
                  </div>
                </section>
              </aside>
            </div>

            {/* ── Existing posts (Shopify index rows) ──────────────────── */}
            <section class="card posts-card" aria-labelledby="posts-heading">
              <h2 id="posts-heading">Published posts</h2>
              <ul class="post-list" id="post-list">
                {posts.length === 0 ? (
                  <li class="empty" data-empty>No posts published yet.</li>
                ) : (
                  posts.map((p) => (
                    <li
                      class="post-row"
                      data-post-id={p.id}
                      data-title={p.title}
                      data-image-url={p.imageUrl}
                      data-description={p.description}
                      data-image-alt={p.imageAltText}
                      data-slug={p.slug}
                    >
                      <div class="post-meta">
                        <span class="post-title">{p.title}</span>
                        <span class="post-slug">/{p.slug}</span>
                      </div>
                      <div class="post-actions">
                        <button type="button" class="btn btn-small" data-edit>Edit</button>
                        <button type="button" class="btn btn-small btn-danger" data-delete>Delete</button>
                      </div>
                    </li>
                  ))
                )}
              </ul>
            </section>
          </div>
        </div>

        <script>
          // ─── /admin/blog client controller ──────────────────────────────
          // Editing the body uses a contenteditable + execCommand toolbar (see
          // the frontmatter comment for why). The token comes from the page's
          // data-admin-token attr and rides on every API call as x-admin-token.

          const root = document.getElementById('admin-root');
          if (root) {
            const token = root.dataset.adminToken ?? '';

            const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
              document.getElementById(id) as T | null;

            const postIdEl = $<HTMLInputElement>('post-id');
            const titleEl = $<HTMLInputElement>('post-title');
            const featuredFileEl = $<HTMLInputElement>('featured-file');
            const featuredStatusEl = $('featured-status');
            const featuredPreviewEl = $<HTMLImageElement>('featured-preview');
            const featuredUrlEl = $<HTMLInputElement>('featured-url');
            const bodyEl = $('post-body');
            const inlineFileEl = $<HTMLInputElement>('inline-file');
            const publishBtn = $<HTMLButtonElement>('publish-btn');
            const cancelEditBtn = $<HTMLButtonElement>('cancel-edit-btn');
            const formStatusEl = $('form-status');
            const postListEl = $('post-list');

            // ── Helpers ───────────────────────────────────────────────────
            function authHeaders(extra: Record<string, string> = {}): Record<string, string> {
              return { 'x-admin-token': token, ...extra };
            }

            function setStatus(el: HTMLElement | null, msg: string, kind: 'ok' | 'err' | '' = '') {
              if (!el) return;
              el.textContent = msg;
              el.classList.remove('is-ok', 'is-err');
              if (kind === 'ok') el.classList.add('is-ok');
              if (kind === 'err') el.classList.add('is-err');
            }

            // ── Rich-text toolbar ─────────────────────────────────────────
            function exec(command: string, value?: string) {
              bodyEl?.focus();
              document.execCommand(command, false, value);
            }

            document.querySelectorAll<HTMLButtonElement>('.toolbar button[data-cmd]').forEach((btn) => {
              btn.addEventListener('click', (e) => {
                e.preventDefault();
                const cmd = btn.dataset.cmd;
                switch (cmd) {
                  case 'bold': exec('bold'); break;
                  case 'h2': exec('formatBlock', 'H2'); break;
                  case 'h3': exec('formatBlock', 'H3'); break;
                  case 'ul': exec('insertUnorderedList'); break;
                  case 'link': {
                    const url = window.prompt('Link URL (include https://)');
                    if (url) exec('createLink', url);
                    break;
                  }
                  case 'image':
                    inlineFileEl?.click();
                    break;
                }
              });
            });

            // ── Image upload (shared) ─────────────────────────────────────
            async function uploadImage(file: File): Promise<string | null> {
              const fd = new FormData();
              fd.append('file', file);
              const res = await fetch('/api/admin/blog/upload', {
                method: 'POST',
                headers: authHeaders(), // do NOT set Content-Type; the browser adds the multipart boundary
                body: fd,
              });
              const data = await res.json().catch(() => ({}));
              if (res.ok && data.ok && data.url) return data.url as string;
              throw new Error(data.message ?? data.code ?? `Upload failed (${res.status})`);
            }

            // Featured image
            featuredFileEl?.addEventListener('change', async () => {
              const file = featuredFileEl.files?.[0];
              if (!file) return;
              setStatus(featuredStatusEl, 'Uploading…');
              try {
                const url = await uploadImage(file);
                if (!url) throw new Error('No URL returned.');
                if (featuredUrlEl) featuredUrlEl.value = url;
                if (featuredPreviewEl) {
                  featuredPreviewEl.src = url;
                  featuredPreviewEl.hidden = false;
                }
                setStatus(featuredStatusEl, 'Image uploaded.', 'ok');
              } catch (err) {
                setStatus(featuredStatusEl, err instanceof Error ? err.message : 'Upload failed.', 'err');
              }
            });

            // Inline (body) image
            inlineFileEl?.addEventListener('change', async () => {
              const file = inlineFileEl.files?.[0];
              if (!file) return;
              setStatus(formStatusEl, 'Uploading image…');
              try {
                const url = await uploadImage(file);
                if (!url) throw new Error('No URL returned.');
                exec('insertImage', url);
                setStatus(formStatusEl, '', '');
              } catch (err) {
                setStatus(formStatusEl, err instanceof Error ? err.message : 'Image upload failed.', 'err');
              } finally {
                inlineFileEl.value = '';
              }
            });

            // ── Form reset / edit prefill ─────────────────────────────────
            function resetForm() {
              if (postIdEl) postIdEl.value = '';
              if (titleEl) titleEl.value = '';
              if (featuredUrlEl) featuredUrlEl.value = '';
              if (featuredFileEl) featuredFileEl.value = '';
              if (featuredPreviewEl) { featuredPreviewEl.hidden = true; featuredPreviewEl.src = ''; }
              if (bodyEl) bodyEl.innerHTML = '';
              setStatus(featuredStatusEl, '');
              if (publishBtn) publishBtn.textContent = 'Publish';
              if (cancelEditBtn) cancelEditBtn.hidden = true;
            }

            cancelEditBtn?.addEventListener('click', () => {
              resetForm();
              setStatus(formStatusEl, '');
            });

            function startEdit(row: HTMLElement) {
              if (postIdEl) postIdEl.value = row.dataset.postId ?? '';
              if (titleEl) titleEl.value = row.dataset.title ?? '';
              const imageUrl = row.dataset.imageUrl ?? '';
              if (featuredUrlEl) featuredUrlEl.value = imageUrl;
              if (featuredPreviewEl) {
                if (imageUrl) { featuredPreviewEl.src = imageUrl; featuredPreviewEl.hidden = false; }
                else { featuredPreviewEl.hidden = true; }
              }
              // NOTE: the SSR list (listPublishedPosts) returns summaries without
              // rawHTML, so the body starts empty on edit — re-author the body or
              // leave it untouched (an empty body would clear it, so we guard the
              // PUT below to only send rawHTML when the editor has content).
              if (bodyEl) bodyEl.innerHTML = '';
              setStatus(featuredStatusEl, '');
              if (publishBtn) publishBtn.textContent = 'Update';
              if (cancelEditBtn) cancelEditBtn.hidden = false;
              window.scrollTo({ top: 0, behavior: 'smooth' });
              titleEl?.focus();
            }

            // ── Publish / update ──────────────────────────────────────────
            publishBtn?.addEventListener('click', async () => {
              const id = postIdEl?.value ?? '';
              const title = (titleEl?.value ?? '').trim();
              const rawHTML = (bodyEl?.innerHTML ?? '').trim();
              const imageUrl = featuredUrlEl?.value ?? '';
              const isEditing = !!id;

              if (!title) { setStatus(formStatusEl, 'Please add a title.', 'err'); return; }
              if (!isEditing && !rawHTML) { setStatus(formStatusEl, 'Please write the post body.', 'err'); return; }
              if (!isEditing && !imageUrl) { setStatus(formStatusEl, 'Please add a featured image.', 'err'); return; }

              publishBtn.disabled = true;
              setStatus(formStatusEl, isEditing ? 'Updating…' : 'Publishing…');

              try {
                let res: Response;
                if (isEditing) {
                  // Only send fields the editor actually has, so an untouched
                  // body/image on edit doesn't wipe the stored content.
                  const body: Record<string, string> = { title };
                  if (rawHTML) body.rawHTML = rawHTML;
                  if (imageUrl) body.imageUrl = imageUrl;
                  res = await fetch(`/api/admin/blog/${encodeURIComponent(id)}`, {
                    method: 'PUT',
                    headers: authHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify(body),
                  });
                } else {
                  res = await fetch('/api/admin/blog', {
                    method: 'POST',
                    headers: authHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({ title, rawHTML, imageUrl }),
                  });
                }
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.ok) {
                  throw new Error(data.message ?? data.code ?? `Request failed (${res.status})`);
                }
                setStatus(formStatusEl, isEditing ? 'Post updated.' : 'Post published.', 'ok');
                resetForm();
                // Reflect the change in the list without a full reload.
                if (isEditing) {
                  const row = postListEl?.querySelector<HTMLElement>(`[data-post-id="${cssEscape(id)}"]`);
                  if (row) {
                    row.dataset.title = title;
                    if (imageUrl) row.dataset.imageUrl = imageUrl;
                    const titleSpan = row.querySelector('.post-title');
                    if (titleSpan) titleSpan.textContent = title;
                  }
                } else {
                  addPostRow({ id: data.id as string, title, slug: (data.slug as string) ?? '', imageUrl });
                }
              } catch (err) {
                setStatus(formStatusEl, err instanceof Error ? err.message : 'Something went wrong.', 'err');
              } finally {
                publishBtn.disabled = false;
              }
            });

            // ── Delete (archive) ──────────────────────────────────────────
            async function deletePost(row: HTMLElement) {
              const id = row.dataset.postId ?? '';
              if (!id) return;
              const title = row.dataset.title ?? 'this post';
              if (!window.confirm(`Delete "${title}"? This removes it from the website.`)) return;

              const delBtn = row.querySelector<HTMLButtonElement>('[data-delete]');
              if (delBtn) delBtn.disabled = true;
              try {
                const res = await fetch(`/api/admin/blog/${encodeURIComponent(id)}`, {
                  method: 'DELETE',
                  headers: authHeaders(),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.ok) throw new Error(data.message ?? data.code ?? `Delete failed (${res.status})`);
                row.remove();
                ensureEmptyState();
                setStatus(formStatusEl, 'Post deleted.', 'ok');
              } catch (err) {
                if (delBtn) delBtn.disabled = false;
                setStatus(formStatusEl, err instanceof Error ? err.message : 'Could not delete.', 'err');
              }
            }

            // ── Post-list DOM helpers ─────────────────────────────────────
            function cssEscape(s: string): string {
              return s.replace(/["\\]/g, '\\$&');
            }

            function escapeHtml(s: string): string {
              return s.replace(/[&<>"']/g, (c) =>
                ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!),
              );
            }

            function bindRow(row: HTMLElement) {
              row.querySelector('[data-edit]')?.addEventListener('click', () => startEdit(row));
              row.querySelector('[data-delete]')?.addEventListener('click', () => deletePost(row));
            }

            function addPostRow(p: { id: string; title: string; slug: string; imageUrl: string }) {
              if (!postListEl) return;
              postListEl.querySelector('[data-empty]')?.remove();
              const li = document.createElement('li');
              li.className = 'post-row';
              li.dataset.postId = p.id;
              li.dataset.title = p.title;
              li.dataset.imageUrl = p.imageUrl;
              li.dataset.slug = p.slug;
              li.innerHTML = `
                <div class="post-meta">
                  <span class="post-title">${escapeHtml(p.title)}</span>
                  <span class="post-slug">/${escapeHtml(p.slug)}</span>
                </div>
                <div class="post-actions">
                  <button type="button" class="btn btn-small" data-edit>Edit</button>
                  <button type="button" class="btn btn-small btn-danger" data-delete>Delete</button>
                </div>`;
              postListEl.prepend(li);
              bindRow(li);
            }

            function ensureEmptyState() {
              if (!postListEl) return;
              if (!postListEl.querySelector('.post-row')) {
                const li = document.createElement('li');
                li.className = 'empty';
                li.dataset.empty = '';
                li.textContent = 'No posts published yet.';
                postListEl.appendChild(li);
              }
            }

            // Bind existing SSR-rendered rows.
            postListEl?.querySelectorAll<HTMLElement>('.post-row').forEach(bindRow);
          }
        </script>
      </body>
    </html>
  )
}
