---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaLocalBusiness from '../components/seo/SchemaLocalBusiness.astro';
import CTAButton from '../components/cta/CTAButton.astro';
import OptInForm from '../components/form/OptInForm.astro';
import FAQ from '../components/faq/FAQ.astro';
import { homepageFaqs } from '../content/faqs';
import { reviews } from '../content/reviews';
import { nap } from '../content/nap';

import homepageHero from '../assets/images/home/homepage-hero-girl.jpg';
import programCardKids from '../assets/images/home/program-card-kids.png';
import programCardAdults from '../assets/images/home/program-card-adults.png';

const galleryImages = [
  { src: '/images/home/gallery/kids-1.jpg', alt: 'Kids Brazilian Jiu-Jitsu class at Gracie Barra Whittier' },
  { src: '/images/home/gallery/adults-1.jpg', alt: 'Adult Brazilian Jiu-Jitsu training at Gracie Barra Whittier' },
  { src: '/images/home/gallery/kids-2.jpg', alt: 'Little Champions class at Gracie Barra Whittier' },
  { src: '/images/home/gallery/adults-2.jpg', alt: 'Adult BJJ Fundamentals class at Gracie Barra Whittier' },
  { src: '/images/home/gallery/kids-3.jpg', alt: 'Junior students training Jiu-Jitsu at Gracie Barra Whittier' },
  { src: '/images/home/gallery/adults-3.jpg', alt: 'Brazilian Jiu-Jitsu sparring at Gracie Barra Whittier' },
  { src: '/images/home/gallery/kids-4.jpg', alt: 'Kids martial arts class at Gracie Barra Whittier' },
  { src: '/images/home/gallery/adults-4.jpg', alt: 'Adult BJJ technique drilling at Gracie Barra Whittier' },
  { src: '/images/home/gallery/team-1.jpg', alt: 'Gracie Barra Whittier team and academy community' },
];

const stats = [
  { value: '1000+', label: 'Schools Worldwide' },
  { value: '400K+', label: 'Students Trained' },
  { value: '35+', label: 'Years of Excellence' },
  { value: '100%', label: 'Certified Black Belt Instructors' },
];

const benefits = [
  {
    title: 'Safe, Structured Environment',
    body: 'Every class is supervised, age-grouped, and built around control and respect. No striking. No ego. Just structured technique.',
    icon: 'shield',
  },
  {
    title: 'Certified Gracie Barra Instructors',
    body: 'Every instructor — including Professor Eric and Professor Phil — is certified through the official Gracie Barra curriculum.',
    icon: 'badge',
  },
  {
    title: 'Proven World-Class Curriculum',
    body: 'The same Gracie Barra curriculum used in 1000+ academies worldwide. Beginner-friendly, technique-first, scalable to every level.',
    icon: 'chart',
  },
  {
    title: 'Welcoming, Supportive Community',
    body: 'Families across Whittier, La Habra, La Mirada, and Pico Rivera train here. The vibe on the mat is welcoming, professional, and ego-free.',
    icon: 'people',
  },
];
---

<BaseLayout
  title="BJJ Classes in Whittier, CA"
  description="Brazilian Jiu-Jitsu classes in Whittier, CA for kids and adults. World-class Gracie Barra curriculum. Claim your free 3-class pass — no risk, no contracts."
  canonical="https://gbwhittier.com/"
>
  {/* ============================================================
     SECTION 2 — HERO (full-bleed background image)
     ============================================================ */}
  <section class="relative isolate overflow-hidden bg-gb-navy">
    {/* Full-bleed background image */}
    <Image
      src={homepageHero}
      alt="Young student smiling in a blue Gracie Barra gi at Gracie Barra Whittier, Whittier, CA"
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      format="webp"
      quality={82}
      loading="eager"
      class="absolute inset-0 -z-10 w-full h-full object-cover object-[center_30%]"
    />

    {/* Readability overlay — dark on left (text), lighter middle (subject visible),
        dark again on right (card sits on solid area instead of over the subject). */}
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-gb-navy/90 via-gb-navy/35 to-gb-navy/85"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-gb-navy/80 via-transparent to-transparent md:hidden"></div>

    <div class="max-w-7xl mx-auto px-4 md:px-6 pt-8 md:pt-12 pb-16 md:pb-24 lg:pb-28 lg:min-h-[560px] grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-7 text-gb-white">
        <div class="flex items-center gap-3 mb-7 md:mb-10">
          <img
            src="/logo/gb-whittier-logo.webp"
            alt=""
            aria-hidden="true"
            class="w-12 h-12 md:w-14 md:h-14 shrink-0"
            width="56"
            height="56"
          />
          <span class="text-xs md:text-sm font-bold tracking-wide uppercase text-gb-white/90">
            #1 In Jiu-Jitsu Worldwide
          </span>
        </div>

        <p class="text-xs md:text-sm font-bold tracking-widest uppercase text-gb-gold mb-4">
          Brazilian Jiu-Jitsu Classes in Whittier, CA for Kids and Adults
        </p>

        <h1 class="sr-only">Brazilian Jiu-Jitsu Classes in Whittier, CA</h1>

        <p aria-hidden="true" class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-gb-white leading-[1.05] mb-5 drop-shadow-lg">
          Build Confidence.<br />Learn Real Self-Defense.
        </p>

        <p class="text-base md:text-lg text-gb-white/90 leading-relaxed mb-7 max-w-xl">
          Structured Brazilian Jiu-Jitsu for kids, teens, and adults. Develop discipline, focus, and strength — on and off the mat.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
          <CTAButton variant="primary" label="Claim My Free 3-Class Pass" href="#trial" />
          <a href={`tel:${nap.phoneTel}`} class="text-sm font-semibold text-gb-white hover:text-gb-gold transition-colors text-center sm:text-left">
            Or call {nap.phone}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="bg-gb-white rounded-2xl shadow-2xl p-5 md:p-6 lg:max-w-sm lg:ml-auto border border-gb-bg-light">
          <p class="text-xs uppercase tracking-widest text-gb-text-muted">Try Our Academy In</p>
          <p class="text-xl font-bold text-gb-navy mt-1">{nap.addressLocality}, {nap.addressRegion}</p>
          <p class="text-sm text-gb-text-muted mt-1 leading-snug">{nap.address}</p>
          <a href={`tel:${nap.phoneTel}`} class="mt-1 inline-block text-sm font-semibold text-gb-navy hover:text-gb-red">
            {nap.phone}
          </a>

          <div class="mt-4 pt-4 border-t border-gb-bg-light">
            <span class="inline-block bg-gb-gold text-gb-navy text-xs font-bold tracking-wider px-3 py-1 rounded-full">
              FREE 3-CLASS PASS
            </span>
            <p class="mt-2 text-sm text-gb-text">Free uniform rental included</p>
            <div class="mt-3">
              <CTAButton variant="primary" label="Claim My Free 3-Class Pass" href="#trial" fullWidth={true} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
     SECTION 3 — INTRO TEXT
     ============================================================ */}
  <section class="bg-gb-white pt-16 lg:pt-24 pb-10 px-4 md:px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-base md:text-lg text-gb-text leading-relaxed">
        Welcome to Gracie Barra Whittier — the most trusted name in Brazilian Jiu-Jitsu, now in your neighborhood. Whether you are bringing your child for their first class or stepping onto the mat yourself, you are joining a community built on respect, technique, and real results. We make it easy to start: 3 classes free, a uniform on the house, and zero pressure.
      </p>
    </div>
  </section>

  {/* ============================================================
     SECTION 4 — OPT-IN FORM
     ============================================================ */}
  <OptInForm
    id="trial"
    header="UNLOCK YOUR FREE 3-CLASS PASS"
    offerLabel="FREE 3-CLASS PASS"
    riskLine="No Risk. No Pressure. Free Uniform Rental Included."
  />

  {/* ============================================================
     SECTION 5 — OUR PROGRAMS
     ============================================================ */}
  <section class="bg-gb-white py-16 md:py-20 px-4 md:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gb-navy">Our Programs</h2>
        <p class="mt-3 text-gb-text-muted max-w-2xl mx-auto">
          Age-specific Brazilian Jiu-Jitsu programs for kids and adults at our Whittier, CA academy.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 md:gap-8">
        <article class="bg-gb-bg-light rounded-2xl overflow-hidden flex flex-col shadow-sm hover:shadow-md transition-shadow">
          <Image
            src={programCardKids}
            alt="Kids martial arts class at Gracie Barra Whittier, CA"
            widths={[480, 768]}
            sizes="(min-width: 768px) 50vw, 100vw"
            format="webp"
            quality={80}
            class="w-full h-56 md:h-64 object-cover"
          />
          <div class="p-6 md:p-8 flex-1 flex flex-col">
            <h3 class="text-2xl font-bold text-gb-navy">Kids Martial Arts</h3>
            <p class="text-sm font-semibold text-gb-text-muted mt-1">Ages 3 to 15</p>
            <p class="mt-3 text-gb-text leading-relaxed flex-1">
              Age-grouped classes that build confidence, focus, and respect. Tiny Champions, Little Champions, and Juniors programs — every class taught by certified Gracie Barra instructors.
            </p>
            <div class="mt-6">
              <CTAButton variant="program" label="Explore Kids Programs" href="/kids-martial-arts" />
            </div>
          </div>
        </article>

        <article class="bg-gb-bg-light rounded-2xl overflow-hidden flex flex-col shadow-sm hover:shadow-md transition-shadow">
          <Image
            src={programCardAdults}
            alt="Adult Brazilian Jiu-Jitsu class at Gracie Barra Whittier, CA"
            widths={[480, 768]}
            sizes="(min-width: 768px) 50vw, 100vw"
            format="webp"
            quality={80}
            class="w-full h-56 md:h-64 object-cover"
          />
          <div class="p-6 md:p-8 flex-1 flex flex-col">
            <h3 class="text-2xl font-bold text-gb-navy">Adults Jiu-Jitsu</h3>
            <p class="text-sm font-semibold text-gb-text-muted mt-1">Ages 16+</p>
            <p class="mt-3 text-gb-text leading-relaxed flex-1">
              Beginner-friendly Brazilian Jiu-Jitsu for fitness, real self-defense, and mental toughness. No experience required — Fundamentals classes scale to every body type.
            </p>
            <div class="mt-6">
              <CTAButton variant="program" label="Explore Adult Classes" href="/adults-jiu-jitsu" />
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* ============================================================
     SECTION 6 — REVIEWS
     ============================================================ */}
  <section class="bg-gb-bg-light py-16 md:py-20 px-4 md:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gb-navy">Real Stories. Real Growth.</h2>
        <p class="mt-3 text-gb-text-muted max-w-2xl mx-auto">
          What students and families across Whittier, La Habra, La Mirada, and Pico Rivera say about training at Gracie Barra Whittier.
        </p>
      </div>

      <div id="reviews-widget" class="bg-gb-white rounded-2xl border border-gb-bg-light p-6 md:p-8 mb-8 text-center text-gb-text-muted">
        {/* LocalCraze widget mounts here when PUBLIC_REVIEWS_EMBED_ID is set */}
        Reviews loading...
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {reviews.map((r) => (
          <article class="bg-gb-white rounded-2xl shadow-sm p-5 md:p-6 flex flex-col">
            <div class="flex gap-0.5 text-gb-gold mb-3" aria-label={`${r.rating} out of 5 stars`}>
              {Array.from({ length: r.rating }).map(() => (
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M9.05 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.364 1.118l1.287 3.957c.3.922-.755 1.688-1.54 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.366 2.446c-.785.57-1.84-.196-1.54-1.118l1.286-3.957a1 1 0 00-.363-1.118L2.073 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.957z" />
                </svg>
              ))}
            </div>
            <p class="text-sm text-gb-text leading-relaxed flex-1">"{r.quote}"</p>
            <div class="mt-4 pt-4 border-t border-gb-bg-light">
              <p class="text-sm font-semibold text-gb-navy">{r.name}</p>
              <p class="text-xs text-gb-text-muted">{r.role}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
     SECTION 7 — WHY GRACIE BARRA WHITTIER
     ============================================================ */}
  <section class="bg-gb-white py-16 md:py-20 px-4 md:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gb-navy">Why Choose Gracie Barra Whittier</h2>
        <p class="mt-3 text-gb-text-muted max-w-2xl mx-auto">
          A world-class Brazilian Jiu-Jitsu academy in Whittier, CA — built around what actually matters.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 md:gap-8">
        {benefits.map((b) => (
          <div class="bg-gb-bg-light rounded-2xl p-6 md:p-8 flex gap-4">
            <div class="shrink-0 w-12 h-12 rounded-full bg-gb-red text-gb-white flex items-center justify-center" aria-hidden="true">
              {b.icon === 'shield' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              )}
              {b.icon === 'badge' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="9" r="6" />
                  <path d="M9 13.5L7 22l5-3 5 3-2-8.5" />
                </svg>
              )}
              {b.icon === 'chart' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v18h18" />
                  <path d="M7 14l4-4 4 4 5-5" />
                </svg>
              )}
              {b.icon === 'people' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M23 21v-2a4 4 0 00-3-3.87" />
                  <path d="M16 3.13a4 4 0 010 7.75" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="text-lg md:text-xl font-bold text-gb-navy">{b.title}</h3>
              <p class="mt-2 text-sm md:text-base text-gb-text leading-relaxed">{b.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
     SECTION 8 — GLOBAL STATS
     ============================================================ */}
  <section class="bg-gb-bg-dark py-14 md:py-20 px-4 md:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-4xl font-bold text-gb-white">A Global Brazilian Jiu-Jitsu Network</h2>
        <p class="mt-3 text-gb-white/80 max-w-2xl mx-auto">Gracie Barra is the world's most trusted BJJ organization.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {stats.map((s) => (
          <div class="bg-gb-navy-dark rounded-2xl p-5 md:p-8 text-center border border-gb-white/10">
            <p class="text-3xl md:text-5xl font-extrabold text-gb-gold">{s.value}</p>
            <p class="mt-2 text-xs md:text-sm font-semibold text-gb-white uppercase tracking-wider">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
     SECTION 9 — PHOTO GALLERY
     ============================================================ */}
  <section class="bg-gb-white py-16 md:py-20 px-4 md:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gb-navy">Inside Our Whittier Academy</h2>
        <p class="mt-3 text-gb-text-muted max-w-2xl mx-auto">Real classes, real students, real Brazilian Jiu-Jitsu.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
        {galleryImages.map((g) => (
          <div class="aspect-square overflow-hidden rounded-xl bg-gb-bg-light">
            <img
              src={g.src}
              alt={g.alt}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
     SECTION 10 — FAQ
     ============================================================ */}
  <FAQ items={homepageFaqs} heading="Frequently Asked Questions" />

  {/* ============================================================
     FINAL CTA STRIP
     ============================================================ */}
  <section class="bg-gb-bg-dark py-14 md:py-20 px-4 md:px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gb-white">Ready to Step on the Mat?</h2>
      <p class="mt-4 text-gb-white/80 text-base md:text-lg">
        Try 3 classes free at Gracie Barra Whittier. No risk, no contracts, free uniform rental included.
      </p>
      <div class="mt-7 flex justify-center">
        <CTAButton variant="primary" label="Start My Free Trial" href="#trial" />
      </div>
      <p class="mt-4 text-xs text-gb-white/70">
        Serving Whittier, La Habra, La Mirada, and Pico Rivera.
      </p>
    </div>
  </section>

  <SchemaLocalBusiness />
</BaseLayout>
