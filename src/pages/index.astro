---
export const prerender = true;
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaLocalBusiness from '../components/seo/SchemaLocalBusiness.astro';
import SchemaFAQ from '../components/seo/SchemaFAQ.astro';
import CTAButton from '../components/cta/CTAButton.astro';
import OptInForm from '../components/form/OptInForm.astro';
import { homepageFaqs } from '../content/faqs';
import { nap } from '../content/nap';

import homepageHero from '../assets/images/home/homepage-hero-girl.jpg';
import programCardKids from '../assets/images/home/program-card-kids.png';
import programCardAdults from '../assets/images/home/program-card-adults.png';

const stats = [
  {
    value: '1000+',
    label: 'Schools Worldwide',
    body: 'Part of one of the largest and most trusted Brazilian Jiu-Jitsu networks on the planet.',
    icon: 'globe',
  },
  {
    value: '400,000+',
    label: 'Students Globally',
    body: 'A worldwide community committed to discipline, confidence, and lifelong growth.',
    icon: 'people',
  },
  {
    value: '35+ Years',
    label: 'Proven Curriculum',
    body: 'Founded by Master Carlos Gracie Jr., delivering structured, progressive Jiu-Jitsu since 1986.',
    icon: 'star',
  },
  {
    value: 'Certified',
    label: 'Expert Instructors',
    body: 'Every instructor completes the official Gracie Barra certification program to ensure safe, consistent, high-quality instruction.',
    icon: 'shield',
  },
];

const whyBullets = [
  'Safe, structured, family-first environment',
  'Certified Gracie Barra instructors',
  'Proven curriculum from beginner to advanced',
  'A community that supports growth beyond the mats',
];

const galleryImages = [
  { src: '/images/home/gallery/kids-1.jpg', alt: 'Kids Brazilian Jiu-Jitsu class at Gracie Barra Whittier' },
  { src: '/images/home/gallery/adults-1.jpg', alt: 'Adult Brazilian Jiu-Jitsu training at Gracie Barra Whittier' },
  { src: '/images/home/gallery/kids-2.jpg', alt: 'Little Champions class at Gracie Barra Whittier' },
  { src: '/images/home/gallery/adults-2.jpg', alt: 'Adult BJJ Fundamentals class at Gracie Barra Whittier' },
  { src: '/images/home/gallery/kids-3.jpg', alt: 'Junior students training Jiu-Jitsu at Gracie Barra Whittier' },
  { src: '/images/home/gallery/adults-3.jpg', alt: 'Brazilian Jiu-Jitsu sparring at Gracie Barra Whittier' },
];
---

<BaseLayout
  title="BJJ Classes in Whittier, CA"
  description="Brazilian Jiu-Jitsu classes in Whittier, CA for kids and adults. World-class Gracie Barra curriculum. Claim your free first class — no risk, no contracts."
  canonical="https://gbwhittier.com/"
>
  <div class="bg-gb-bg-light">
    {/* ============================================================
       HERO — rounded card on light gray background
       ============================================================ */}
    <section class="px-4 md:px-6 pt-6 md:pt-8">
      <div class="max-w-7xl mx-auto bg-gb-navy rounded-2xl overflow-hidden relative isolate shadow-lg">
        <Image
          src={homepageHero}
          alt="Young student smiling in a blue Gracie Barra gi at Gracie Barra Whittier, Whittier, CA"
          widths={[768, 1280, 1920]}
          sizes="100vw"
          format="webp"
          quality={82}
          loading="eager"
          class="absolute inset-0 -z-10 w-full h-full object-cover object-[center_30%]"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-gb-navy/95 via-gb-navy/40 to-gb-navy/85"></div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-gb-navy/90 via-transparent to-transparent md:hidden"></div>

        <div class="px-6 md:px-10 lg:px-14 py-10 md:py-16 lg:py-20 grid lg:grid-cols-12 gap-8 lg:gap-12 items-center min-h-[460px]">
          <div class="lg:col-span-7 text-gb-white">
            <div class="flex items-center gap-3 mb-6">
              <img
                src="/logo/gb-whittier-logo.webp"
                alt=""
                aria-hidden="true"
                class="w-10 h-10 md:w-12 md:h-12 shrink-0"
                width="48"
                height="48"
              />
              <span class="text-xs md:text-sm font-semibold tracking-wide uppercase text-gb-white/90">
                #1 In Jiu-Jitsu Worldwide
              </span>
            </div>

            <p class="text-xs md:text-sm font-semibold uppercase text-gb-gold tracking-wide mb-4">
              Brazilian Jiu-Jitsu Classes in Whittier, CA for Kids and Adults
            </p>

            <h1 class="text-base md:text-lg font-semibold text-gb-white/90 mb-3">
              Brazilian Jiu-Jitsu Classes in Whittier, CA
            </h1>
            <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-gb-white leading-[1.05] mb-5">
              Build Confidence.<br />Learn Real Self-Defense.
            </h2>

            <p class="text-sm md:text-base text-gb-white/90 leading-relaxed max-w-xl">
              Structured Brazilian Jiu-Jitsu for kids, teens, and adults. Develop discipline, focus, and strength — on and off the mat.
            </p>
          </div>

          <div class="lg:col-span-5">
            <div class="bg-gb-white rounded-xl shadow-xl p-5 md:p-6 lg:max-w-sm lg:ml-auto">
              <p class="text-xs uppercase tracking-widest text-gb-text-muted">Try Our Academy In</p>
              <p class="text-lg md:text-xl font-bold text-gb-navy mt-1">{nap.addressLocality}, {nap.addressRegion}</p>
              <p class="text-sm text-gb-text-muted mt-1 leading-snug">{nap.address}</p>
              <a href={`tel:${nap.phoneTel}`} class="mt-1 inline-flex items-center gap-1.5 text-sm font-semibold text-gb-navy hover:text-gb-red">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                </svg>
                {nap.phone}
              </a>

              <div class="mt-4 pt-4 border-t border-gb-bg-light">
                <span class="inline-block bg-gb-red/10 text-gb-red text-[11px] font-bold tracking-wider px-3 py-1 rounded-md uppercase">
                  Free 3-Class Pass
                </span>
                <p class="mt-2 text-sm text-gb-text">Free uniform rental included</p>
                <div class="mt-3">
                  <CTAButton variant="primary" label="Claim My Free 3-Class Pass" href="#trial" fullWidth={true} />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================
       START YOUR JIU-JITSU JOURNEY
       ============================================================ */}
    <section class="px-4 md:px-6 py-12 md:py-16">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-4xl font-extrabold text-gb-red">Start Your Jiu-Jitsu Journey</h2>
        <p class="mt-4 text-sm md:text-base text-gb-text-muted leading-relaxed">
          Whether you're brand new or ready to level up, our Brazilian Jiu-Jitsu classes in Whittier are designed to help you build confidence, strength, and real-world self-defense skills. With beginner-friendly instruction and a supportive community, getting started has never been easier.
        </p>
      </div>
    </section>

    {/* ============================================================
       OPT-IN FORM — split image / form layout
       ============================================================ */}
    <OptInForm
      id="trial"
      header="UNLOCK YOUR FREE 3-CLASS PASS"
      subheader="+ VIEW OUR FULL CLASS SCHEDULE INSTANTLY"
      description="Enter your info below to claim your Free 3-Class Pass and access our full class schedule."
      offerLabel="FREE 3-CLASS PASS"
      riskLine="No Risk. No Pressure. Free Uniform Rental Included."
      submitLabel="CLAIM MY FREE 3-CLASS PASS"
      imageSrc="/images/home/gallery/kids-1.jpg"
      imageAlt="Kids Brazilian Jiu-Jitsu class at Gracie Barra Whittier"
    />

    {/* ============================================================
       OUR PROGRAMS
       ============================================================ */}
    <section class="px-4 md:px-6 py-12 md:py-16">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-8 md:mb-10">
          <h2 class="text-2xl md:text-4xl font-extrabold text-gb-navy">Our Programs</h2>
          <p class="mt-3 text-sm md:text-base text-gb-text-muted max-w-2xl mx-auto leading-relaxed">
            Whether you're enrolling your child or starting your own journey, our structured programs are designed to build confidence, discipline, and real-world self-defense skills in a supportive environment.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-5 md:gap-6">
          <article class="bg-gb-white rounded-2xl overflow-hidden flex flex-col shadow-sm hover:shadow-md transition-shadow">
            <Image
              src={programCardKids}
              alt="Kids martial arts class at Gracie Barra Whittier, CA"
              widths={[480, 768]}
              sizes="(min-width: 768px) 50vw, 100vw"
              format="webp"
              quality={80}
              class="w-full h-44 md:h-52 object-cover"
            />
            <div class="p-6 md:p-8 flex-1 flex flex-col text-center">
              <h3 class="text-2xl font-extrabold text-gb-navy">Kids Martial Arts</h3>
              <p class="mt-3 text-sm text-gb-text-muted leading-relaxed flex-1">
                Our kids Brazilian Jiu-Jitsu classes in Whittier focus on discipline, confidence, and respect in a fun and structured environment.
              </p>
              <a href="/kids-martial-arts" class="mt-6 inline-flex items-center justify-center w-full h-11 rounded-full border-2 border-gb-red text-gb-red font-semibold hover:bg-gb-red hover:text-white transition-colors">
                Learn More
              </a>
            </div>
          </article>

          <article class="bg-gb-white rounded-2xl overflow-hidden flex flex-col shadow-sm hover:shadow-md transition-shadow">
            <Image
              src={programCardAdults}
              alt="Adult Brazilian Jiu-Jitsu class at Gracie Barra Whittier, CA"
              widths={[480, 768]}
              sizes="(min-width: 768px) 50vw, 100vw"
              format="webp"
              quality={80}
              class="w-full h-44 md:h-52 object-cover"
            />
            <div class="p-6 md:p-8 flex-1 flex flex-col text-center">
              <h3 class="text-2xl font-extrabold text-gb-navy">Adults Jiu-Jitsu</h3>
              <p class="mt-3 text-sm text-gb-text-muted leading-relaxed flex-1">
                Our adult Jiu-Jitsu program in Whittier helps you improve fitness, relieve stress, and learn practical self-defense regardless of experience level.
              </p>
              <a href="/adults-jiu-jitsu" class="mt-6 inline-flex items-center justify-center w-full h-11 rounded-full border-2 border-gb-red text-gb-red font-semibold hover:bg-gb-red hover:text-white transition-colors">
                Learn More
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    {/* ============================================================
       REAL STORIES. REAL GROWTH.
       ============================================================ */}
    <section class="px-4 md:px-6 py-8 md:py-12">
      <div class="max-w-5xl mx-auto bg-gb-white rounded-2xl shadow-sm p-8 md:p-12">
        <div class="text-center">
          <h2 class="text-2xl md:text-4xl font-extrabold text-gb-navy">Real Stories. Real Growth.</h2>
          <p class="mt-4 text-sm md:text-base text-gb-text-muted max-w-2xl mx-auto leading-relaxed">
            Behind every review is a student building confidence, developing discipline, and learning practical self-defense in a positive, family-friendly environment. Here's what our members are saying about their journey.
          </p>
          <div class="mt-6 inline-block">
            <CTAButton variant="primary" label="Get My Free Class" href="#trial" />
          </div>
        </div>

        <div class="mt-10 pt-8 border-t border-gb-bg-light flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <p class="text-base font-semibold text-gb-navy">What our clients say about us</p>
          <div class="flex items-center gap-4">
            <div class="text-right">
              <p class="text-2xl font-extrabold text-gb-navy">0.00</p>
              <div class="flex gap-0.5 text-gb-gold" aria-label="0 out of 5 stars">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M9.05 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.364 1.118l1.287 3.957c.3.922-.755 1.688-1.54 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.366 2.446c-.785.57-1.84-.196-1.54-1.118l1.286-3.957a1 1 0 00-.363-1.118L2.073 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.951-.69l1.286-3.957z" />
                  </svg>
                ))}
              </div>
              <p class="text-xs text-gb-text-muted">0 reviews</p>
            </div>
            <a href="/reviews" class="inline-flex items-center justify-center h-10 px-5 rounded-md bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 transition-colors">
              Write a review
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================
       WHY GRACIE BARRA WHITTIER — split layout
       ============================================================ */}
    <section class="px-4 md:px-6 py-12 md:py-16">
      <div class="max-w-6xl mx-auto bg-gb-white rounded-2xl overflow-hidden shadow-sm grid md:grid-cols-2">
        <div class="relative min-h-[320px] md:min-h-full">
          <img
            src="/images/home/gallery/team-1.jpg"
            alt="Gracie Barra Whittier team and academy community"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="p-6 md:p-10">
          <h2 class="text-2xl md:text-3xl font-extrabold text-gb-navy">Why Gracie Barra Whittier?</h2>
          <div class="mt-4 space-y-4 text-sm md:text-base text-gb-text-muted leading-relaxed">
            <p>Gracie Barra Whittier is more than a martial arts academy — it's a structured path to confidence, discipline, and real-world self-defense.</p>
            <p>Our certified instructors follow the proven Gracie Barra curriculum, guiding students of all ages through a system designed to produce measurable progress on and off the mats.</p>
            <p>Whether you're enrolling your child or starting your own journey, you'll find a safe, welcoming environment built around growth, accountability, and community.</p>
            <p>Explore our class schedule and see why families across Whittier trust us.</p>
          </div>

          <ul class="mt-6 space-y-2.5">
            {whyBullets.map((b) => (
              <li class="flex items-start gap-2.5 text-sm md:text-base text-gb-text">
                <svg class="w-5 h-5 mt-0.5 shrink-0 text-gb-red" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" transform="translate(2,2)" />
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>

          <p class="mt-6 text-sm md:text-base font-semibold text-gb-red leading-relaxed">
            Proudly serving the Whittier community with world-class Brazilian Jiu-Jitsu instruction in a clean, safe, and welcoming academy.
          </p>

          <div class="mt-6">
            <CTAButton variant="primary" label="Get My Free Class" href="#trial" fullWidth={true} />
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================
       A GLOBAL STANDARD. A LOCAL COMMUNITY.
       ============================================================ */}
    <section class="px-4 md:px-6 py-12 md:py-16">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-10">
          <img
            src="/logo/gb-whittier-logo.webp"
            alt=""
            aria-hidden="true"
            class="w-14 h-14 md:w-16 md:h-16 mx-auto"
            width="64"
            height="64"
          />
          <h2 class="mt-4 text-2xl md:text-4xl font-extrabold text-gb-red">A Global Standard. A Local Community.</h2>
          <p class="mt-3 text-sm md:text-base text-gb-text-muted max-w-2xl mx-auto leading-relaxed">
            Gracie Barra is one of the most respected Brazilian Jiu-Jitsu organizations in the world — and you can experience that same world-class training right here in Whittier.
          </p>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
          {stats.map((s) => (
            <div class="bg-gb-white rounded-2xl p-5 md:p-6 text-center shadow-sm flex flex-col items-center">
              <div class="w-12 h-12 rounded-full bg-gb-red/10 text-gb-red flex items-center justify-center mb-4">
                {s.icon === 'globe' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M2 12h20" />
                    <path d="M12 2a15 15 0 010 20a15 15 0 010-20z" />
                  </svg>
                )}
                {s.icon === 'people' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M9 11a4 4 0 100-8 4 4 0 000 8zm0 2c-3.3 0-6 1.8-6 4v2h12v-2c0-2.2-2.7-4-6-4zm9-2a3 3 0 100-6 3 3 0 000 6zm0 2c-1 0-1.9.2-2.7.6 1.7 1 2.7 2.5 2.7 4.4v2h6v-2c0-2.5-2.7-5-6-5z" />
                  </svg>
                )}
                {s.icon === 'star' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l2.95 6.94L22 10l-5.5 4.78L18.18 22 12 18.27 5.82 22 7.5 14.78 2 10l7.05-1.06L12 2z" />
                  </svg>
                )}
                {s.icon === 'shield' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2L4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5l-8-3zm-1 14l-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6z" />
                  </svg>
                )}
              </div>
              <p class="text-2xl md:text-3xl font-extrabold text-gb-navy leading-none">{s.value}</p>
              <p class="mt-1 text-sm font-bold text-gb-navy">{s.label}</p>
              <p class="mt-3 text-xs text-gb-text-muted leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ============================================================
       SEE LIFE INSIDE GRACIE BARRA WHITTIER
       ============================================================ */}
    <section class="px-4 md:px-6 py-12 md:py-16">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-4xl font-extrabold text-gb-navy">See Life Inside Gracie Barra Whittier</h2>
          <p class="mt-3 text-sm md:text-base text-gb-text-muted max-w-2xl mx-auto leading-relaxed">
            Real classes, real students, real Brazilian Jiu-Jitsu — straight from our Whittier academy.
          </p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
          {galleryImages.map((g) => (
            <div class="aspect-[4/3] overflow-hidden rounded-xl bg-gb-bg-light">
              <img
                src={g.src}
                alt={g.alt}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              />
            </div>
          ))}
        </div>
        <div class="mt-8 text-center">
          <CTAButton variant="primary" label="Get My Free Class" href="#trial" />
        </div>
      </div>
    </section>
  </div>

  {/* ============================================================
     FAQ — full-width navy band
     ============================================================ */}
  <section class="bg-gb-navy text-gb-white py-14 md:py-20 px-4 md:px-6" aria-labelledby="faq-heading">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-8 md:mb-10">
        <h2 id="faq-heading" class="text-2xl md:text-4xl font-extrabold">Questions About Jiu-Jitsu? We've Got Answers.</h2>
        <p class="mt-3 text-sm md:text-base text-gb-white/80 max-w-xl mx-auto leading-relaxed">
          Here are the most common questions about starting your journey at Gracie Barra Whittier.
        </p>
      </div>

      <div class="space-y-2">
        {homepageFaqs.map((item) => (
          <details class="group border-b border-gb-white/15 py-4">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none text-sm md:text-base font-semibold text-gb-white">
              <span class="flex items-center gap-3">
                <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
                <span>{item.question}</span>
              </span>
            </summary>
            <p class="mt-3 ml-7 text-sm text-gb-white/80 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <SchemaFAQ items={homepageFaqs} />
  <SchemaLocalBusiness />
</BaseLayout>
