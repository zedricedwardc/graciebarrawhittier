---
/**
 * /go/start-meta — Meta (Facebook/Instagram) ads landing page.
 * Homepage body in adMode (no off-page links), lead source "ads-general-meta".
 * noindex + canonical → homepage via AdLandingLayout.
 */
export const prerender = true;
import AdLandingLayout from '../../layouts/AdLandingLayout.astro';
import HomeLanding from '../../components/landing/HomeLanding.astro';
---

<AdLandingLayout
