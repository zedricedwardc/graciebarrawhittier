---
/**
 * BaseLayout — default layout for public pages.
 * Includes: SeoHead, GTM, Nav, StickyMobileCTA, slot, Footer, AIChatWidget, Inter font.
 */
import '../styles/globals.css';
import SeoHead from '../components/seo/SeoHead.astro';
import GTM from '../components/analytics/GTM.astro';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/footer/Footer.astro';
import AIChatWidget from '../components/widgets/AIChatWidget.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  /** Optional inline JSON-LD schema (string or object). */
  schema?: object | string;
  /** Hide the StickyMobileCTA on pages where it doesn't apply (e.g. legal pages). */
  hideStickyCTA?: boolean;
}

const { title, description, canonical, ogImage, schema, hideStickyCTA = false } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/logo/favicon.webp" />
    <link rel="apple-touch-icon" href="/logo/favicon.webp" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />

    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
    />

    <GTM />

    {
      schema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={typeof schema === 'string' ? schema : JSON.stringify(schema)}
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col bg-gb-bg-light text-gb-text">
    <GTM body />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-gb-white focus:text-gb-navy focus:px-3 focus:py-2 focus:rounded"
    >
      Skip to main content
    </a>

    <Nav hideStickyCTA={hideStickyCTA} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <AIChatWidget />
  </body>
</html>
