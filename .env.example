# Gracie Barra Whittier - public env vars (PUBLIC_ prefix exposes to client bundle)

# Opt-in form POST target (server-side or absolute URL); leave blank to use stub
PUBLIC_GHL_WEBHOOK_URL=

# Google Tag Manager container ID (e.g. GTM-XXXXX)
PUBLIC_GTM_ID=

# GA4 measurement ID (e.g. G-XXXXX) - usually configured inside GTM, included for completeness
PUBLIC_GA4_ID=

# GHL Conversations chat widget key
PUBLIC_GHL_CHAT_KEY=

# LocalCraze / GHL reviews widget ID
PUBLIC_REVIEWS_EMBED_ID=

# Server-only opt-in webhook (used by /api/leads-stub fallback if implemented)
GHL_WEBHOOK_URL=

# Server-only appointment-booking webhook (fired from /api/book on successful booking)
GHL_APPOINTMENT_WEBHOOK_URL=

# ─── Custom booking calendar (server-only, NEVER prefix PUBLIC_) ──────────
# GoHighLevel API v2 Private Integration Token. Generate at:
#   GHL → Settings → Private Integrations → Create New Integration
# Required scopes: calendars.readonly, calendars/events.write,
#                  contacts.readonly, contacts.write
GHL_PIT_TOKEN=

# GHL sub-account / location ID (visible in app URL: /v2/location/<ID>/...)
GHL_LOCATION_ID=

# Calendar IDs — one per program. Find each in GHL → Calendars → calendar settings.
GHL_CAL_TINY=
GHL_CAL_LC1=
GHL_CAL_LC2=
GHL_CAL_JUNIORS=
GHL_CAL_ADULTS=
