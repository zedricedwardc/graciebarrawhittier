# Gracie Barra Whittier — environment variable template.
#
# Copy to `.env` for local dev, populate via `npm run onboard:ghl` for new clients.
# Authoritative manifest: config/ghl-schema.ts → ENV_VARS.
#
# NEVER commit `.env` (covered by .gitignore line 17).

# ─── Public (exposed to client bundle via PUBLIC_ prefix) ──────────────────

PUBLIC_GHL_WEBHOOK_URL=
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
# GHL Chat Widget (browser-exposed — these IDs are not secrets; they appear in the rendered HTML)
# PUBLIC_GHL_LOCATION_ID must equal the server-side GHL_LOCATION_ID — they're separate vars
# because Astro only exposes PUBLIC_-prefixed vars to the client.
PUBLIC_GHL_CHAT_WIDGET_ID=
PUBLIC_GHL_LOCATION_ID=
PUBLIC_REVIEWS_EMBED_ID=

# NOTE: Back to the Mats campaign deadline is now read from the GHL custom
# value `back_to_the_mats_deadline` at request time (see src/lib/ghl-custom-values.ts).
# Studio admin updates it via Settings → Custom Values in GHL — no env var,
# no redeploy. Expected format: ISO 8601 with offset, e.g. 2026-06-08T23:59:00-07:00.

# ─── GHL credentials (server-only) ─────────────────────────────────────────

# Private Integration Token. Generate at:
#   GHL → Settings → Private Integrations → Create New Integration
# Required scopes:
#   contacts.readonly, contacts.write
#   opportunities.readonly, opportunities.write
#   calendars.readonly, calendars/events.readonly, calendars/events.write
#   locations.readonly
#   workflows.readonly
#   conversations/message.write   # only if sending SMS programmatically
GHL_PIT_TOKEN=
GHL_LOCATION_ID=

# ─── Webhook secrets ──────────────────────────────────────────────────────

# Shared secret for X-GBW-Secret header on inbound webhooks (GHL → website).
# Generate: openssl rand -hex 32
GHL_WEBHOOK_SECRET=

# HMAC key for /api/cancel signed tokens. Generate: openssl rand -hex 32
CANCEL_SIGNING_KEY=

# HMAC key for /rebook page magic-link tokens. Generate: openssl rand -hex 32
REBOOK_SIGNING_KEY=

# Gates /api/health/ghl from public access. Generate: openssl rand -hex 16
HEALTH_KEY=

# HMAC key for /admin/blog access + /api/admin/blog/* write tokens. MUST be
# >= 32 chars. Generate: openssl rand -hex 32. The signed token is embedded in
# the GHL "Website Blog" custom-menu link (minted by `npm run onboard:blog`);
# rotating this key invalidates that link — re-run the menu step after rotating.
ADMIN_SIGNING_KEY=

# ─── Blog (GHL Blogs storage — discovered by onboard:blog) ────────────────

# IDs of the GHL Blog "site", default author, and default category used by the
# custom blog editor (/admin/blog) and the public blog pages. Resolved from the
# live sub-account by `npm run onboard:blog discover` (picks the first blog site,
# author, and category). Create at least one blog site + author + category in
# GHL → Sites → Blogs first, or the discover step warns and resolves nothing.
GHL_BLOG_ID=
GHL_BLOG_AUTHOR_ID=
GHL_BLOG_DEFAULT_CATEGORY_ID=

# Vercel Blob — stores post BODY HTML (GHL's API accepts rawHTML on create but
# never returns it on reads, so the body must live where we can read it back).
# Auto-injected on Vercel once a Blob store is connected to the project
# (Dashboard → Storage → Blob, or `vercel blob create-store <name> --access public`).
# Locally: `vercel env pull` after connecting. Without it, publishing still works
# but post pages fall back to the short description.
BLOB_READ_WRITE_TOKEN=

# ─── GHL Pipeline IDs (discovered by onboard:ghl) ─────────────────────────

PIPELINE_ID_LEAD_ACQ=
PIPELINE_ID_TRIAL_CONV=
PIPELINE_ID_CREDIT_MON=
PIPELINE_ID_BACK_TO_MATS=
PIPELINE_ID_REVIVAL=

# ─── GHL Workflow IDs (discovered by onboard:ghl) ─────────────────────────

# Lead Acquisition campaigns
WORKFLOW_ID_TRIAL_NURTURE=
WORKFLOW_ID_NURTURE_CAMPAIGN=
WORKFLOW_ID_QUARTERLY_REACTIVATION=

# Trial Conversion campaigns
WORKFLOW_ID_PRE_TRIAL_REMINDERS=
WORKFLOW_ID_REBOOKING_CAMPAIGN=
WORKFLOW_ID_INACTIVE_REACTIVATION=
WORKFLOW_ID_90_DAY_REVIEW=

# Trial Credit Monitoring campaigns
WORKFLOW_ID_ANOTHER_TRIAL_CAMPAIGN=
WORKFLOW_ID_NO_SHOW_MESSAGE=
WORKFLOW_ID_CREDITS_EXHAUSTED=
WORKFLOW_ID_CREDIT_REACTIVATION=

# Backflow webhooks (GHL → website)
WORKFLOW_ID_TRIAL_CONV_STAGE_WEBHOOK=
WORKFLOW_ID_CREDIT_STAGE_WEBHOOK=
WORKFLOW_ID_APPT_STATUS_WEBHOOK=

# Back to the Mats campaigns (one-shot CSV import → 30-day workflow → confirmation → optional re-booking)
WORKFLOW_ID_BTM_30DAY=
WORKFLOW_ID_BTM_CONFIRMATION=
WORKFLOW_ID_BTM_REBOOKING=

# SMS AI booking bot → pipeline orchestration (bot calls this workflow after every appointment booking; it POSTs to /api/webhooks/ghl/agent-booking-completed)
WORKFLOW_ID_BOT_BOOKING_ORCHESTRATOR=

# Revival Protocol — 30-Day Drip re-engagement for manually-added cold leads.
# Admin drops a contact into this workflow on entry (DEAD LEAD). Website removes
# the contact on successful booking via exitNurtureWorkflows(contactId, 'revival').
WORKFLOW_ID_REVIVAL_30DAY_DRIP=

# ─── GHL Calendar IDs (one per program) ───────────────────────────────────

GHL_CAL_TINY=
GHL_CAL_LC1=
GHL_CAL_LC2=
GHL_CAL_JUNIORS=
GHL_CAL_ADULTS=

# Back to the Mats calendar IDs (separate calendars from the trial flow above —
# admin can see BTM bookings independently in GHL).
GHL_CAL_BTM_TINY=
GHL_CAL_BTM_LC1=
GHL_CAL_BTM_LC2=
GHL_CAL_BTM_JUNIORS=
GHL_CAL_BTM_ADULTS=

# ─── Idempotency storage (optional) ───────────────────────────────────────

# memory (default; survives a warm Fluid Compute instance only)
# upstash (durable across cold starts; requires Upstash Redis from Vercel Marketplace)
IDEMPOTENCY_BACKEND=memory

# Only required when IDEMPOTENCY_BACKEND=upstash
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Legacy / deprecated (kept during migration) ──────────────────────────

# Deprecated: was used to fire the appointment webhook directly.
# Replaced in Phase 3 by ghl-adapter.handleBooking() calling GHL API directly.
GHL_APPOINTMENT_WEBHOOK_URL=
GHL_WEBHOOK_URL=
